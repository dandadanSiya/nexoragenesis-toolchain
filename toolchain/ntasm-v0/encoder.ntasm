cmp rax, 0
jne ef_error
store64 [rsp + 24], rsi
load64 r15, [rdi + 8]
cmp rsi, 2
jne bi_prefix
mov r15, 0xBA
bi_prefix:
mov r10, 0
cmp rbx, 16
jne bi_rex
mov rax, 0x66
store8 [rsp], rax
add r10, 1
bi_rex:
mov r11, 0x40
cmp rbx, 64
jne bi_rex_b
or r11, 8
bi_rex_b:
cmp r8, 8
jb bi_rex_r
or r11, 1
bi_rex_r:
cmp rsi, 2
je bi_emit_rex
cmp r9, 8
jb bi_emit_rex
or r11, 4
bi_emit_rex:
cmp r11, 0x40
je bi_opcode
store8 [rsp + r10 * 1], r11
add r10, 1
bi_opcode:
mov rax, 0x0F
store8 [rsp + r10 * 1], rax
