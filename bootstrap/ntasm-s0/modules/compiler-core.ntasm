; Module du coeur compilateur, sans I/O de diagnostic ni driver integre.
format pe64
abi efi_x64
entry start
section .text rx
start:
push rbx
push r12
push r13
push r14
push r15
sub rsp, 48
mov rbx, rdx
mov r12, rcx
load64 r13, [rbx + 0x60]
