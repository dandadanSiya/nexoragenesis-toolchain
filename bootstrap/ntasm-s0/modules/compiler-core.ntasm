jne lib_bad
load64 rax, [r14 + 40]
cmp rax, 0
jne lib_bad
load64 r15, [r14 + 16]
cmp r15, 0
je lib_bad
load64 rdx, [r14 + 24]
cmp rdx, 0
je lib_bad
lea rcx, [rip + exports]
load64 r8, [r14 + 32]
mov r9, r12
call r15
cmp rax, 0
jne lib_bad
mov rax, 0
jmp lib_return
lib_bad:
mov rax, 0x8000000000000015
lib_return:
add rsp, 48
pop r15
pop r14
pop r13
pop r12
pop rbx
ret
; RCX=WORK/RDX=SRC/R8=taille; validation finale et resolutions.
