io_restore:
add rsp, 40
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbp
pop rbx
ret

; RCX=code/RAX=EFIStatus; garder la premiere erreur.
; Trace BYTES : io_test_fault=4.
; Erreur : comparer payload et compteurs publies.
io_snapshot_payload:
lea rdx, [rip + io_payload_snapshot]
lea r8, [r12 + 8]
mov rcx, 5
io_snapshot_fields:
load64 rax, [r8]
store64 [rdx], rax
add r8, 8
add rdx, 8
sub rcx, 1
jne io_snapshot_fields
lea r8, [r12 + 0x1C500]
mov rcx, 128
io_snapshot_bytes:
load64 rax, [r8]
store64 [rdx], rax
add r8, 8
add rdx, 8
sub rcx, 1
jne io_snapshot_bytes
load64 rax, [r12 + 0x60]
lea rdx, [rip + io_ref_snapshot]
store64 [rdx], rax
load64 rax, [r12 + 0x40]
store64 [rdx + 8], rax
ret
io_compare_payload:
lea rdx, [rip + io_payload_snapshot]
lea r8, [r12 + 8]
mov rcx, 5
io_compare_fields:
load64 rax, [r8]
load64 r9, [rdx]
cmp rax, r9
jne io_payload_changed
add r8, 8
add rdx, 8
sub rcx, 1
jne io_compare_fields
lea r8, [r12 + 0x1C500]
mov rcx, 128
io_compare_bytes:
load64 rax, [r8]
load64 r9, [rdx]
cmp rax, r9
jne io_payload_changed
add r8, 8
add rdx, 8
sub rcx, 1
jne io_compare_bytes
load64 rax, [r12 + 0x60]
lea rdx, [rip + io_ref_snapshot]
load64 r9, [rdx]
cmp rax, r9
jne io_payload_changed
load64 rax, [r12 + 0x40]
load64 r9, [rdx + 8]
cmp rax, r9
jne io_payload_changed
mov rax, 0
ret
io_payload_changed:
mov rax, 1
ret
io_trace_payload:
push rsi
push r13
push r14
push r15
sub rsp, 56
load64 rax, [r12 + 0x28]
cmp rax, 1
jne io_trace_done
load64 rsi, [r12 + 0x20]
cmp rsi, 1025
jae io_trace_bad
lea r13, [r12 + 0x1C500]
io_trace_chunk:
cmp rsi, 0
je io_trace_done
mov r14, rsi
cmp r14, 32
jb io_trace_count
mov r14, 32
io_trace_count:
mov r10, r14
lea r15, [rip + io_payload_line]
add r15, 14
lea r9, [rip + io_hex_chars]
io_trace_byte:
load8 rax, [r13]
add r13, 1
mov rcx, rax
shr rcx, 4
load8 r8, [r9 + rcx * 1]
store16 [r15], r8
and rax, 15
load8 r8, [r9 + rax * 1]
store16 [r15 + 2], r8
add r15, 4
sub r10, 1
jne io_trace_byte
mov rax, 13
store16 [r15], rax
mov rax, 10
store16 [r15 + 2], rax
mov rax, 0
store16 [r15 + 4], rax
lea rdx, [rip + io_payload_line]
call io_print
sub rsi, r14
jmp io_trace_chunk
io_trace_bad:
mov rax, 1
jmp io_trace_return
io_trace_done:
mov rax, 0
io_trace_return:
add rsp, 56
pop r15
pop r14
pop r13
pop rsi
ret
io_first_error:
mov rdx, 0x8000000000000000
cmp rax, rdx
jb io_first_done
load64 rdx, [rbp + 72]
cmp rdx, 0
jne io_first_done
store64 [rbp + 72], rcx
store64 [rbp + 104], rax
io_first_done:
ret
io_print:
sub rsp, 40
load64 rcx, [rbx + 0x40]
cmp rcx, 0
je io_print_done
load64 rax, [rcx + 8]
cmp rax, 0
je io_print_done
call rax
io_print_done:
add rsp, 40
ret
io_hex:
imul r9, r8, 2
sub r9, 2
add rdx, r9
lea r9, [rip + io_hex_chars]
io_hex_next:
mov r10, rcx
and r10, 15
load8 rax, [r9 + r10 * 1]
store16 [rdx], rax
sub rdx, 2
shr rcx, 4
sub r8, 1
jne io_hex_next
ret
io_init_guards:
load64 rax, [r8]
store64 [rcx], rax
load64 rax, [r8 + 8]
store64 [rcx + 8], rax
add rcx, rdx
add rcx, 16
load64 rax, [r9]
store64 [rcx], rax
load64 rax, [r9 + 8]
store64 [rcx + 8], rax
ret
io_guard_region:
load64 rax, [r8]
load64 r10, [rcx]
cmp rax, r10
jne io_guard_bad
load64 rax, [r8 + 8]
load64 r10, [rcx + 8]
cmp rax, r10
jne io_guard_bad
add rcx, rdx
add rcx, 16
load64 rax, [r9]
load64 r10, [rcx]
cmp rax, r10
jne io_guard_bad
load64 rax, [r9 + 8]
load64 r10, [rcx + 8]
cmp rax, r10
jne io_guard_bad
mov rax, 0
ret
io_guard_bad:
mov rax, 1
ret
io_check_guards:
sub rsp, 40
load64 rax, [rbp + 184]
and rax, 1
je io_check_src
load64 rcx, [rbp]
mov rdx, 0x1D000
lea r8, [rip + io_work_pre]
lea r9, [rip + io_work_post]
call io_guard_region
cmp rax, 0
jne io_check_done
io_check_src:
load64 rax, [rbp + 184]
and rax, 2
je io_check_zero
load64 rcx, [rbp + 8]
mov rdx, 0x10000
lea r8, [rip + io_src_pre]
lea r9, [rip + io_src_post]
call io_guard_region
cmp rax, 0
jne io_check_done
jmp io_check_out
io_check_out:
load64 rax, [rbp + 184]
and rax, 16
je io_check_zero
load64 rcx, [rbp + 192]
mov rdx, 0x10000
lea r8, [rip + io_out_pre]
lea r9, [rip + io_out_post]
call io_guard_region
cmp rax, 0
jne io_check_done
load64 rax, [rbp + 184]
and rax, 32
je io_check_zero
load64 rcx, [rbp + 232]
mov rdx, 0x56D000
lea r8, [rip + io_work_pre]
lea r9, [rip + io_work_post]
call io_guard_region
jmp io_check_done
io_check_zero:
mov rax, 0
io_check_done:
add rsp, 40
ret
; RCX=WORK/RDX=SRC/R8=taille; resoudre addr.
; RAX=sym/R10=kind/R12=WORK -> RVA/code.
native_front_line:
lea rax, [rip + job_exports]
load64 rax, [rax]
load64 rax, [rax + 40]
sub rsp, 40
call rax
add rsp, 40
ret
nb_resolve:
lea rax, [rip + job_exports]
load64 rax, [rax]
load64 rax, [rax + 56]
sub rsp, 40
call rax
add rsp, 40
ret
nr_resolve:
lea rax, [rip + job_exports]
load64 rax, [rax]
load64 rax, [rax + 72]
sub rsp, 40
call rax
add rsp, 40
ret
native_finish_source:
lea rax, [rip + job_exports]
load64 rax, [rax]
load64 rax, [rax + 88]
sub rsp, 40
call rax
add rsp, 40
ret

; Conserver chaque fragment emis dans trois zones fixes de OUT.
; Snapshot des champs publies avant chaque ligne (scratch prive exclu).
recovery_begin:
push rsi
push rdi
sub rsp, 40
mov rsi, r12
lea rdi, [rip + recovery_header]
mov rcx, 192
call pass_copy_bytes
add rsp, 40
pop rdi
pop rsi
ret
; RAX=code, R8=ligne, R9=colonne, R11=offset; egalite garde le premier.
recovery_remember:
load64 rcx, [r12 + 0x110]
cmp rcx, 0
je recovery_store
load64 rcx, [r12 + 0x128]
cmp r11, rcx
jae recovery_kept
recovery_store:
store64 [r12 + 0x110], rax
store64 [r12 + 0x118], r8
store64 [r12 + 0x120], r9
store64 [r12 + 0x128], r11
recovery_kept:
ret
recovery_rollback:
push rsi
push rdi
sub rsp, 40
lea rsi, [rip + recovery_header]
mov rdi, r12
mov rcx, 192
call pass_copy_bytes
mov rax, 0
store64 [r12 + 0x20], rax
store64 [r12 + 0x28], rax
load64 rax, [r12 + 0x80]
cmp rax, 4
jne recovery_rollback_done
load64 rdx, [r12 + 24]
load64 rcx, [r12]
lea rdi, [r12 + 0x400]
recovery_mark:
cmp rcx, 0
je recovery_rollback_done
load16 rax, [rdi + 46]
mov r8, rax
and r8, 0x6F
cmp r8, 0x22
jne recovery_mark_next
load64 r8, [rdi + 32]
cmp r8, rdx
jne recovery_mark_next
or rax, 256
store16 [rdi + 46], rax
recovery_mark_next:
add rdi, 48
sub rcx, 1
jmp recovery_mark
recovery_rollback_done:
add rsp, 40
pop rdi
pop rsi
ret
; Publier seulement apres resolution des erreurs differees.
recovery_publish:
load64 rax, [r12 + 0x110]
cmp rax, 0
je io_pass_error
store64 [rbp + 72], rax
load64 rax, [r12 + 0x118]
store64 [rbp + 80], rax
load64 rax, [r12 + 0x120]
store64 [rbp + 88], rax
load64 rax, [r12 + 0x128]
store64 [rbp + 96], rax
mov rax, 0x8000000000000001
store64 [rbp + 104], rax
jmp io_cleanup
; Ces transferts prives ne preservent pas RSI/RDI.
pass_copy_bytes:
cmp rcx, 0
je pass_copy_done
load8 rax, [rsi]
store8 [rdi], rax
add rsi, 1
add rdi, 1
sub rcx, 1
jmp pass_copy_bytes
pass_copy_done:
mov rax, 0
ret
pass_compare_bytes:
mov r11, 0
pass_compare_next:
cmp rcx, 0
je pass_copy_done
load8 rax, [rsi]
load8 rdx, [rdi]
cmp rax, rdx
jne pass_bad
add rsi, 1
add rdi, 1
add r11, 1
sub rcx, 1
jmp pass_compare_next
pass_bad:
mov rax, 600
ret
; RAX=tag. Journal exact : header64, tokens256, scratch1024.
pass_line:
push rsi
push rdi
sub rsp, 40
lea rsi, [rip + pass_header]
store64 [rsi], rax
load64 rax, [r12 + 0x20]
store64 [rsi + 8], rax
load64 rax, [r12 + 0x28]
store64 [rsi + 16], rax
load64 rax, [r12 + 24]
store64 [rsi + 24], rax
load64 rax, [r12 + 8]
store64 [rsi + 32], rax
load64 rax, [r12 + 16]
store64 [rsi + 40], rax
load64 rax, [r12 + 0x30]
store64 [rsi + 48], rax
load64 rax, [r12]
store64 [rsi + 56], rax
load64 rax, [rbp + 120]
cmp rax, 1
jb pass_line_bad
cmp rax, 4097
jae pass_line_bad
sub rax, 1
imul rax, rax, 0x540
load64 rdi, [rbp + 240]
add rdi, 0x2D000
add rdi, rax
load64 r9, [rbp + 248]
cmp r9, 1
je pass_line_ready
cmp r9, 2
jne pass_line_bad
pass_line_ready:
mov r8, 64
call pass_words
cmp rax, 0
jne pass_line_return
lea rsi, [r12 + 0x1C400]
mov r8, 256
call pass_words
cmp rax, 0
jne pass_line_return
lea rsi, [r12 + 0x1C500]
mov r8, 1024
call pass_words
jmp pass_line_return
pass_line_bad:
mov rax, 600
mov r11, 0
pass_line_return:
add rsp, 40
pop rdi
pop rsi
ret
; R9=1 copie, R9=2 compare. Les longueurs sont multiples de huit.
pass_words:
mov r11, 0
pass_word_next:
load64 rax, [rsi]
cmp r9, 1
je pass_word_write
load64 r10, [rdi]
cmp rax, r10
jne pass_bad
jmp pass_word_advance
pass_word_write:
store64 [rdi], rax
pass_word_advance:
add rsi, 8
add rdi, 8
add r11, 8
sub r8, 8
jne pass_word_next
mov rax, 0
ret
writer_stage_line:
; RAX est le tag de la ligne : declarations/commentaires n'emettent rien.
cmp rax, 7
jb writer_stage_ok
cmp rax, 12
jae writer_stage_section_bad
load64 rax, [r12 + 0x20]
load64 rdx, [r12 + 0x80]
cmp rdx, 4
je writer_stage_text
cmp rdx, 5
je writer_stage_rdata
cmp rdx, 6
jne writer_stage_section_bad
lea r8, [rbp + 224]
load64 r9, [r12 + 16]
mov r11, 8192
mov rdx, 0xC400
jmp writer_stage_place
writer_stage_rdata:
lea r8, [rbp + 216]
load64 r9, [r12 + 8]
mov r11, 16384
mov rdx, 0x8400
jmp writer_stage_place
writer_stage_text:
lea r8, [rbp + 208]
load64 r9, [r12 + 24]
mov r11, 32768
mov rdx, 0x400
writer_stage_place:
load64 rcx, [r8]
cmp r11, rcx
jb writer_stage_size_bad
sub r11, rcx
cmp r11, rax
jb writer_stage_size_bad
mov r10, rcx
add r10, rax
cmp r10, r9
jne writer_stage_size_bad
cmp rax, 0
je writer_stage_ok
; +20 est la longueur DU FRAGMENT; les curseurs cumules sont +8/+16/+24.
load64 r9, [r12 + 0x28]
cmp r9, 1
jne writer_stage_check_fill
cmp rax, 1025
jae writer_stage_size_bad
jmp writer_stage_valid
writer_stage_check_fill:
cmp r9, 2
je writer_stage_valid
cmp r9, 3
jne writer_stage_section_bad
writer_stage_valid:
