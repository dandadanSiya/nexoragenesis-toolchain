module calls;

import ntasm_ast;

// Node kinds: import 9, function declaration 18, parameter 19,
// call statement 28, call expression 35 (aux 1), qualified name 91.

// Byte-wise name comparison over the real source text with bounds.
fn same_name(source:buf<u8>,a_start:u64,a_end:u64,b_start:u64,b_end:u64)->bool {
    if a_start>a_end || b_start>b_end || a_end>len(source) || b_end>len(source) {
        return false;
    }
    if (a_end-a_start)!=(b_end-b_start) { return false; }
    let mut i:u64=0;
    while i<(a_end-a_start) {
        if source[a_start+i]!=source[b_start+i] { return false; }
        i=i+1;
    }
    return true;
}

// Direct child of parent at the given ordinal, or 0 when absent or out of range.
fn child(tree:ntasm_ast.Tree,parent:u64,ordinal:u64)->u64 {
    let p:ntasm_ast.Node=ntasm_ast.node_at(tree,parent);
    let mut id:u64=p.first_child;
    let mut index:u64=0;
    while id!=0 && index<ordinal {
        if id>tree.node_count { return 0; }
        let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        id=n.next_sibling;
        index=index+1;
    }
    if id>tree.node_count { return 0; }
    return id;
}

// Number of call-supplied parameters. Direct out parameters do not consume an
// argument; in and inout do. Parameters are attached to the declaration.
fn is_out(source:buf<u8>,parameter:ntasm_ast.Node)->bool {
    if parameter.start+3>len(source) { return false; }
    return source[parameter.start]==111 && source[parameter.start+1]==117
           && source[parameter.start+2]==116;
}

fn decl_arity(source:buf<u8>,tree:ntasm_ast.Tree,decl_id:u64)->u64 {
    let d:ntasm_ast.Node=ntasm_ast.node_at(tree,decl_id);
    let mut id:u64=d.first_child;
    let mut count:u64=0;
    while id!=0 && id<=tree.node_count {
        let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if n.kind==19 && is_out(source,n)==false { count=count+1; }
        id=n.next_sibling;
    }
    return count;
}

// Name node id of a callable declaration: first child for a function
// declaration, second child (the alias, after the qualified path) for an
// import. Returns 0 when the tree does not carry a usable name.
fn decl_name_id(tree:ntasm_ast.Tree,decl_id:u64)->u64 {
    let n:ntasm_ast.Node=ntasm_ast.node_at(tree,decl_id);
    if n.kind==18 { return child(tree,decl_id,0); }
    if n.kind==9 { return child(tree,decl_id,1); }
    return 0;
}

// Call name: first child of the call must be a qualified node; the name is
// its last child. The received arity is the number of direct children after
// that qualified node. Returns 0 when the shape is not a usable call.
fn call_name_id(tree:ntasm_ast.Tree,call_id:u64)->u64 {
    let qid:u64=child(tree,call_id,0);
    if qid==0 { return 0; }
    let q:ntasm_ast.Node=ntasm_ast.node_at(tree,qid);
    if q.kind!=91 { return 0; }
    if q.last_child==0 || q.last_child>tree.node_count { return 0; }
    return q.last_child;
}

fn call_arity(tree:ntasm_ast.Tree,call_id:u64)->u64 {
    let c:ntasm_ast.Node=ntasm_ast.node_at(tree,call_id);
    let mut id:u64=c.first_child;
    let mut first:bool=true;
    let mut count:u64=0;
    while id!=0 && id<=tree.node_count {
        if first==false { count=count+1; }
        first=false;
        let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        id=n.next_sibling;
    }
    return count;
}

fn is_call(n:ntasm_ast.Node)->bool {
    if n.kind==28 { return true; }
    if n.kind==35 && n.aux==1 { return true; }
    return false;
}

// Validate call arities against local function declarations and import
// aliases. Success writes declaration count, call count, validated call
// count and 0 to out[0..3]. Error 310 writes the line and column of the
// first call whose name is absent to out[0..1]. Error 311 writes line,
// column, expected arity and received arity to out[0..3]. Error 800 on an
// invalid tree, an invalid span or an output buffer shorter than four
// words, with no write to out. Neither source nor tree is released.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64 {
    if tree.ok==false || tree.node_count==0 || len(out)<4 { return 800; }

    let scratch:buf<u64>=alloc(runtime(),tree.node_count*2);
    let mut used:u64=0;
    let mut calls:u64=0;
    let mut validated:u64=0;
    let mut code:u64=0;
    let mut err_line:u64=0;
    let mut err_column:u64=0;
    let mut err_expected:u64=0;
    let mut err_received:u64=0;

    // Index declarations: id and arity per callable.
    let mut id:u64=1;
    while id<=tree.node_count {
        let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if n.kind==18 || n.kind==9 {
            let name_id:u64=decl_name_id(tree,id);
            if name_id==0 { code=800; }
            else {
                let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);
                if name.start>name.end || name.end>len(source) { code=800; }
                else {
                    let at:u64=used*2;
                    scratch[at]=id;
                    scratch[at+1]=decl_arity(source,tree,id);
                    used=used+1;
                }
            }
        }
        if code!=0 { id=tree.node_count+1; } else { id=id+1; }
    }

    // Check every call against the indexed arities.
    id=1;
    while id<=tree.node_count && code==0 {
        let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if is_call(n) {
            let name_id:u64=call_name_id(tree,id);
            if name_id==0 {
                code=310;
                err_line=n.line;
                err_column=n.column;
            } else {
                calls=calls+1;
                let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);
                if name.start>name.end || name.end>len(source) {
                    code=800;
                } else {
                    let arity:u64=call_arity(tree,id);
                    let mut found:bool=false;
                    let mut j:u64=0;
                    while j<used {
                        let at:u64=j*2;
                        let decl:ntasm_ast.Node=ntasm_ast.node_at(tree,scratch[at]);
                        let decl_name_id:u64=decl_name_id(tree,scratch[at]);
                        if decl_name_id!=0 {
                            let decl_name:ntasm_ast.Node=ntasm_ast.node_at(tree,decl_name_id);
                            if same_name(source,decl_name.start,decl_name.end,
                                         name.start,name.end) {
                                found=true;
                                if arity!=scratch[at+1] {
                                    code=311;
                                    err_line=name.line;
                                    err_column=name.column;
                                    err_expected=scratch[at+1];
                                    err_received=arity;
                                }
                                j=used;
                            }
                        }
                        if code==0 || found==false { j=j+1; }
                    }
                    if found==true {
                        validated=validated+1;
                    } else if code==0 {
                        code=310;
                        err_line=name.line;
                        err_column=name.column;
                    }
                }
            }
        }
        id=id+1;
    }

    if code==0 {
        out[0]=used;
        out[1]=calls;
        out[2]=validated;
        out[3]=0;
    } else if code==310 {
        out[0]=err_line;
        out[1]=err_column;
    } else if code==311 {
        out[0]=err_line;
        out[1]=err_column;
        out[2]=err_expected;
        out[3]=err_received;
    }
    rt_free(runtime(),scratch);
    return code;
}
