; Frontend natif : composition du lexer, des entiers et du registre de symboles.
; Driver de constantes, pas encore un assembleur auto-heberge.
format pe64
abi efi_x64
entry start
section .text rx
start:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 48
mov rbx, rdx
load64 rsi, [rbx + 0x60]
mov rax, 0
store64 [rsp + 32], rax
mov rcx, 2
mov rdx, 0x1D020
lea r8, [rsp + 32]
load64 rax, [rsi + 0x40]
call rax
cmp rax, 0
jne no_pool
load64 r14, [rsp + 32]
cmp r14, 0
je no_pool
mov rdi, r14
add rdi, 16
mov rdx, 0x1D000
mov rax, 0
zero_work:
store64 [rdi], rax
add rdi, 8
sub rdx, 8
cmp rdx, 0
jne zero_work
mov rax, 31
store64 [r14], rax
store64 [r14 + 8], rax
mov rax, 37
store64 [r14 + 0x1D010], rax
store64 [r14 + 0x1D018], rax
lea r12, [rip + cases]
mov r13, 24
test_next:
mov rcx, r14
add rcx, 16
load64 rdx, [r12]
load64 r8, [r12 + 8]
lea r9, [r12 + 16]
mov rdi, 19
mov r15, 29
call driver_add_const
lea r8, [rip + phase]
mov r9, 1
store64 [r8], r9
cmp rdi, 19
jne failed
cmp r15, 29
jne failed
load64 r9, [rsp + 32]
cmp r14, r9
jne failed
lea r8, [rip + phase]
mov r9, 2
store64 [r8], r9
load64 r9, [r12 + 32]
cmp r10, r9
jne failed
lea r8, [rip + phase]
mov r9, 3
store64 [r8], r9
load64 r9, [r12 + 40]
cmp r11, r9
jne failed
lea r8, [rip + phase]
mov r9, 4
store64 [r8], r9
load64 r9, [r12 + 48]
load64 r8, [r14 + 16]
cmp r9, r8
jne failed
cmp r10, 0
jne expect_failure
lea r8, [rip + phase]
mov r9, 5
store64 [r8], r9
load64 r9, [r12 + 48]
mov r8, r9
sub r8, 1
imul r8, r8, 48
add r8, r14
add r8, 0x410
cmp rax, r8
jne failed
load64 rdx, [r12 + 56]
lea r8, [rip + phase]
mov r9, 6
store64 [r8], r9
mov rcx, 0
check_record:
load8 r9, [rax + rcx * 1]
load8 r10, [rdx + rcx * 1]
cmp r9, r10
jne failed
add rcx, 1
cmp rcx, 48
jne check_record
jmp test_advance
expect_failure:
cmp rax, 0
jne failed
test_advance:
add r12, 64
sub r13, 1
cmp r13, 0
jne test_next
; Comparer la table finale et sa partie non publiee, apres tous les refus.
lea r8, [rip + phase]
mov r9, 7
store64 [r8], r9
lea rdx, [rip + final_records]
mov rcx, 0
final_table:
; Utiliser un pointeur de base, l'adressage S0 n'a pas deux deplacements.
mov r8, r14
add r8, 0x410
load8 r9, [r8 + rcx * 1]
cmp rcx, 336
jae unused_table
load8 r10, [rdx + rcx * 1]
jmp table_compare
unused_table:
mov r10, 0
table_compare:
cmp r9, r10
jne failed
add rcx, 1
cmp rcx, 0x6000
jne final_table
; Deuxieme phase : 512 declarations passent par le frontend entier.
lea r8, [rip + phase]
mov r9, 8
store64 [r8], r9
mov r8, r14
add r8, 16
mov rcx, 0x6400
mov rax, 0
clear_symbols:
store64 [r8], rax
add r8, 8
sub rcx, 8
cmp rcx, 0
jne clear_symbols
mov r13, 0
bulk_next:
mov rcx, r13
call bulk_prepare
mov rcx, r14
add rcx, 16
call driver_add_const
cmp r10, 0
jne failed
cmp r11, 0
jne failed
imul r8, r13, 48
add r8, r14
add r8, 0x410
cmp rax, r8
jne failed
lea rdx, [rip + bulk_expected]
mov rcx, 0
bulk_compare:
load8 r9, [rax + rcx * 1]
load8 r10, [rdx + rcx * 1]
cmp r9, r10
jne failed
add rcx, 1
cmp rcx, 48
jne bulk_compare
load64 r9, [r14 + 16]
mov rax, r13
add rax, 1
cmp r9, rax
jne failed
add r13, 1
cmp r13, 512
jne bulk_next
lea r8, [rip + phase]
mov r9, 9
store64 [r8], r9
mov rcx, r13
call bulk_prepare
mov rcx, r14
add rcx, 16
call driver_add_const
cmp r10, 500
jne failed
cmp r11, 6
jne failed
cmp rax, 0
jne failed
lea r8, [rip + phase]
mov r9, 10
store64 [r8], r9
mov r13, 0
mov rcx, 0
call bulk_prepare
mov rax, 0x6666
store16 [rdx + 13], rax
store8 [rdx + 15], rax
mov rcx, r14
add rcx, 16
call driver_add_const
cmp r10, 300
jne failed
cmp r11, 6
jne failed
cmp rax, 0
jne failed
load64 r9, [r14 + 16]
cmp r9, 512
jne failed
load64 r9, [r14 + 0x430]
cmp r9, 0
jne failed
mov r8, r14
add r8, 0x6410
mov rcx, 64
check_after_symbols:
load8 r9, [r8]
cmp r9, 0
jne failed
add r8, 1
sub rcx, 1
cmp rcx, 0
jne check_after_symbols
; Provenance invalide avant insertion, puis borne valide a la derniere ligne.
lea r8, [rip + phase]
mov r9, 11
store64 [r8], r9
lea r12, [rip + prov_cases]
mov r13, 5
provenance_next:
mov rcx, 0
call bulk_prepare
load64 rax, [r12]
store64 [r9], rax
load64 rax, [r12 + 8]
store64 [r9 + 8], rax
mov rcx, r14
add rcx, 16
call driver_add_const
load64 r8, [r12 + 16]
cmp r10, r8
jne failed
load64 r8, [r12 + 24]
cmp r11, r8
jne failed
cmp rax, 0
jne failed
add r12, 32
sub r13, 1
cmp r13, 0
jne provenance_next
load64 r9, [r14 + 16]
cmp r9, 512
jne failed
load32 r9, [r14 + 0x438]
cmp r9, 6
jne failed
load16 r9, [r14 + 0x43C]
cmp r9, 1
jne failed
; Phase des en-tetes : etat, descripteur entry et table persistent entre les lignes.
lea r8, [rip + phase]
mov r9, 12
store64 [r8], r9
mov r8, r14
add r8, 16
mov rcx, 0x6400
mov rax, 0
stage_clear:
store64 [r8], rax
add r8, 8
sub rcx, 8
cmp rcx, 0
jne stage_clear
mov rax, 12
store64 [r14 + 0x28], rax
mov rax, 32
store64 [r14 + 0x18], rax
mov rax, 48
store64 [r14 + 0x20], rax
lea r12, [rip + stage_cases]
mov r13, 42
stage_next:
mov r8, r14
add r8, 0x90
lea rdx, [rip + stage_before]
mov rcx, 56
stage_snapshot:
load8 rax, [r8]
store8 [rdx], rax
add r8, 1
add rdx, 1
sub rcx, 1
cmp rcx, 0
jne stage_snapshot
mov rcx, r14
add rcx, 16
load64 rdx, [r12]
load64 r8, [r12 + 8]
lea r9, [r12 + 16]
call driver_front_line
load64 r8, [r12 + 32]
cmp r10, r8
jne failed
load64 r8, [r12 + 40]
cmp r11, r8
jne failed
load64 r8, [r12 + 64]
cmp rax, r8
jne failed
load64 r8, [r14 + 0x90]
load64 r9, [r12 + 48]
cmp r8, r9
jne failed
load64 r8, [r14 + 16]
load64 r9, [r12 + 56]
cmp r8, r9
jne failed
cmp r10, 0
je stage_success
mov r8, r14
add r8, 0x90
lea rdx, [rip + stage_before]
mov rcx, 56
stage_unchanged:
load8 r9, [r8]
load8 r10, [rdx]
cmp r9, r10
jne failed
add r8, 1
add rdx, 1
sub rcx, 1
cmp rcx, 0
jne stage_unchanged
jmp stage_advance
stage_success:
load64 rdx, [r12 + 72]
cmp rdx, 0
je stage_entry
load64 r8, [r14 + 16]
sub r8, 1
imul r8, r8, 48
add r8, r14
add r8, 0x410
mov rcx, 48
stage_record:
load8 r9, [r8]
load8 r10, [rdx]
cmp r9, r10
jne failed
add r8, 1
add rdx, 1
sub rcx, 1
cmp rcx, 0
jne stage_record
stage_entry:
load64 r8, [r12 + 80]
cmp r8, -1
je stage_advance
load64 rax, [r12]
add rax, r8
load64 r9, [r14 + 0xA0]
cmp r9, rax
jne failed
load64 rax, [r12 + 88]
load64 r9, [r14 + 0xA8]
cmp r9, rax
jne failed
load64 rax, [r12 + 16]
add rax, r8
load64 r9, [r14 + 0xB0]
cmp r9, rax
jne failed
load64 rax, [r12 + 24]
load64 r9, [r14 + 0xB8]
cmp r9, rax
jne failed
load64 rax, [r12 + 16]
load64 r9, [r14 + 0xC0]
cmp r9, rax
jne failed
load64 r9, [r14 + 0x98]
cmp r9, 1
jne failed
stage_advance:
add r12, 96
sub r13, 1
cmp r13, 0
jne stage_next
; Recontrole final : aucune ligne ulterieure ne doit alterer les records ou entry.
mov r8, r14
add r8, 0x410
lea rdx, [rip + stage_expected9]
mov rcx, 0
stage_final_table:
load8 r9, [r8 + rcx * 1]
cmp rcx, 288
jae stage_final_zero
load8 r10, [rdx + rcx * 1]
jmp stage_final_compare
stage_final_zero:
mov r10, 0
stage_final_compare:
cmp r9, r10
jne failed
add rcx, 1
cmp rcx, 0x6000
jne stage_final_table
mov r8, r14
add r8, 0x90
lea rdx, [rip + stage_final_entry]
mov rcx, 56
stage_final_header:
load8 r9, [r8]
load8 r10, [rdx]
cmp r9, r10
jne failed
add r8, 1
add rdx, 1
sub rcx, 1
cmp rcx, 0
jne stage_final_header
; Contexte de test : une constante negative, avant les vecteurs de donnees.
mov rcx, r14
add rcx, 16
lea rdx, [rip + nd_negative]
call native_symbol_insert
cmp r10, 0
jne failed
; Phase de remplissage : chaque cas part de compteurs connus et d'un scratch A5.
lea r8, [rip + phase]
mov r9, 13
store64 [r8], r9
lea r12, [rip + fill_cases]
mov r13, 61
fill_test_next:
mov rax, 12
store64 [r14 + 0x28], rax
mov rax, 32
store64 [r14 + 0x18], rax
mov rax, 48
store64 [r14 + 0x20], rax
load64 rax, [r12 + 16]
store64 [r14 + 0x90], rax
cmp rax, 4
je fill_test_text
cmp rax, 5
je fill_test_ro
mov r15, r14
add r15, 0x20
jmp fill_test_cursor
fill_test_text:
mov r15, r14
add r15, 0x28
jmp fill_test_cursor
fill_test_ro:
mov r15, r14
add r15, 0x18
fill_test_cursor:
load64 rax, [r12 + 24]
store64 [r15], rax
mov rax, 7
store64 [r14 + 0x30], rax
mov rax, 1
store64 [r14 + 0x38], rax
mov r8, r14
add r8, 0x1C510
mov rcx, 128
mov rax, 0xA5A5A5A5A5A5A5A5
fill_poison:
store64 [r8], rax
add r8, 8
sub rcx, 1
cmp rcx, 0
jne fill_poison
mov rax, 31
store64 [r14 + 0x1CE50], rax
mov rax, 37
store64 [r14 + 0x1C910], rax
mov rcx, r14
add rcx, 16
load64 rdx, [r12]
load64 r8, [r12 + 8]
lea r9, [rip + fill_origin]
call driver_front_line
load64 r8, [r12 + 32]
cmp r10, r8
jne failed
load64 r8, [r12 + 40]
cmp r11, r8
jne failed
load64 r8, [r12 + 72]
cmp rax, r8
jne failed
load64 r8, [r12 + 48]
load64 r9, [r15]
cmp r8, r9
jne failed
load64 r8, [r12 + 56]
load64 r9, [r14 + 0x30]
cmp r8, r9
jne failed
load64 r8, [r12 + 64]
load64 r9, [r14 + 0x38]
cmp r8, r9
jne failed
load64 r8, [r12 + 16]
load64 r9, [r14 + 0x90]
cmp r8, r9
jne failed
load64 r9, [r14 + 16]
cmp r9, 7
jne failed
mov rdi, 0
cmp r10, 0
jne fill_check_bytes
load64 rdi, [r12 + 56]
cmp rdi, 1024
jb fill_check_bytes
mov rdi, 1024
fill_check_bytes:
mov r8, r14
add r8, 0x1C510
mov rcx, 0
fill_byte_check:
load8 r9, [r8 + rcx * 1]
cmp rcx, rdi
jae fill_expected_poison
load64 r10, [r12 + 88]
cmp r10, 0
je fill_expected_pattern
load8 r10, [r10 + rcx * 1]
jmp fill_expected_value
fill_expected_pattern:
load64 r10, [r12 + 80]
jmp fill_expected_value
fill_expected_poison:
mov r10, 165
fill_expected_value:
cmp r9, r10
jne failed
add rcx, 1
cmp rcx, 1024
jne fill_byte_check
load64 r9, [r14 + 0x1CE50]
cmp r9, 31
jne failed
load64 r9, [r14 + 0x1C910]
cmp r9, 37
jne failed
add r12, 96
sub r13, 1
cmp r13, 0
jne fill_test_next
load64 r9, [r14]
cmp r9, 31
jne failed
load64 r9, [r14 + 8]
cmp r9, 31
jne failed
load64 r9, [r14 + 0x1D010]
cmp r9, 37
jne failed
load64 r9, [r14 + 0x1D018]
cmp r9, 37
jne failed
lea r15, [rip + pass_msg]
jmp release_pool
failed:
lea r8, [rip + phase]
load64 rax, [r8]
cmp rax, 8
jae bulk_failure_index
mov rax, 24
sub rax, r13
jmp failure_index_ready
bulk_failure_index:
mov rax, r13
failure_index_ready:
lea r8, [rip + diagnostic]
add r8, 28
lea r9, [rip + hex_chars]
mov r10, 4
diag_index:
mov rcx, rax
and rcx, 15
load8 rdx, [r9 + rcx * 1]
store16 [r8], rdx
sub r8, 2
shr rax, 4
sub r10, 1
cmp r10, 0
jne diag_index
lea r8, [rip + phase]
load64 rax, [r8]
load8 rax, [r9 + rax * 1]
lea r8, [rip + diagnostic]
store16 [r8 + 40], rax
lea r8, [rip + observed]
load64 rax, [r8]
shl rax, 16
load64 rcx, [r8 + 8]
or rax, rcx
lea r8, [rip + diagnostic]
add r8, 60
mov r10, 8
diag_result:
mov rcx, rax
and rcx, 15
load8 rdx, [r9 + rcx * 1]
store16 [r8], rdx
sub r8, 2
shr rax, 4
sub r10, 1
cmp r10, 0
jne diag_result
lea r15, [rip + diagnostic]
release_pool:
mov rcx, r14
load64 rax, [rsi + 0x48]
call rax
cmp rax, 0
je report
lea r15, [rip + fail_msg]
jmp report
no_pool:
lea r15, [rip + fail_msg]
report:
mov rdx, r15
load64 rcx, [rbx + 0x40]
load64 rax, [rcx + 8]
call rax
add rsp, 48
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
mov rax, 0
ret

driver_front_line:
sub rsp, 40
call native_front_line
lea r8, [rip + observed]
store64 [r8], r10
store64 [r8 + 8], r11
add rsp, 40
ret

; RCX=WORK, RDX=ligne, R8=longueur, R9=provenance comme native_add_const.
; RAX=tag (0 vide, 1 format, 2 abi, 3 const, 4 entry, 5 section, 6 label).
; R10=code, R11=index local. Les instructions et donnees ne sont pas encore portees ici.
native_front_line:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 64
mov r12, rcx
mov rsi, rdx
mov rdi, r8
mov rbx, r9
load64 r13, [r12 + 0x80]
cmp r13, 7
jae ns_internal
load64 rax, [r12]
cmp rax, 513
jae ns_internal
mov r14, r12
add r14, 0x1C400
mov rcx, rsi
mov rdx, rdi
mov r8, r14
call native_lex_line
cmp r10, 0
jne ns_zero_return
mov r15, rax
cmp r15, 0
je ns_ok
mov rax, r15
sub rax, 1
imul rax, rax, 16
add rax, r14
load64 rcx, [rax]
load64 rdx, [rax + 8]
add rcx, rdx
store64 [rsp + 0x20], rcx
mov rcx, rbx
mov rdx, rdi
call ns_check_origin
cmp rax, 0
jne ns_internal
cmp r13, 2
jb ns_preamble
cmp r13, 2
je ns_const_entry
cmp r13, 3
je ns_section_only
; Une declaration de label est reconnue avant les mots-cles de corps.
cmp r15, 2
jb ns_body_keyword
load64 rax, [r14 + 24]
cmp rax, 1
jne ns_body_keyword
load64 rax, [r14 + 16]
load8 rax, [rsi + rax * 1]
cmp rax, 58
je ns_label
ns_body_keyword:
lea r8, [rip + ns_kw_section]
mov r9, 7
mov rcx, 0
call ns_token_equals
cmp rax, 1
je ns_section
lea r8, [rip + nf_kw_align]
mov r9, 5
mov rcx, 0
call ns_token_equals
cmp rax, 1
je nf_align
lea r8, [rip + nf_kw_zero]
mov r9, 4
mov rcx, 0
call ns_token_equals
cmp rax, 1
je nf_zero
jmp ns_body
ns_section_only:
lea r8, [rip + ns_kw_section]
mov r9, 7
mov rcx, 0
call ns_token_equals
cmp rax, 1
jne ns_order_zero
jmp ns_section
ns_preamble:
cmp r13, 0
jne ns_abi_word
lea r8, [rip + ns_kw_format]
mov r9, 6
jmp ns_preamble_word
ns_abi_word:
lea r8, [rip + ns_kw_abi]
mov r9, 3
ns_preamble_word:
mov rcx, 0
call ns_token_equals
cmp rax, 1
jne ns_order_zero
cmp r15, 2
jb ns_missing
mov rcx, 1
call ns_require_space
cmp rax, 0
jne ns_syntax_one
cmp r13, 0
jne ns_abi_value
lea r8, [rip + ns_kw_pe64]
mov r9, 4
jmp ns_preamble_value
ns_abi_value:
lea r8, [rip + ns_kw_efi]
mov r9, 7
ns_preamble_value:
mov rcx, 1
call ns_token_equals
cmp rax, 1
jne ns_order_one
cmp r15, 2
jne ns_extra_two
mov rax, r13
add rax, 1
store64 [r12 + 0x80], rax
jmp ns_ok
ns_const_entry:
lea r8, [rip + kw_const]
mov r9, 5
mov rcx, 0
call ns_token_equals
cmp rax, 1
jne ns_maybe_entry
mov rcx, r12
mov rdx, rsi
mov r8, rdi
mov r9, rbx
call native_add_const
cmp r10, 0
jne ns_return
mov rax, 3
jmp ns_ok
ns_maybe_entry:
lea r8, [rip + kw_entry]
mov r9, 5
mov rcx, 0
call ns_token_equals
cmp rax, 1
jne ns_order_zero
cmp r15, 2
jb ns_missing
mov rcx, 1
call ns_require_space
cmp rax, 0
jne ns_syntax_one
load64 rcx, [r14 + 16]
add rcx, rsi
load64 rdx, [r14 + 24]
call native_name_check
cmp rax, 0
jne ns_name_one_error
lea r8, [rip + kw_const]
mov r9, 5
mov rcx, 1
call ns_token_equals
cmp rax, 1
je ns_syntax_one
lea r8, [rip + kw_entry]
mov r9, 5
mov rcx, 1
call ns_token_equals
cmp rax, 1
je ns_syntax_one
cmp r15, 2
jne ns_extra_two
load64 rax, [r14 + 16]
add rax, rsi
store64 [r12 + 0x90], rax
load64 rax, [r14 + 24]
store64 [r12 + 0x98], rax
load64 rax, [rbx]
load64 rdx, [r14 + 16]
add rax, rdx
store64 [r12 + 0xA0], rax
load64 rax, [rbx + 8]
store64 [r12 + 0xA8], rax
load64 rax, [rbx]
store64 [r12 + 0xB0], rax
mov rax, 1
store64 [r12 + 0x88], rax
mov rax, 3
store64 [r12 + 0x80], rax
mov rax, 4
jmp ns_ok
ns_section:
cmp r13, 6
je ns_order_zero
cmp r15, 2
jb ns_missing
mov rcx, 1
call ns_require_space
cmp rax, 0
jne ns_syntax_one
cmp r13, 3
je ns_text_name
cmp r13, 4
je ns_ro_name
lea r8, [rip + ns_kw_data]
mov r9, 5
jmp ns_section_name
ns_text_name:
lea r8, [rip + ns_kw_text]
mov r9, 5
jmp ns_section_name
ns_ro_name:
lea r8, [rip + ns_kw_ro]
mov r9, 6
ns_section_name:
mov rcx, 1
call ns_token_equals
cmp rax, 1
jne ns_order_one
cmp r15, 3
jb ns_missing
mov rcx, 2
call ns_require_space
cmp rax, 0
jne ns_syntax_two
cmp r13, 3
je ns_text_flags
cmp r13, 4
je ns_ro_flags
lea r8, [rip + ns_kw_rw]
mov r9, 2
jmp ns_section_flags
ns_text_flags:
lea r8, [rip + ns_kw_rx]
mov r9, 2
jmp ns_section_flags
ns_ro_flags:
lea r8, [rip + ns_kw_r]
mov r9, 1
ns_section_flags:
mov rcx, 2
