module register_bindings;

import ntasm_ast;
import register_widths;

// Node kinds: import 9, function declaration 18, parameter 19.

// Byte-wise comparison over the real source text with bounds.
fn same_bytes(source:buf<u8>,a_start:u64,a_end:u64,b_start:u64,b_end:u64)->bool {
    if a_start>a_end || b_start>b_end || a_end>len(source) || b_end>len(source) {
        return false;
    }
    if (a_end-a_start)!=(b_end-b_start) { return false; }
    let mut i:u64=0;
    while i<(a_end-a_start) {
        if source[a_start+i]!=source[b_start+i] { return false; }
        i=i+1;
    }
    return true;
}

// Direct child of parent at the given ordinal, or 0 when the chain or
// the tree is invalid.
fn child(tree:ntasm_ast.Tree,parent:u64,ordinal:u64)->u64 {
    if parent==0 || parent>tree.node_count { return 0; }
    let p:ntasm_ast.Node=ntasm_ast.node_at(tree,parent);
    let mut id:u64=p.first_child;
    let mut index:u64=0;
    while id!=0 && index<ordinal {
        if id>tree.node_count { return 0; }
        let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        id=n.next_sibling;
        index=index+1;
    }
    if id>tree.node_count { return 0; }
    return id;
}

// Explicit register bindings within each declaration. For every
// function (kind 18) and import (kind 9), the direct parameter
// children (kind 19) carry name as first child, type as second child,
// and optionally the register name after @ as third child. Explicit
// registers must be pairwise distinct physical families when their x86_64
// spelling is known, or distinct byte strings otherwise. The same register in
// two different declarations, and parameters without @, are accepted.
// Returns 0 on success, writing out[0]=functions, out[1]=imports,
// out[2]=explicit bindings. Returns 317 on the second occurrence of
// the same explicit register or known alias inside one declaration, writing the line
// and column of the second register to out[0..1]. Returns 800 with no
// write to out on an invalid tree, an invalid span or child chain, or
// an output buffer shorter than three words. The scratch buffer is
// always freed; neither source nor tree is released.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64 {
    let n_import:u64=9;
    let n_function:u64=18;
    let n_parameter:u64=19;
    let entry_words:u64=2;
    if tree.ok==false { return 800; }
    if tree.node_count==0 { return 800; }
    if len(out)<3 { return 800; }

    let scratch:buf<u64>=alloc(runtime(),tree.node_count*entry_words);
    let mut used:u64=0;
    let mut imports:u64=0;
    let mut functions:u64=0;
    let mut bindings:u64=0;
    let mut code:u64=0;
    let mut dup_line:u64=0;
    let mut dup_column:u64=0;

    let mut id:u64=1;
    while id<=tree.node_count {
        let node:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if node.kind==n_import || node.kind==n_function {
            if node.kind==n_function { functions=functions+1; }
            else { imports=imports+1; }
            // Reset the per-declaration register table.
            used=0;
            // Walk direct children, keep only parameters (kind 19).
            let mut child_id:u64=node.first_child;
            while child_id!=0 && code==0 {
                if child_id>tree.node_count { code=800; }
                else {
                    let cn:ntasm_ast.Node=ntasm_ast.node_at(tree,child_id);
                    if cn.kind==n_parameter {
                        // name, type, then optional register after @.
                        let name_id:u64=child(tree,child_id,0);
                        let type_id:u64=child(tree,child_id,1);
                        let reg_id:u64=child(tree,child_id,2);
                        if name_id==0 || type_id==0 { code=800; }
                        else if reg_id!=0 {
                            let reg:ntasm_ast.Node=ntasm_ast.node_at(tree,reg_id);
                            if reg.start>reg.end || reg.end>len(source) {
                                code=800;
                            } else {
                                // Duplicate scan: current declaration only.
                                let mut j:u64=0;
                                while j<used {
                                    let at:u64=j*entry_words;
                                    let previous_family:u64=register_widths.family(
                                        source,scratch[at],scratch[at+1]);
                                    let current_family:u64=register_widths.family(
                                        source,reg.start,reg.end);
                                    if (current_family!=0
                                        && current_family==previous_family)
                                       || (current_family==0
                                           && previous_family==0
                                           && same_bytes(source,scratch[at],
                                               scratch[at+1],reg.start,reg.end)) {
                                        code=317;
                                        dup_line=reg.line;
                                        dup_column=reg.column;
                                    }
                                    j=j+1;
                                }
                                if code==0 {
                                    let at:u64=used*entry_words;
                                    scratch[at]=reg.start;
                                    scratch[at+1]=reg.end;
                                    used=used+1;
                                    bindings=bindings+1;
                                }
                            }
                        }
                    }
                    if code==0 { child_id=cn.next_sibling; }
                }
            }
            if code!=0 { id=tree.node_count+1; }
        }
        if code==0 { id=id+1; }
    }

    if code==0 {
        out[0]=functions;
        out[1]=imports;
        out[2]=bindings;
    } else if code==317 && len(out)>=2 {
        out[0]=dup_line;
        out[1]=dup_column;
    }
    rt_free(runtime(),scratch);
    return code;
}
