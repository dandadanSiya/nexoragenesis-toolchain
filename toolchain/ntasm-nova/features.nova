module features;
import ntasm_ast;
fn same(source:buf<u8>,start:u64,end:u64,text:buf<u8>)->bool{if start>end||end>len(source)||(end-start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[start+i]!=text[i]{return false;}i=i+1;}return true;}
export fn lookup(source:buf<u8>,start:u64,end:u64)->u64{let a:buf<u8>="lm";if same(source,start,end,a){return 1;}let b:buf<u8>="msr";if same(source,start,end,b){return 2;}let c:buf<u8>="syscall";if same(source,start,end,c){return 4;}let d:buf<u8>="sse2";if same(source,start,end,d){return 8;}let e:buf<u8>="tsc";if same(source,start,end,e){return 16;}return 0;}
// Validate target feature declarations. Long mode bit1 is implicit and may be
// repeated idempotently, matching the bootstrap oracle. Success writes feature
// set count,explicit entries,mask including lm,0. Error341 unknown/qualified;
// 342 duplicate non-lm or repeated set (reason1/2 in out[2]).
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let mut sets:u64=0;let mut entries:u64=0;let mut mask:u64=1;let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut reason:u64=0;let mut id:u64=1;while id<=tree.node_count&&code==0{let wrapper:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if wrapper.kind==8&&wrapper.first_child!=0&&wrapper.first_child<=tree.node_count{let set:ntasm_ast.Node=ntasm_ast.node_at(tree,wrapper.first_child);if set.kind==8{sets=sets+1;if sets>1{code=342;reason=2;line=wrapper.line;column=wrapper.column;}else{let mut child_id:u64=set.first_child;while child_id!=0&&code==0{if child_id>tree.node_count{code=800;}else{let q:ntasm_ast.Node=ntasm_ast.node_at(tree,child_id);if q.kind!=91||q.first_child==0||q.last_child==0||q.first_child>tree.node_count||q.last_child>tree.node_count{code=800;}else if q.first_child!=q.last_child{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,q.last_child);code=341;line=name.line;column=name.column;}else{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,q.first_child);let bit:u64=lookup(source,name.start,name.end);if bit==0{code=341;line=name.line;column=name.column;}else if bit!=1&&(mask&bit)!=0{code=342;reason=1;line=name.line;column=name.column;}else{mask=mask|bit;entries=entries+1;}}child_id=q.next_sibling;}}}}}id=id+1;}if code==0{out[0]=sets;out[1]=entries;out[2]=mask;out[3]=0;}else if code==341{out[0]=line;out[1]=column;out[2]=0;out[3]=0;}else if code==342{out[0]=line;out[1]=column;out[2]=reason;out[3]=0;}return code;}
