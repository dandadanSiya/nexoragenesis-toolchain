add rax, 1
imul rax, rax, 16
add rax, r14
load64 r11, [rax]
fc_syntax:
mov rax, 0
mov r10, 201
jmp fc_return
fc_internal:
mov rax, 0
mov r10, 600
mov r11, 0
fc_return:
add rsp, 96
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret

; Spans bornes, casse exacte.
fc_equals:
cmp rdx, r9
jne fc_not_equal
mov r10, 0
fc_equal_byte:
cmp r10, rdx
jae fc_equal
load8 rax, [rcx + r10 * 1]
load8 r11, [r8 + r10 * 1]
cmp rax, r11
jne fc_not_equal
add r10, 1
jmp fc_equal_byte
fc_equal:
mov rax, 1
ret
fc_not_equal:
mov rax, 0
ret

; Coeur de native-u64.ntasm.
native_parse_u64:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 32
mov rsi, rcx
mov rdi, rdx
mov r12, 0
mov r15, 0
cmp rdi, 0
je np_bad
load8 rax, [rsi]
cmp rax, 48
jne np_decimal
cmp rdi, 1
je np_ok
mov r15, 1
load8 rax, [rsi + 1]
cmp rax, 120
jne np_bad
mov r15, 2
cmp r15, rdi
jae np_bad
mov rbx, 16
mov r13, r8
shr r13, 4
mov r14, r8
and r14, 15
jmp np_digit
np_decimal:
mov rbx, 10
mov r13, 0
mov r14, 0
mov r9, 64
; Division binaire par 10 (pas de DIV S0).
; Reste <=19; jamais de shift 64.
np_divide:
mov rax, r8
shr rax, 63
shl r8, 1
shl r13, 1
shl r14, 1
or r14, rax
cmp r14, 10
jb np_divide_next
sub r14, 10
or r13, 1
np_divide_next:
sub r9, 1
jne np_divide
np_digit:
cmp r15, rdi
jae np_ok
load8 rax, [rsi + r15 * 1]
cmp rbx, 16
je np_hex
sub rax, 48
cmp rax, 10
jae np_bad
jmp np_bound
np_hex:
mov rcx, rax
sub rax, 48
cmp rax, 10
jb np_bound
mov rax, rcx
or rax, 32
sub rax, 97
cmp rax, 6
jae np_bad
add rax, 10
np_bound:
; Verifier borne/base avant multiplication.
cmp r12, r13
jb np_accumulate
cmp r12, r13
jne np_bad
cmp r14, rax
jb np_bad
np_accumulate:
cmp rbx, 16
je np_accumulate_hex
imul r12, r12, 10
jmp np_accumulate_digit
np_accumulate_hex:
shl r12, 4
np_accumulate_digit:
add r12, rax
add r15, 1
jmp np_digit
np_ok:
mov rax, r12
mov r10, 0
mov r11, 0
jmp np_return
np_bad:
mov rax, 0
mov r10, 102
mov r11, r15
np_return:
add rsp, 32
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret

; Coeur de native-lexer.ntasm.
native_lex_line:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 48
mov rsi, rcx
mov rdi, rdx
mov r12, r8
; Le lexer du coeur recoit toujours la table WORK+1C400.
; +170 = premiere colonne fautive (1-based), +178 = debut du token.
mov rax, r8
sub rax, 0x1C400
store64 [rsp + 32], rax
mov rcx, 0
store64 [rax + 0x170], rcx
store64 [rax + 0x180], rcx
store64 [rax + 0x188], rcx
mov rcx, -1
store64 [rax + 0x178], rcx
mov r13, 0
mov r14, 0
mov r15, 0
; Lecture bornee, commentaires compris.
nl_physical:
cmp r13, rdi
jae nl_physical_done
cmp r13, 255
jae nl_physical_limit
load8 rax, [rsi + r13 * 1]
cmp rax, 9
je nl_physical_next
cmp rax, 32
jb nl_physical_bad
cmp rax, 127
jae nl_physical_bad
nl_physical_next:
add r13, 1
jmp nl_physical
nl_physical_done:
mov r13, 0
nl_next:
cmp r13, rdi
jae nl_ok
load8 rax, [rsi + r13 * 1]
cmp rax, 32
je nl_space
cmp rax, 9
je nl_space
cmp rax, 59
je nl_ok
mov r15, r13
cmp r14, 16
jae nl_token_limit
cmp rax, 34
je nl_string_start
mov rbx, 0
cmp rax, 46
je nl_section
cmp rax, 48
jb nl_first_letter
cmp rax, 58
jb nl_word
nl_first_letter:
cmp rax, 95
je nl_identifier
or rax, 32
cmp rax, 97
jb nl_punctuation
cmp rax, 123
jae nl_punctuation
nl_identifier:
mov rbx, 1
jmp nl_word
nl_section:
add r13, 1
jmp nl_word
nl_punctuation:
add r13, 1
jmp nl_record
nl_space:
add r13, 1
jmp nl_next
; Entier lexical, chiffres valides par native_parse_u64.
nl_word:
cmp r13, rdi
jae nl_record
load8 rax, [rsi + r13 * 1]
cmp rax, 95
je nl_word_char
cmp rax, 48
jb nl_word_letter
cmp rax, 58
jb nl_word_char
nl_word_letter:
or rax, 32
cmp rax, 97
jb nl_record
cmp rax, 123
jae nl_record
nl_word_char:
cmp rbx, 1
jne nl_word_advance
mov rax, r13
sub rax, r15
cmp rax, 31
jae nl_limit
nl_word_advance:
add r13, 1
jmp nl_word
nl_string_start:
add r13, 1
nl_string:
cmp r13, rdi
jae nl_escape_bad
load8 rax, [rsi + r13 * 1]
cmp rax, 34
je nl_string_closed
cmp rax, 32
jb nl_escape_bad
cmp rax, 92
jne nl_string_advance
add r13, 1
cmp r13, rdi
jae nl_escape_bad
load8 rax, [rsi + r13 * 1]
cmp rax, 92
je nl_string_advance
cmp rax, 34
je nl_string_advance
cmp rax, 114
je nl_string_advance
cmp rax, 110
je nl_string_advance
cmp rax, 116
je nl_string_advance
cmp rax, 48
je nl_string_advance
cmp rax, 120
jne nl_escape_bad
add r13, 1
cmp r13, rdi
jae nl_escape_bad
load8 rax, [rsi + r13 * 1]
call nl_hex_digit
cmp rax, -1
je nl_escape_bad
add r13, 1
cmp r13, rdi
jae nl_escape_bad
load8 rax, [rsi + r13 * 1]
call nl_hex_digit
cmp rax, -1
je nl_escape_bad
nl_string_advance:
add r13, 1
jmp nl_string
nl_string_closed:
add r13, 1
nl_record:
; Publication apres validation; pas de record partiel.
store64 [r12], r15
mov rax, r13
sub rax, r15
store64 [r12 + 8], rax
add r12, 16
add r14, 1
jmp nl_next
nl_ok:
mov r10, 0
mov r11, 0
mov r9, 0
jmp nl_return
nl_physical_bad:
mov r15, r13
mov r10, 100
jmp nl_error
nl_physical_limit:
mov r15, r13
nl_limit:
mov r10, 101
jmp nl_error
nl_token_limit:
; Garder les seize tokens complets pour arbitrer les erreurs anterieures.
load64 rdx, [rsp + 32]
mov rax, 1
store64 [rdx + 0x188], rax
load64 rax, [rdx + 0x170]
cmp rax, 0
jne nl_ok
lea rax, [r13 + 1]
store64 [rdx + 0x170], rax
mov rax, 101
store64 [rdx + 0x180], rax
jmp nl_ok
nl_escape_bad:
; Conserver la premiere erreur, puis terminer le token sans decoder.
; Cela permet de diagnostiquer les operandes precedents avant cette chaine.
load64 rdx, [rsp + 32]
load64 rax, [rdx + 0x170]
cmp rax, 0
jne nl_recover_string
lea rax, [r13 + 1]
store64 [rdx + 0x170], rax
store64 [rdx + 0x178], r15
mov rax, 102
store64 [rdx + 0x180], rax
nl_recover_string:
cmp r13, rdi
jae nl_record
load8 rax, [rsi + r13 * 1]
cmp rax, 34
je nl_string_closed
add r13, 1
cmp rax, 92
jne nl_recover_string
; Une quote echappee ne ferme pas le token malforme.
cmp r13, rdi
jae nl_record
add r13, 1
jmp nl_recover_string
nl_error:
mov r11, r13
mov r9, r15
nl_return:
mov rax, r14
add rsp, 48
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret

; RAX=ASCII -> chiffre 0..15/-1, RCX volatile.
nl_hex_digit:
mov rcx, rax
sub rax, 48
cmp rax, 10
jb nl_hex_return
mov rax, rcx
or rax, 32
sub rax, 97
cmp rax, 6
jae nl_hex_bad
add rax, 10
nl_hex_return:
ret
nl_hex_bad:
mov rax, -1
ret

; Coeur de native-symbols.ntasm.
native_symbol_find:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 32
mov r12, rcx
mov rsi, rdx
mov rdi, r8
load64 r13, [r12]
cmp r13, 513
jae sf_internal
mov rcx, rsi
mov rdx, rdi
call native_name_check
cmp rax, 0
jne sf_name_error
lea r14, [r12 + 0x400]
mov rbx, 0
sf_record:
cmp rbx, r13
jae sf_absent
mov r15, 0
sf_byte:
cmp r15, rdi
jae sf_length
load8 rax, [rsi + r15 * 1]
load8 r9, [r14 + r15 * 1]
cmp rax, r9
jne sf_next
add r15, 1
jmp sf_byte
sf_length:
load8 rax, [r14 + r15 * 1]
cmp rax, 0
jne sf_next
mov rax, r14
mov r10, 0
mov r11, 0
jmp sf_return
sf_next:
add r14, 48
add rbx, 1
jmp sf_record
sf_absent:
mov r10, 301
mov r11, 0
jmp sf_zero
sf_internal:
mov r10, 600
mov r11, 0
jmp sf_zero
sf_name_error:
mov r10, rax
sf_zero:
mov rax, 0
sf_return:
add rsp, 32
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret

; RDX=candidat48, nom NUL, metadata+32.
; Metadata preparee par appelant; noms/places ici.
native_symbol_insert:
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 40
mov r12, rcx
mov rsi, rdx
mov rdi, 0
si_name_length:
cmp rdi, 32
jae si_name_long
load8 rax, [rsi + rdi * 1]
cmp rax, 0
je si_lookup
add rdi, 1
jmp si_name_length
si_lookup:
mov rcx, r12
mov rdx, rsi
mov r8, rdi
call native_symbol_find
cmp r10, 0
je si_duplicate
cmp r10, 301
jne si_return
load64 r13, [r12]
cmp r13, 512
jae si_full
imul r14, r13, 48
add r14, r12
add r14, 0x400
; Valider avant write; nom zero jusqu'a 32.
mov rax, 0
store64 [r14], rax
store64 [r14 + 8], rax
store64 [r14 + 16], rax
store64 [r14 + 24], rax
mov r15, 0
si_copy_name:
cmp r15, rdi
jae si_metadata
load8 rax, [rsi + r15 * 1]
store8 [r14 + r15 * 1], rax
add r15, 1
jmp si_copy_name
si_metadata:
load64 rax, [rsi + 32]
store64 [r14 + 32], rax
load64 rax, [rsi + 40]
store64 [r14 + 40], rax
add r13, 1
store64 [r12], r13
mov rax, r14
mov r10, 0
mov r11, 0
jmp si_return
si_duplicate:
mov rax, 0
mov r10, 300
mov r11, 0
jmp si_return
si_full:
mov rax, 0
mov r10, 500
mov r11, 0
jmp si_return
si_name_long:
mov rax, 0
mov r10, 101
mov r11, 31
si_return:
add rsp, 40
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
ret

; RCX=nom/RDX=len; RAX=0/101/201, R11=index.
native_name_check:
mov r11, 0
cmp rdx, 0
je nc_bad
cmp rdx, 32
jae nc_long
mov r8, 0
nc_byte:
load8 rax, [rcx + r8 * 1]
cmp rax, 95
je nc_next
; Chiffres avant casse : 0x10|0x20 n'est pas '0'.
cmp rax, 48
jb nc_letter
cmp rax, 58
jb nc_digit
nc_letter:
or rax, 32
cmp rax, 97
jb nc_bad_at
cmp rax, 123
jb nc_next
jmp nc_bad_at
nc_digit:
cmp r8, 0
je nc_bad_at
nc_next:
add r8, 1
cmp r8, rdx
jb nc_byte
mov rax, 0
ret
nc_bad_at:
mov r11, r8
nc_bad:
mov rax, 201
ret
nc_long:
mov rax, 101
mov r11, 31
ret
