module pointer_spaces;
import ntasm_ast;
fn same(source:buf<u8>,start:u64,end:u64,text:buf<u8>)->bool{if start>end||end>len(source)||(end-start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[start+i]!=text[i]{return false;}i=i+1;}return true;}
fn bit(source:buf<u8>,node:ntasm_ast.Node)->u64{let a:buf<u8>="user";if same(source,node.start,node.end,a){return 1;}let b:buf<u8>="kernel";if same(source,node.start,node.end,b){return 2;}let c:buf<u8>="physical";if same(source,node.start,node.end,c){return 4;}let d:buf<u8>="mmio";if same(source,node.start,node.end,d){return 8;}let e:buf<u8>="device";if same(source,node.start,node.end,e){return 16;}let f:buf<u8>="firmware";if same(source,node.start,node.end,f){return 32;}return 0;}
// Validate every ptr<space,T> node, including nested, return and data types.
// Success writes pointer count,nested pointer count,space mask,0. Error340
// writes the unknown space position. Error800 is transactional.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let mut pointers:u64=0;let mut nested:u64=0;let mut spaces:u64=0;let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut id:u64=1;while id<=tree.node_count&&code==0{let type_:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if type_.kind==36&&type_.aux==1{pointers=pointers+1;if type_.first_child==0||type_.last_child==0||type_.first_child>tree.node_count||type_.last_child>tree.node_count{code=800;}else{let space:ntasm_ast.Node=ntasm_ast.node_at(tree,type_.first_child);let element:ntasm_ast.Node=ntasm_ast.node_at(tree,type_.last_child);if space.kind!=90||space.start>space.end||space.end>len(source){code=800;}else{let value:u64=bit(source,space);if value==0{code=340;line=space.line;column=space.column;}else{spaces=spaces|value;if element.kind==36&&element.aux==1{nested=nested+1;}}}}}id=id+1;}if code==0{out[0]=pointers;out[1]=nested;out[2]=spaces;out[3]=0;}else if code==340{out[0]=line;out[1]=column;out[2]=0;out[3]=0;}return code;}
