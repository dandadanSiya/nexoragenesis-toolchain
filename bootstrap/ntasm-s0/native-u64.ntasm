; Composant natif du futur compilateur : parser u64 + driver de test UEFI.
; Le driver ne constitue pas encore un assembleur auto-heberge.
format pe64
abi efi_x64
entry start
section .text rx
start:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 32
mov rbx, rdx
mov rsi, 17
mov rdi, 19
mov r14, 23
mov r15, 29
lea r12, [rip + vectors]
mov r13, 199
test_next:
load64 rcx, [r12]
load64 rdx, [r12 + 8]
load64 r8, [r12 + 16]
call native_parse_u64
; Sentinelles ABI : ces registres doivent survivre aux 199 appels.
cmp rsi, 17
jne failed
cmp rdi, 19
jne failed
cmp r14, 23
jne failed
cmp r15, 29
jne failed
load64 r9, [r12 + 24]
cmp rax, r9
jne failed
load64 r9, [r12 + 32]
cmp r10, r9
jne failed
load64 r9, [r12 + 40]
cmp r11, r9
jne failed
add r12, 48
sub r13, 1
cmp r13, 0
jne test_next
lea rdx, [rip + pass_msg]
jmp emit
failed:
lea rdx, [rip + fail_msg]
emit:
load64 rcx, [rbx + 0x40]
load64 rax, [rcx + 8]
call rax
add rsp, 32
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
mov rax, 0
ret

; RCX=adresse, RDX=longueur, R8=borne inclusive u64.
; Retour RAX=valeur (zero si erreur), R10=0/102, R11=index de faute.
; Aucun I/O, allocation ou producteur externe : ce corps est entierement NTASM.
native_parse_u64:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 32
mov rsi, rcx
mov rdi, rdx
mov r12, 0
mov r15, 0
cmp rdi, 0
je np_bad
load8 rax, [rsi]
cmp rax, 48
jne np_decimal
cmp rdi, 1
je np_ok
mov r15, 1
load8 rax, [rsi + 1]
cmp rax, 120
jne np_bad
mov r15, 2
cmp r15, rdi
jae np_bad
mov rbx, 16
mov r13, r8
shr r13, 4
mov r14, r8
and r14, 15
jmp np_digit
np_decimal:
mov rbx, 10
mov r13, 0
mov r14, 0
mov r9, 64
; Division binaire par 10 : evite de dependre d'une instruction absente de S0.
; Le reste intermediaire ne depasse pas 19; aucun decalage ne vaut 64.
np_divide:
mov rax, r8
shr rax, 63
shl r8, 1
shl r13, 1
shl r14, 1
or r14, rax
cmp r14, 10
jb np_divide_next
sub r14, 10
or r13, 1
np_divide_next:
sub r9, 1
cmp r9, 0
jne np_divide
np_digit:
cmp r15, rdi
jae np_ok
load8 rax, [rsi + r15 * 1]
cmp rbx, 16
je np_hex
sub rax, 48
cmp rax, 10
jae np_bad
jmp np_bound
np_hex:
mov rcx, rax
sub rax, 48
cmp rax, 10
jb np_bound
mov rax, rcx
or rax, 32
sub rax, 97
cmp rax, 6
jae np_bad
add rax, 10
np_bound:
; Tester acc <= borne/base AVANT multiplier, puis verifier le dernier chiffre.
cmp r12, r13
jb np_accumulate
cmp r12, r13
jne np_bad
cmp r14, rax
jb np_bad
np_accumulate:
cmp rbx, 16
je np_accumulate_hex
imul r12, r12, 10
jmp np_accumulate_digit
np_accumulate_hex:
shl r12, 4
np_accumulate_digit:
add r12, rax
add r15, 1
jmp np_digit
np_ok:
mov rax, r12
mov r10, 0
mov r11, 0
jmp np_return
np_bad:
mov rax, 0
mov r10, 102
mov r11, r15
np_return:
add rsp, 32
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret

