fn comptime_decl(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,11,begin);step(p);
    if (!expect(p,40,4)) { return 0; }lines(p);
    while (tk(p)!=41 && p.code==0) {
        let n:u64=node(p,12,ti(p));attach(p,n,name(p));
        if (!expect(p,61,4) || tk(p)!=258) { error(p,4);return 0; }
        attach(p,n,literal(p));attach(p,result,finish(p,n));lines(p);
        if (!accept(p,44)) { break; }lines(p);
    }
    if (!expect(p,41,4)) { return 0; }lines(p);attach(p,result,meta_block(p));
