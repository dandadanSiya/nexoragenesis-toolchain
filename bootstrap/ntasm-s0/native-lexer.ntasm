; Lexer natif reutilisable, avec driver UEFI de preuve.
; Une ligne sans EOL, ASCII imprimable/TAB, 255 octets, 16 tranches max.
format pe64
abi efi_x64
entry start
section .text rx
start:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 32
mov rbx, rdx
lea r12, [rip + test_vectors]
mov r13, 32
test_next:
lea r14, [rip + token_buffer]
mov rcx, 32
mov rax, 0xA5A5A5A5A5A5A5A5
poison:
store64 [r14], rax
add r14, 8
sub rcx, 1
cmp rcx, 0
jne poison
mov rsi, 17
mov rdi, 19
mov r14, 23
mov r15, 29
load64 rcx, [r12]
load64 rdx, [r12 + 8]
lea r8, [rip + token_buffer]
call native_lex_line
mov rdx, r9
cmp rsi, 17
jne failed
cmp rdi, 19
jne failed
cmp r14, 23
jne failed
cmp r15, 29
jne failed
load64 r9, [r12 + 16]
cmp rax, r9
jne failed
load64 r9, [r12 + 24]
cmp r10, r9
jne failed
load64 r9, [r12 + 32]
cmp r11, r9
jne failed
load64 r9, [r12 + 40]
cmp rdx, r9
jne failed
lea r8, [rip + pre_guard]
load64 r9, [r8]
cmp r9, 31
jne failed
lea r8, [rip + post_guard]
load64 r9, [r8]
cmp r9, 37
jne failed
load64 rsi, [r12 + 48]
imul rdi, rax, 16
lea r14, [rip + token_buffer]
mov r15, 0
compare_byte:
load8 r9, [r14 + r15 * 1]
cmp r15, rdi
jae compare_poison
load8 rcx, [rsi + r15 * 1]
jmp compare_value
compare_poison:
mov rcx, 165
compare_value:
cmp r9, rcx
jne failed
add r15, 1
cmp r15, 256
jne compare_byte
add r12, 64
sub r13, 1
cmp r13, 0
jne test_next
; Phases suivantes : chacun des 256 octets seul, puis comme chiffre hex echappe.
lea r8, [rip + test_phase]
load64 rax, [r8]
cmp rax, 0
jne advance_exhaustive
mov rax, 1
store64 [r8], rax
lea r8, [rip + byte_counter]
mov rax, 0
store64 [r8], rax
jmp prepare_exhaustive
advance_exhaustive:
lea r8, [rip + byte_counter]
load64 rax, [r8]
add rax, 1
store64 [r8], rax
cmp rax, 256
jb prepare_exhaustive
lea r8, [rip + test_phase]
load64 rax, [r8]
cmp rax, 2
je all_passed
mov rax, 2
store64 [r8], rax
lea r8, [rip + byte_counter]
mov rax, 0
store64 [r8], rax
prepare_exhaustive:
lea r8, [rip + byte_counter]
load64 rdx, [r8]
lea r8, [rip + test_phase]
load64 rax, [r8]
cmp rax, 2
je prepare_hex
lea r8, [rip + byte_input]
store8 [r8], rdx
lea r8, [rip + byte_expected]
imul r9, rdx, 3
add r8, r9
load8 rax, [r8]
load8 r10, [r8 + 1]
load8 r11, [r8 + 2]
lea r12, [rip + byte_vector]
jmp store_exhaustive
prepare_hex:
lea r8, [rip + hex_input]
store8 [r8 + 9], rdx
lea r8, [rip + hex_expected]
imul r9, rdx, 4
add r8, r9
load8 rax, [r8]
load8 r10, [r8 + 1]
load8 r11, [r8 + 2]
load8 r9, [r8 + 3]
lea r12, [rip + hex_vector]
store64 [r12 + 40], r9
store_exhaustive:
store64 [r12 + 16], rax
store64 [r12 + 24], r10
store64 [r12 + 32], r11
mov r13, 1
jmp test_next
all_passed:
lea rdx, [rip + pass_msg]
jmp emit
failed:
lea rdx, [rip + fail_msg]
emit:
load64 rcx, [rbx + 0x40]
load64 rax, [rcx + 8]
call rax
add rsp, 32
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
mov rax, 0
ret

; RCX=ligne sans EOL, RDX=taille lisible, R8=tampon de 16 records de 16 octets.
; RAX=records complets, R10=0/100/101/102, R11=index faute, R9=debut token fautif.
; Tous les offsets sont locaux a la ligne; aucune valeur du source n'est reecrite.
native_lex_line:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 32
mov rsi, rcx
mov rdi, rdx
mov r12, r8
mov r13, 0
mov r14, 0
mov r15, 0
; Gate physique : lire seulement les octets declares, y compris ceux des commentaires.
nl_physical:
cmp r13, rdi
jae nl_physical_done
cmp r13, 255
jae nl_physical_limit
load8 rax, [rsi + r13 * 1]
cmp rax, 9
je nl_physical_next
cmp rax, 32
jb nl_physical_bad
cmp rax, 127
jae nl_physical_bad
nl_physical_next:
add r13, 1
jmp nl_physical
nl_physical_done:
mov r13, 0
nl_next:
cmp r13, rdi
jae nl_ok
load8 rax, [rsi + r13 * 1]
cmp rax, 32
je nl_space
cmp rax, 9
je nl_space
cmp rax, 59
je nl_ok
mov r15, r13
cmp r14, 16
jae nl_limit
cmp rax, 34
je nl_string_start
mov rbx, 0
cmp rax, 46
je nl_section
cmp rax, 48
jb nl_first_letter
cmp rax, 58
jb nl_word
nl_first_letter:
cmp rax, 95
je nl_identifier
or rax, 32
cmp rax, 97
jb nl_punctuation
cmp rax, 123
jae nl_punctuation
nl_identifier:
mov rbx, 1
jmp nl_word
nl_section:
add r13, 1
jmp nl_word
nl_punctuation:
add r13, 1
jmp nl_record
nl_space:
add r13, 1
jmp nl_next
; Un entier reste un candidat lexical; native_parse_u64 verifiera ses chiffres.
nl_word:
cmp r13, rdi
jae nl_record
load8 rax, [rsi + r13 * 1]
cmp rax, 95
je nl_word_char
cmp rax, 48
jb nl_word_letter
cmp rax, 58
jb nl_word_char
nl_word_letter:
or rax, 32
cmp rax, 97
jb nl_record
cmp rax, 123
jae nl_record
nl_word_char:
cmp rbx, 1
jne nl_word_advance
mov rax, r13
sub rax, r15
cmp rax, 31
jae nl_limit
nl_word_advance:
add r13, 1
jmp nl_word
nl_string_start:
add r13, 1
nl_string:
cmp r13, rdi
jae nl_escape_bad
load8 rax, [rsi + r13 * 1]
cmp rax, 34
je nl_string_closed
cmp rax, 32
jb nl_escape_bad
cmp rax, 92
jne nl_string_advance
add r13, 1
cmp r13, rdi
jae nl_escape_bad
load8 rax, [rsi + r13 * 1]
cmp rax, 92
je nl_string_advance
cmp rax, 34
je nl_string_advance
cmp rax, 114
je nl_string_advance
cmp rax, 110
je nl_string_advance
cmp rax, 116
je nl_string_advance
cmp rax, 48
je nl_string_advance
cmp rax, 120
jne nl_escape_bad
add r13, 1
cmp r13, rdi
jae nl_escape_bad
load8 rax, [rsi + r13 * 1]
call nl_hex_digit
cmp rax, -1
je nl_escape_bad
add r13, 1
cmp r13, rdi
jae nl_escape_bad
load8 rax, [rsi + r13 * 1]
call nl_hex_digit
cmp rax, -1
je nl_escape_bad
nl_string_advance:
add r13, 1
jmp nl_string
nl_string_closed:
add r13, 1
nl_record:
; Publier apres validation : aucun record partiel ni octet au-dela des 256.
store64 [r12], r15
mov rax, r13
sub rax, r15
store64 [r12 + 8], rax
add r12, 16
add r14, 1
jmp nl_next
nl_ok:
mov r10, 0
mov r11, 0
mov r9, 0
jmp nl_return
nl_physical_bad:
mov r15, r13
mov r10, 100
jmp nl_error
nl_physical_limit:
mov r15, r13
nl_limit:
mov r10, 101
jmp nl_error
nl_escape_bad:
mov r10, 102
nl_error:
mov r11, r13
mov r9, r15
nl_return:
mov rax, r14
add rsp, 32
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret

; RAX=octet ASCII; RAX=chiffre 0..15 ou -1, RCX volatile.
nl_hex_digit:
mov rcx, rax
sub rax, 48
cmp rax, 10
jb nl_hex_return
mov rax, rcx
or rax, 32
sub rax, 97
cmp rax, 6
jae nl_hex_bad
add rax, 10
nl_hex_return:
ret
nl_hex_bad:
mov rax, -1
ret

section .rdata r
pass_msg:
utf16z "NG_NTASM_NATIVE_LEX_OK\r\n"
fail_msg:
utf16z "NG_NTASM_NATIVE_LEX_BAD\r\n"
