module return_types;import ntasm_ast;
fn same(source:buf<u8>,a:ntasm_ast.Node,b:ntasm_ast.Node)->bool{if a.start>a.end||b.start>b.end||a.end>len(source)||b.end>len(source)||(a.end-a.start)!=(b.end-b.start){return false;}let mut i:u64=0;while i<(a.end-a.start){if source[a.start+i]!=source[b.start+i]{return false;}i=i+1;}return true;}
fn word(source:buf<u8>,node:ntasm_ast.Node,text:buf<u8>)->bool{if node.start>node.end||node.end>len(source)||(node.end-node.start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[node.start+i]!=text[i]{return false;}i=i+1;}return true;}
fn child(tree:ntasm_ast.Tree,parent:u64,ordinal:u64)->u64{if parent==0||parent>tree.node_count{return 0;}let p:ntasm_ast.Node=ntasm_ast.node_at(tree,parent);let mut id:u64=p.first_child;let mut index:u64=0;while id!=0&&index<ordinal{if id>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);id=n.next_sibling;index=index+1;}if id>tree.node_count{return 0;}return id;}
fn return_type_id(tree:ntasm_ast.Tree,decl_id:u64)->u64{let d:ntasm_ast.Node=ntasm_ast.node_at(tree,decl_id);let mut id:u64=d.first_child;while id!=0{if id>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if n.kind==36{return id;}id=n.next_sibling;}return 0;}
fn simple_name_id(tree:ntasm_ast.Tree,expr_id:u64)->u64{if expr_id==0||expr_id>tree.node_count{return 0;}let e:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if e.kind!=35||e.aux!=0||e.first_child==0||e.first_child!=e.last_child||e.first_child>tree.node_count{return 0;}let q:ntasm_ast.Node=ntasm_ast.node_at(tree,e.first_child);if q.kind!=91||q.last_child==0||q.last_child>tree.node_count{return 0;}return q.last_child;}
fn decl_name_id(tree:ntasm_ast.Tree,id:u64)->u64{let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if n.kind==18{return child(tree,id,0);}if n.kind==9{return child(tree,id,1);}return 0;}
fn named_type(source:buf<u8>,tree:ntasm_ast.Tree,fn_id:u64,name:ntasm_ast.Node,before:u64)->u64{let fn_:ntasm_ast.Node=ntasm_ast.node_at(tree,fn_id);let mut best:u64=0;let mut id:u64=1;while id<=tree.node_count{let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if n.start<before&&fn_.start<=n.start&&n.end<=fn_.end&&(n.kind==19||n.kind==27){let name_id:u64=child(tree,id,0);let type_id:u64=child(tree,id,1);if name_id!=0&&type_id!=0{let candidate:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);if same(source,candidate,name){best=type_id;}}}id=id+1;}return best;}
fn call_type(source:buf<u8>,tree:ntasm_ast.Tree,expr_id:u64)->u64{let e:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if e.kind!=35||e.aux!=1||e.first_child==0||e.first_child>tree.node_count{return 0;}let q:ntasm_ast.Node=ntasm_ast.node_at(tree,e.first_child);if q.kind!=91||q.last_child==0||q.last_child>tree.node_count{return 0;}let called:ntasm_ast.Node=ntasm_ast.node_at(tree,q.last_child);let mut id:u64=1;while id<=tree.node_count{let d:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if d.kind==18||d.kind==9{let name_id:u64=decl_name_id(tree,id);if name_id!=0{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);if same(source,name,called){return return_type_id(tree,id);}}}id=id+1;}return 0;}
fn literal_ok(source:buf<u8>,expected:ntasm_ast.Node,literal:ntasm_ast.Node)->u64{let truth:buf<u8>="true";let false_:buf<u8>="false";let is_bool:bool=word(source,literal,truth)||word(source,literal,false_);let bool_:buf<u8>="bool";if word(source,expected,bool_){if is_bool{return 1;}return 0;}if is_bool{return 0;}let value:u64=literal.aux;let u8_:buf<u8>="u8";if word(source,expected,u8_){if value<=255{return 1;}return 2;}let i8_:buf<u8>="i8";if word(source,expected,i8_){if value<=127{return 1;}return 2;}let u16_:buf<u8>="u16";if word(source,expected,u16_){if value<=65535{return 1;}return 2;}let i16_:buf<u8>="i16";if word(source,expected,i16_){if value<=32767{return 1;}return 2;}let u32_:buf<u8>="u32";if word(source,expected,u32_){if value<=4294967295{return 1;}return 2;}let i32_:buf<u8>="i32";if word(source,expected,i32_){if value<=2147483647{return 1;}return 2;}let u64_:buf<u8>="u64";if word(source,expected,u64_){return 1;}let i64_:buf<u8>="i64";if word(source,expected,i64_){if value<=9223372036854775807{return 1;}return 2;}return 0;}
// Check return expressions against declared function types. Supported proofs:
// literals, parameter/local names and call results. 352 type mismatch;353
// reason1 literal range,2 unsupported expression. Success functions,returns,
// checked returns,0.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let mut functions:u64=0;let mut returns:u64=0;let mut checked:u64=0;let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut reason:u64=0;let mut fn_id:u64=1;while fn_id<=tree.node_count&&code==0{let fn_:ntasm_ast.Node=ntasm_ast.node_at(tree,fn_id);if fn_.kind==18{functions=functions+1;let expected_id:u64=return_type_id(tree,fn_id);if expected_id==0{code=800;}else{let expected:ntasm_ast.Node=ntasm_ast.node_at(tree,expected_id);let mut id:u64=1;while id<=tree.node_count&&code==0{let ret:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if ret.kind==29&&fn_.start<=ret.start&&ret.end<=fn_.end{returns=returns+1;let expr_id:u64=ret.first_child;if expr_id==0{code=800;}else{let expr:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if expr.kind==94{let status:u64=literal_ok(source,expected,expr);if status==0{code=352;}else if status==2{code=353;reason=1;}else{checked=checked+1;}}else{let bool_word:buf<u8>="bool";let true_word:buf<u8>="true";let false_word:buf<u8>="false";if word(source,expected,bool_word)&&(word(source,expr,true_word)||word(source,expr,false_word)){checked=checked+1;}else{let name_id:u64=simple_name_id(tree,expr_id);let mut actual_id:u64=0;if name_id!=0{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);actual_id=named_type(source,tree,fn_id,name,ret.start);}else if expr.kind==35&&expr.aux==1{actual_id=call_type(source,tree,expr_id);}if actual_id==0{code=353;reason=2;}else{let actual:ntasm_ast.Node=ntasm_ast.node_at(tree,actual_id);if same(source,expected,actual){checked=checked+1;}else{code=352;}}}}if code!=0{line=ret.line;column=ret.column;}}}id=id+1;}}}fn_id=fn_id+1;}if code==0{out[0]=functions;out[1]=returns;out[2]=checked;out[3]=0;}else if code==352{out[0]=line;out[1]=column;out[2]=0;out[3]=0;}else if code==353{out[0]=line;out[1]=column;out[2]=reason;out[3]=0;}return code;}
