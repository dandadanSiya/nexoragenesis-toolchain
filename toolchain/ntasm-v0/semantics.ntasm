mov rax, 1
cmp rdx, 2
je vas_save_direction
mov rax, 2
cmp rdx, 3
je vas_save_direction
mov rax, 3
cmp rdx, 5
jne vas_shape
vas_save_direction:
store64 [rsp + 72], rax
vas_type_advance:
add rsi, 1
jmp vas_type_next
vas_type_done:
load64 rax, [rsp + 40]
cmp rax, 0
je vas_bad_width
load64 rax, [rsp + 72]
cmp rax, 0
je vas_shape
mov rsi, 0
vas_reg_next:
cmp rsi, r15
jae vas_scope
mov rdi, rsi
shl rdi, 6
add rdi, r14
load64 rax, [rdi + 32]
cmp rax, rbx
jne vas_reg_advance
load64 rax, [rdi + 56]
cmp rax, 1
jne vas_reg_advance
load64 rcx, [rdi + 16]
load64 rax, [rsp + 48]
cmp rcx, rax
jb vas_reg_advance
load64 rdx, [rdi + 24]
call source_trim_span
call resolve_gpr
cmp rax, 0
jne vas_return
lea rcx, [rip + resolved_binding]
load64 rax, [rsp + 88]
imul rax, rax, 40
add rcx, rax
load64 rax, [rsp + 40]
store64 [rcx], rax
store64 [rcx + 8], r8
store64 [rcx + 16], rdx
load64 rax, [rsp + 72]
store64 [rcx + 24], rax
load64 rax, [rdi + 16]
store64 [rcx + 32], rax
load64 rax, [rsp + 56]
load64 rdx, [rsp + 88]
lea r8, [rip + resolved_type_ids]
store64 [r8 + rdx * 8], rax
load64 rdx, [rsp + 88]
add rdx, 1
store64 [rsp + 88], rdx
lea rcx, [rip + resolved_binding]
call check_bindings
cmp rax, 0
jne vas_return
load64 rax, [rsp + 80]
add rax, 1
store64 [rsp + 80], rax
jmp vas_parameter_next
vas_reg_advance:
add rsi, 1
jmp vas_reg_next
vas_bad_width:
mov rax, 501
jmp vas_return
vas_shape:
mov rax, 508
jmp vas_return
vas_scope:
; Liaison explicite requise dans cette phase, aucune allocation implicite.
mov rax, 507
jmp vas_return
vas_capacity:
mov rax, 505
jmp vas_return
vas_duplicate_name:
mov rax, 518
jmp vas_return
vas_success:
mov rax, 0
vas_return:
add rsp, 112
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret
; Premier IDENT direct du parametre : son nom, pas le registre apres @.
validate_target:
sub rsp, 40
lea rax, [rip + module_target]
mov rdx, 0
store64 [rax], rdx
mov rcx, 0
lea rdx, [rip + name_dashed]
mov r8, 6
call count_named_children
cmp rax, 1
jne vt_bad
cmp rdx, r15
jae vt_bad
shl rdx, 6
add rdx, r14
load64 rcx, [rdx + 16]
load64 rdx, [rdx + 24]
cmp rdx, rcx
jb vt_bad
cmp r13, rdx
jb vt_bad
call source_trim_span
lea r8, [rip + target_none]
lea r9, [rip + target_none_end]
sub r9, r8
call equal_name_spans
cmp rax, 1
je vt_none
lea r8, [rip + target_uefi]
lea r9, [rip + target_uefi_end]
sub r9, r8
call equal_name_spans
cmp rax, 1
jne vt_bad
mov rax, 2
jmp vt_store
vt_none:
mov rax, 1
vt_store:
lea rcx, [rip + module_target]
store64 [rcx], rax
mov rax, 0
jmp vt_return
vt_bad:
mov rax, 520
vt_return:
add rsp, 40
ret
parameter_name_span:
shl rcx, 6
add rcx, r14
load64 r9, [rcx + 40]
pns_next:
cmp r9, r15
jae pns_bad
mov r8, r9
shl r8, 6
add r8, r14
load64 rax, [r8 + 56]
cmp rax, 1
je pns_found
load64 r9, [r8 + 48]
jmp pns_next
pns_found:
load64 rax, [r8 + 16]
load64 rdx, [r8 + 24]
sub rdx, rax
add rax, r12
ret
pns_bad:
mov rax, 0
mov rdx, 0
ret
equal_name_spans:
cmp rdx, r9
jne ens_no
mov rax, 0
ens_next:
cmp rax, rdx
jae ens_yes
load8 r10, [rcx + rax * 1]
load8 r11, [r8 + rax * 1]
cmp r10, r11
jne ens_no
add rax, 1
jmp ens_next
ens_yes:
mov rax, 1
ret
ens_no:
mov rax, 0
ret
; Type AST -> identite canonique privee. Un pointeur conserve espace et type pointe.
resolve_ast_type:
push rbx
push rsi
push rdi
sub rsp, 64
mov rbx, rcx
lea rax, [rip + type_depth]
load64 rdx, [rax]
cmp rdx, 32
jae rat_depth_bad
add rdx, 1
store64 [rax], rdx
mov rdi, rbx
shl rdi, 6
add rdi, r14
load64 rcx, [rdi + 16]
load64 rdx, [rdi + 24]
call source_trim_span
call resolve_scalar_type
cmp rax, 0
je rat_return
mov rcx, rbx
lea rdx, [rip + name_pointer]
mov r8, 7
call count_named_children
cmp rax, 1
jne rat_unknown
mov rsi, rdx
mov rcx, rsi
lea rdx, [rip + name_address_space]
mov r8, 13
call count_named_children
cmp rax, 1
jne rat_unknown
shl rdx, 6
add rdx, r14
load64 rcx, [rdx + 16]
load64 rdx, [rdx + 24]
call source_trim_span
lea r8, [rip + address_spaces]
call rt_next
cmp rax, 0
jne rat_return
store64 [rsp + 32], rdx
mov rcx, rsi
lea rdx, [rip + name_type]
mov r8, 4
call count_named_children
cmp rax, 1
jne rat_unknown
mov rcx, rdx
call resolve_ast_type
cmp rax, 0
jne rat_return
store64 [rsp + 40], rdx
lea r8, [rip + type_count]
load64 r9, [r8]
lea r10, [rip + composite_types]
mov r11, 0
rat_intern:
cmp r11, r9
jae rat_insert
load64 rax, [r10]
load64 rdx, [rsp + 32]
cmp rax, rdx
jne rat_other
load64 rax, [r10 + 8]
load64 rdx, [rsp + 40]
cmp rax, rdx
je rat_found
rat_other:
add r11, 1
add r10, 32
jmp rat_intern
rat_insert:
cmp r9, 32
jae rat_capacity
load64 rax, [rsp + 32]
store64 [r10], rax
load64 rax, [rsp + 40]
store64 [r10 + 8], rax
mov rax, 1
store64 [r10 + 16], rax
mov rax, 0
store64 [r10 + 24], rax
add r9, 1
store64 [r8], r9
rat_found:
lea rdx, [r11 + 16]
mov r8, 64
mov rax, 0
jmp rat_return
rat_unknown:
mov rax, 506
jmp rat_return
rat_capacity:
mov rax, 505
rat_return:
lea r10, [rip + type_depth]
load64 r11, [r10]
sub r11, 1
store64 [r10], r11
jmp rat_restore
rat_depth_bad:
mov rax, 505
rat_restore:
add rsp, 64
pop rdi
pop rsi
pop rbx
ret
ast_name_equals:
load64 rax, [rcx + 8]
cmp rax, r8
jne ane_no
load64 r9, [rcx]
cmp r9, 0
je ane_no
load64 rax, [rbp]
cmp r9, rax
jb ane_no
load64 r10, [rbp + 8]
add rax, r10
lea r11, [r9 + r8 * 1]
cmp r11, r9
jb ane_no
cmp rax, r11
jb ane_no
mov r10, 0
ane_loop:
cmp r10, r8
jae ane_yes
load8 rax, [r9 + r10 * 1]
load8 r11, [rdx + r10 * 1]
cmp rax, r11
jne ane_no
add r10, 1
jmp ane_loop
ane_yes:
mov rax, 1
ret
ane_no:
mov rax, 0
ret
source_trim_span:
; Bornes des nodes deja verifiees. Les espaces appartiennent parfois au node.
sts_start:
cmp rcx, rdx
jae sts_done
load8 rax, [r12 + rcx * 1]
cmp rax, 32
je sts_skip
cmp rax, 9
je sts_skip
cmp rax, 10
je sts_skip
cmp rax, 13
jne sts_end
sts_skip:
add rcx, 1
jmp sts_start
sts_end:
cmp rcx, rdx
jae sts_done
lea r10, [rdx - 1]
load8 rax, [r12 + r10 * 1]
cmp rax, 32
je sts_back
cmp rax, 9
je sts_back
cmp rax, 10
je sts_back
cmp rax, 13
jne sts_done
sts_back:
sub rdx, 1
jmp sts_end
sts_done:
sub rdx, rcx
add rcx, r12
ret
check_bindings:
; Table bornee fournie par le resolver; aucune ecriture dans les entrees.
cmp rdx, 65
jae cb_capacity
mov r8, rcx
mov r9, rdx
mov r10, 0
cb_next:
cmp r10, r9
jae cb_ok
load64 rax, [rcx]
cmp rax, 8
je cb_width
cmp rax, 16
je cb_width
cmp rax, 32
je cb_width
cmp rax, 64
jne cb_bad_width
cb_width:
load64 rdx, [rcx + 8]
cmp rax, rdx
jne cb_bad_width
load64 r11, [rcx + 16]
cmp r11, 16
jae cb_bad_register
load64 rax, [rcx + 24]
cmp rax, 1
jb cb_bad_direction
cmp rax, 4
jae cb_bad_direction
; Les alias partagent le meme numero de registre physique, quelle que soit largeur.
mov rdx, 0
cb_prior:
cmp rdx, r10
jae cb_advance
mov rax, rdx
imul rax, rax, 40
add rax, r8
load64 rax, [rax + 16]
cmp rax, r11
je cb_alias
add rdx, 1
jmp cb_prior
cb_advance:
add rcx, 40
add r10, 1
jmp cb_next
cb_ok:
mov rax, 0
mov rdx, -1
ret
cb_bad_width:
mov rax, 501
jmp cb_error
cb_bad_register:
mov rax, 502
jmp cb_error
cb_bad_direction:
mov rax, 503
jmp cb_error
cb_alias:
mov rax, 504
cb_error:
mov rdx, r10
ret
cb_capacity:
mov rax, 505
mov rdx, -1
ret
; Span de nom de type -> code, identite canonique, largeur machine.
resolve_scalar_type:
lea r8, [rip + scalar_types]
rt_next:
load64 rax, [r8 + 8]
cmp rax, 0
je rt_unknown
cmp rax, rdx
jne rt_other
load64 r9, [r8]
mov r10, 0
rt_char:
cmp r10, rdx
jae rt_found
load8 rax, [rcx + r10 * 1]
load8 r11, [r9 + r10 * 1]
cmp rax, r11
jne rt_other
add r10, 1
jmp rt_char
rt_other:
add r8, 32
jmp rt_next
rt_found:
load64 rdx, [r8 + 16]
load64 r8, [r8 + 24]
mov rax, 0
ret
rt_unknown:
load64 rax, [r8 + 16]
mov rdx, 0
mov r8, 0
ret
resolve_gpr:
lea r8, [rip + gpr_names]
jmp rt_next
native_parse_u64:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 32
mov rsi, rcx
mov rdi, rdx
mov r12, 0
mov r15, 0
cmp rdi, 0
je np_bad
load8 rax, [rsi]
cmp rax, 48
jne np_decimal
cmp rdi, 1
je np_ok
mov r15, 1
load8 rax, [rsi + 1]
cmp rax, 120
jne np_bad
mov r15, 2
cmp r15, rdi
jae np_bad
mov rbx, 16
mov r13, r8
shr r13, 4
mov r14, r8
and r14, 15
jmp np_digit
np_decimal:
mov rbx, 10
mov r13, 0
mov r14, 0
mov r9, 64
; Division binaire par 10 (pas de DIV S0).
; Reste <=19; jamais de shift 64.
np_divide:
mov rax, r8
shr rax, 63
shl r8, 1
shl r13, 1
shl r14, 1
or r14, rax
cmp r14, 10
jb np_divide_next
sub r14, 10
or r13, 1
np_divide_next:
sub r9, 1
jne np_divide
np_digit:
cmp r15, rdi
jae np_ok
load8 rax, [rsi + r15 * 1]
; Separateurs deja valides par le lexer v0; ne changent pas la valeur.
cmp rax, 95
jne np_real_digit
add r15, 1
jmp np_digit
np_real_digit:
cmp rbx, 16
je np_hex
sub rax, 48
cmp rax, 10
jae np_bad
jmp np_bound
np_hex:
mov rcx, rax
sub rax, 48
cmp rax, 10
jb np_bound
mov rax, rcx
or rax, 32
sub rax, 97
cmp rax, 6
jae np_bad
add rax, 10
np_bound:
; Verifier borne/base avant multiplication.
cmp r12, r13
jb np_accumulate
cmp r12, r13
jne np_bad
cmp r14, rax
jb np_bad
np_accumulate:
cmp rbx, 16
je np_accumulate_hex
imul r12, r12, 10
jmp np_accumulate_digit
np_accumulate_hex:
shl r12, 4
np_accumulate_digit:
add r12, rax
add r15, 1
jmp np_digit
np_ok:
mov rax, r12
mov r10, 0
mov r11, 0
jmp np_return
np_bad:
mov rax, 0
mov r10, 102
mov r11, r15
np_return:
add rsp, 32
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret
