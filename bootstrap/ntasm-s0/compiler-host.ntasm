and rax, 16
je io_free_src
load64 rcx, [rbp + 192]
load64 rax, [r14 + 0x48]
call rax
mov rcx, 604
call io_first_error
io_free_src:
load64 rax, [rbp + 184]
and rax, 2
je io_free_work
load64 rcx, [rbp + 8]
load64 rax, [r14 + 0x48]
call rax
mov rcx, 604
call io_first_error
io_free_work:
