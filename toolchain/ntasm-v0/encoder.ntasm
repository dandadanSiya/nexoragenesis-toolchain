; NX64ENC1 native encoding library. Driver/oracles are in encoder-caller.ntasm.
; LoadImage then call table exports before UnloadImage; no StartImage setup.
format pe64
abi efi_x64
entry library_entry
section .text rx
library_entry:
mov rax, 0
ret
encode_x64:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 64
mov r12, rcx
mov r13, rdx
mov r14, r8
mov r15, r9
mov rax, 0
store64 [rsp + 32], rax
load64 rsi, [r12]
lea rdi, [rip + fixed_forms]
ef_next:
load64 rbx, [rdi]
cmp rbx, 0
je rr_begin
mov rcx, 0
ef_name:
cmp rcx, 31
jae ef_unknown
load8 rax, [rsi + rcx * 1]
load8 rdx, [rbx + rcx * 1]
cmp rax, rdx
jne ef_other
cmp rax, 0
je ef_found
add rcx, 1
jmp ef_name
ef_other:
add rdi, 40
jmp ef_next
ef_found:
load64 rax, [r12 + 8]
cmp rax, 0
jne ef_count
load64 rax, [rdi + 24]
mov rcx, rax
and rcx, r14
cmp rcx, rax
jne ef_feature
cmp r15, 4
jae ef_privilege
load64 rax, [rdi + 32]
cmp r15, rax
jb ef_emit
je ef_emit
jmp ef_privilege
ef_emit:
load64 rdx, [rdi + 8]
load64 rax, [rdi + 16]
mov rcx, 0
ef_byte:
cmp rcx, rdx
jae ef_success
store8 [r13 + rcx * 1], rax
shr rax, 8
add rcx, 1
jmp ef_byte
ef_success:
mov rax, 0
jmp ef_return
ef_unknown:
mov rax, 401
jmp ef_error
ef_width:
mov rax, 403
jmp ef_error
ef_register:
mov rax, 406
jmp ef_error
ef_form:
mov rax, 409
jmp ef_error
ef_range:
mov rax, 407
jmp ef_error
ef_space:
mov rax, 410
jmp ef_error
ef_address:
mov rax, 411
jmp ef_error
ef_count:
mov rax, 402
jmp ef_error
ef_feature:
mov rax, 404
jmp ef_error
ef_privilege:
mov rax, 405
ef_error:
mov rdx, 0
ef_return:
add rsp, 64
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret

rr_begin:
lea rdi, [rip + rr_forms]
rr_next:
load64 rbx, [rdi]
cmp rbx, 0
je unary_begin
mov rcx, 0
rr_name:
cmp rcx, 31
jae ef_unknown
load8 rax, [rsi + rcx * 1]
load8 rdx, [rbx + rcx * 1]
cmp rax, rdx
jne rr_other
cmp rax, 0
je rr_found
add rcx, 1
jmp rr_name
rr_other:
add rdi, 16
jmp rr_next
rr_found:
load64 rax, [r12 + 8]
cmp rax, 2
jne ef_count
load64 rax, [r12 + 16]
cmp rax, 3
je alu_mem_destination
cmp rax, 1
jne ef_form
load64 rax, [r12 + 40]
cmp rax, 3
je alu_mem_source
cmp rax, 2
je ri_begin
cmp rax, 1
jne ef_form
load64 rbx, [r12 + 24]
load64 rax, [r12 + 48]
cmp rax, rbx
jne ef_width
cmp rbx, 8
je rr_width_ok
cmp rbx, 16
je rr_width_ok
cmp rbx, 32
je rr_width_ok
cmp rbx, 64
jne ef_width
rr_width_ok:
load64 r8, [r12 + 32]
load64 r9, [r12 + 56]
mov rcx, r8
mov rdx, rbx
call normalize_gpr
cmp rax, -1
je ef_register
mov r8, rax
mov rcx, r9
mov rdx, rbx
call normalize_gpr
cmp rax, -1
je ef_register
mov r9, rax
mov rax, r14
and rax, 1
cmp rax, 0
je ef_feature
cmp r15, 4
jae ef_privilege
load64 r15, [rdi + 8]
mov r10, 0
cmp rbx, 16
jne rr_rex
mov rax, 0x66
store8 [rsp + r10 * 1], rax
add r10, 1
rr_rex:
mov r11, 0x40
cmp rbx, 64
jne rr_extension
or r11, 8
rr_extension:
cmp r8, 0x100
jae rr_src_extension
cmp r8, 8
jb rr_src_extension
or r11, 1
rr_src_extension:
cmp r9, 0x100
jae rr_need_rex
cmp r9, 8
jb rr_need_rex
or r11, 4
rr_need_rex:
cmp r8, 0x100
jae rr_high8
cmp r9, 0x100
jae rr_high8
cmp r11, 0x40
jne rr_emit_rex
cmp rbx, 8
jne rr_opcode
cmp r8, 4
jae rr_emit_rex
cmp r9, 4
jb rr_opcode
jmp rr_emit_rex
rr_high8:
cmp r11, 0x40
jne ef_register
cmp r8, 0x100
jae rr_high8_src
cmp r8, 4
jae ef_register
rr_high8_src:
cmp r9, 0x100
jae rr_opcode
cmp r9, 4
jae ef_register
jmp rr_opcode
rr_emit_rex:
store8 [rsp + r10 * 1], r11
add r10, 1
rr_opcode:
cmp rbx, 8
jne rr_opcode_wide
sub r15, 1
rr_opcode_wide:
store8 [rsp + r10 * 1], r15
add r10, 1
mov rax, r9
and rax, 7
shl rax, 3
mov rcx, r8
and rcx, 7
or rax, rcx
or rax, 0xC0
store8 [rsp + r10 * 1], rax
add r10, 1
mov rdx, r10
mov rcx, 0
rr_commit:
cmp rcx, rdx
jae ef_success
load8 rax, [rsp + rcx * 1]
store8 [r13 + rcx * 1], rax
add rcx, 1
jmp rr_commit

alu_mem_source:
load64 rax, [rdi + 8]
cmp rax, 0x89
je ef_form
store64 [rsp + 16], r15
mov r15, rax
cmp rax, 0x85
je alu_mem_read_ready
cmp rax, 0x87
je alu_mem_read_ready
add r15, 2
alu_mem_read_ready:
load64 r8, [r12 + 32]
jmp alu_mem_width
alu_mem_destination:
load64 rcx, [rdi + 8]
cmp rcx, 0x89
je ef_form
cmp rcx, 0x87
je ef_form
load64 rax, [r12 + 40]
cmp rax, 2
je alu_mem_immediate
cmp rax, 1
jne ef_form
store64 [rsp + 16], r15
mov r15, rcx
load64 r8, [r12 + 56]
alu_mem_width:
load64 rbx, [r12 + 24]
load64 rax, [r12 + 48]
cmp rax, rbx
jne ef_width
cmp rbx, 8
je mem_register
cmp rbx, 16
je mem_register
cmp rbx, 32
je mem_register
cmp rbx, 64
jne ef_width
jmp mem_register
alu_mem_immediate:
store64 [rsp + 16], r15
call prepare_mem_immediate
cmp rax, 0
jne ef_error
jmp mem_group_entry

ri_begin:
load64 rax, [rdi + 8]
cmp rax, 0x87
je ef_form
load64 rbx, [r12 + 24]
load64 rax, [r12 + 48]
cmp rax, rbx
jne ef_width
cmp rbx, 8
je ri_width_ok
cmp rbx, 16
je ri_width_ok
cmp rbx, 32
je ri_width_ok
cmp rbx, 64
jne ef_width
ri_width_ok:
load64 r8, [r12 + 32]
mov rcx, r8
mov rdx, rbx
call normalize_gpr
cmp rax, -1
je ef_register
mov r8, rax
load64 r9, [r12 + 56]
cmp rbx, 64
je ri_value_ok
cmp rbx, 32
je ri_check32
cmp rbx, 16
je ri_check16
cmp r9, 256
jae ef_range
jmp ri_value_ok
ri_check16:
cmp r9, 65536
jae ef_range
jmp ri_value_ok
ri_check32:
mov rax, 0x100000000
cmp r9, rax
jae ef_range
ri_value_ok:
mov rax, r14
and rax, 1
cmp rax, 0
je ef_feature
cmp r15, 4
jae ef_privilege
load64 r15, [rdi + 8]
mov rdi, rbx
shr rdi, 3
mov rax, 0
store64 [rsp + 24], rax
cmp r15, 0x89
je ri_mov_opcode
mov rax, 1
store64 [rsp + 24], rax
cmp rbx, 64
jne ri_arith_range
mov rdi, 4
mov rax, 0x7FFFFFFF
cmp r9, rax
jb ri_arith_range
je ri_arith_range
mov rax, 0xFFFFFFFF80000000
cmp r9, rax
jb ef_range
ri_arith_range:
cmp r15, 0x85
je ri_test_opcode
mov rsi, r15
shr rsi, 3
and rsi, 7
shl rsi, 3
or rsi, 0xC0
mov r15, 0x81
cmp rbx, 8
je ri_byte_opcode
cmp r9, 128
jb ri_compact
mov rax, 0xFFFFFFFFFFFFFF80
cmp rbx, 64
je ri_compact_compare
mov rax, 0xFFFFFF80
cmp rbx, 32
je ri_compact_compare
mov rax, 0xFF80
ri_compact_compare:
cmp r9, rax
jb ri_arith_modrm
ri_compact:
mov r15, 0x83
mov rdi, 1
jmp ri_arith_modrm
ri_byte_opcode:
mov r15, 0x80
jmp ri_arith_modrm
ri_test_opcode:
mov rsi, 0xC0
mov r15, 0xF7
cmp rbx, 8
jne ri_arith_modrm
mov r15, 0xF6
ri_arith_modrm:
mov rax, r8
and rax, 7
or rsi, rax
jmp ri_prefix
ri_mov_opcode:
mov r15, 0xB8
cmp rbx, 8
jne ri_mov_reg
mov r15, 0xB0
ri_mov_reg:
mov rax, r8
and rax, 7
add r15, rax
ri_prefix:
mov r10, 0
cmp rbx, 16
jne ri_rex
mov rax, 0x66
store8 [rsp], rax
add r10, 1
ri_rex:
mov r11, 0x40
cmp rbx, 64
jne ri_ext
or r11, 8
ri_ext:
cmp r8, 0x100
jae ri_need_rex
cmp r8, 8
jb ri_need_rex
or r11, 1
ri_need_rex:
cmp r8, 0x100
jb ri_normal_rex
cmp r11, 0x40
jne ef_register
jmp ri_emit_opcode
ri_normal_rex:
cmp r11, 0x40
jne ri_emit_rex
cmp rbx, 8
jne ri_emit_opcode
cmp r8, 4
jb ri_emit_opcode
ri_emit_rex:
store8 [rsp + r10 * 1], r11
add r10, 1
ri_emit_opcode:
store8 [rsp + r10 * 1], r15
add r10, 1
load64 rax, [rsp + 24]
cmp rax, 0
je ri_immediate
store8 [rsp + r10 * 1], rsi
add r10, 1
ri_immediate:
cmp rdi, 0
je ri_commit
store8 [rsp + r10 * 1], r9
add r10, 1
shr r9, 8
sub rdi, 1
jmp ri_immediate
ri_commit:
mov rdx, r10
mov rcx, 0
jmp rr_commit

unary_begin:
lea rdi, [rip + unary_forms]
un_next:
load64 rbx, [rdi]
cmp rbx, 0
je shift_begin
mov rcx, 0
un_name:
cmp rcx, 31
jae ef_unknown
load8 rax, [rsi + rcx * 1]
load8 rdx, [rbx + rcx * 1]
cmp rax, rdx
jne un_other
cmp rax, 0
je un_found
add rcx, 1
jmp un_name
un_other:
add rdi, 32
jmp un_next
un_found:
load64 rax, [r12 + 8]
cmp rax, 1
jne ef_count
load64 rax, [r12 + 16]
cmp rax, 1
jne ef_form
load64 rbx, [r12 + 24]
load64 r10, [rdi + 24]
cmp r10, 0
je un_general_width
cmp r10, 3
je un_bswap_width
cmp rbx, 64
jne ef_width
jmp un_reg
un_bswap_width:
cmp rbx, 32
je un_reg
cmp rbx, 64
jne ef_width
jmp un_reg
un_general_width:
cmp rbx, 8
je un_reg
cmp rbx, 16
je un_reg
cmp rbx, 32
je un_reg
cmp rbx, 64
jne ef_width
un_reg:
load64 r8, [r12 + 32]
mov rcx, r8
mov rdx, rbx
call normalize_gpr
cmp rax, -1
je ef_register
mov r8, rax
call cc_feature_check
cmp rax, 0
jne ef_error
mov rsi, r10
load64 r15, [rdi + 8]
load64 r9, [rdi + 16]
mov r10, 0
cmp rbx, 16
jne un_rex
mov rax, 0x66
store8 [rsp], rax
add r10, 1
un_rex:
mov r11, 0x40
cmp rbx, 64
jne un_ext
cmp rsi, 1
je un_ext
cmp rsi, 2
je un_ext
or r11, 8
un_ext:
cmp r8, 0x100
jae un_need_rex
cmp r8, 8
jb un_need_rex
or r11, 1
un_need_rex:
cmp r8, 0x100
jb un_normal_rex
cmp r11, 0x40
jne ef_register
jmp un_opcode
un_normal_rex:
cmp r11, 0x40
jne un_emit_rex
cmp rbx, 8
jne un_opcode
cmp r8, 4
jb un_opcode
un_emit_rex:
store8 [rsp + r10 * 1], r11
add r10, 1
un_opcode:
cmp rsi, 3
jne un_select_opcode
mov rax, 0x0F
store8 [rsp + r10 * 1], rax
add r10, 1
un_select_opcode:
cmp rsi, 0
je un_group_opcode
mov rax, r8
and rax, 7
add r15, rax
jmp un_emit_opcode
un_group_opcode:
cmp rbx, 8
jne un_emit_opcode
sub r15, 1
un_emit_opcode:
store8 [rsp + r10 * 1], r15
add r10, 1
cmp rsi, 0
jne un_commit
mov rax, r8
and rax, 7
shl r9, 3
or rax, r9
or rax, 0xC0
store8 [rsp + r10 * 1], rax
add r10, 1
un_commit:
mov rdx, r10
mov rcx, 0
jmp rr_commit

shift_begin:
lea rdi, [rip + shift_forms]
sh_next:
load64 rbx, [rdi]
cmp rbx, 0
je wide_begin
mov rcx, 0
sh_name:
cmp rcx, 31
jae ef_unknown
load8 rax, [rsi + rcx * 1]
load8 rdx, [rbx + rcx * 1]
cmp rax, rdx
jne sh_other
cmp rax, 0
je sh_found
add rcx, 1
jmp sh_name
sh_other:
add rdi, 16
jmp sh_next
sh_found:
load64 rax, [r12 + 8]
cmp rax, 2
jne ef_count
load64 rax, [r12 + 16]
cmp rax, 1
jne ef_form
load64 rbx, [r12 + 24]
cmp rbx, 8
je sh_reg
cmp rbx, 16
je sh_reg
cmp rbx, 32
je sh_reg
cmp rbx, 64
jne ef_width
sh_reg:
load64 r8, [r12 + 32]
mov rcx, r8
mov rdx, rbx
call normalize_gpr
cmp rax, -1
je ef_register
mov r8, rax
load64 rax, [r12 + 48]
cmp rax, 8
jne ef_width
load64 rsi, [r12 + 40]
load64 r9, [r12 + 56]
cmp rsi, 2
je sh_immediate_check
cmp rsi, 1
jne ef_form
cmp r9, 1
jne ef_register
jmp sh_features
sh_immediate_check:
cmp r9, 256
jae ef_range
sh_features:
call cc_feature_check
cmp rax, 0
jne ef_error
mov r15, 0xD3
mov rax, 0
store64 [rsp + 24], rax
cmp rsi, 1
je sh_prefix
mov r15, 0xD1
cmp r9, 1
je sh_prefix
mov r15, 0xC1
mov rax, 1
store64 [rsp + 24], rax
sh_prefix:
mov r10, 0
cmp rbx, 16
jne sh_rex
mov rax, 0x66
store8 [rsp], rax
add r10, 1
sh_rex:
mov r11, 0x40
cmp rbx, 64
jne sh_ext
or r11, 8
sh_ext:
cmp r8, 0x100
jae sh_need_rex
cmp r8, 8
jb sh_need_rex
or r11, 1
sh_need_rex:
cmp r8, 0x100
jb sh_normal_rex
cmp r11, 0x40
jne ef_register
jmp sh_opcode
sh_normal_rex:
cmp r11, 0x40
jne sh_emit_rex
cmp rbx, 8
jne sh_opcode
cmp r8, 4
jb sh_opcode
sh_emit_rex:
store8 [rsp + r10 * 1], r11
add r10, 1
sh_opcode:
cmp rbx, 8
jne sh_opcode_wide
sub r15, 1
sh_opcode_wide:
store8 [rsp + r10 * 1], r15
add r10, 1
load64 rax, [rdi + 8]
shl rax, 3
or rax, 0xC0
mov rcx, r8
and rcx, 7
or rax, rcx
store8 [rsp + r10 * 1], rax
add r10, 1
load64 rax, [rsp + 24]
cmp rax, 0
je sh_commit
store8 [rsp + r10 * 1], r9
add r10, 1
sh_commit:
mov rdx, r10
mov rcx, 0
jmp rr_commit

wide_begin:
lea rdi, [rip + wide_forms]
wi_next:
load64 rbx, [rdi]
cmp rbx, 0
je bit_begin
mov rcx, 0
wi_name:
cmp rcx, 31
jae ef_unknown
load8 rax, [rsi + rcx * 1]
load8 rdx, [rbx + rcx * 1]
cmp rax, rdx
jne wi_other
cmp rax, 0
je wi_found
add rcx, 1
jmp wi_name
wi_other:
add rdi, 24
jmp wi_next
wi_found:
load64 rax, [r12 + 8]
cmp rax, 2
jne ef_count
load64 rax, [r12 + 16]
cmp rax, 1
jne ef_form
load64 rax, [r12 + 40]
cmp rax, 1
jne ef_form
load64 rbx, [r12 + 24]
load64 r10, [r12 + 48]
load64 rsi, [rdi + 16]
cmp rbx, 16
je wi_source_width
cmp rbx, 32
je wi_source_width
cmp rbx, 64
jne ef_width
wi_source_width:
cmp rsi, 0
je wi_equal
cmp rsi, 3
je wi_sxd
cmp r10, 8
je wi_registers
cmp r10, 16
jne ef_width
cmp rbx, 16
je ef_width
jmp wi_registers
wi_equal:
cmp rbx, r10
jne ef_width
jmp wi_registers
wi_sxd:
cmp rbx, 64
jne ef_width
cmp r10, 32
jne ef_width
wi_registers:
load64 r8, [r12 + 32]
load64 r9, [r12 + 56]
cmp r8, 16
jae ef_register
mov rcx, r9
mov rdx, r10
call normalize_gpr
cmp rax, -1
je ef_register
mov r9, rax
call cc_feature_check
cmp rax, 0
jne ef_error
store64 [rsp + 24], r10
load64 r15, [rdi + 8]
cmp rsi, 1
je wi_extend_opcode
cmp rsi, 2
jne wi_prefix
wi_extend_opcode:
cmp r10, 16
jne wi_prefix
add r15, 1
wi_prefix:
mov r10, 0
cmp rbx, 16
jne wi_rex
mov rax, 0x66
store8 [rsp], rax
add r10, 1
wi_rex:
mov r11, 0x40
cmp rbx, 64
jne wi_rex_r
or r11, 8
wi_rex_r:
cmp r8, 8
jb wi_rex_b
or r11, 4
wi_rex_b:
cmp r9, 0x100
jae wi_need_rex
cmp r9, 8
jb wi_need_rex
or r11, 1
wi_need_rex:
cmp r9, 0x100
jb wi_normal_rex
cmp r11, 0x40
jne ef_register
jmp wi_opcode_prefix
wi_normal_rex:
cmp r11, 0x40
jne wi_emit_rex
load64 rax, [rsp + 24]
cmp rax, 8
jne wi_opcode_prefix
cmp r9, 4
jb wi_opcode_prefix
wi_emit_rex:
store8 [rsp + r10 * 1], r11
add r10, 1
wi_opcode_prefix:
cmp rsi, 3
je wi_opcode
mov rax, 0x0F
store8 [rsp + r10 * 1], rax
add r10, 1
wi_opcode:
store8 [rsp + r10 * 1], r15
add r10, 1
mov rax, r8
and rax, 7
shl rax, 3
mov rcx, r9
and rcx, 7
or rax, rcx
or rax, 0xC0
store8 [rsp + r10 * 1], rax
add r10, 1
mov rdx, r10
mov rcx, 0
jmp rr_commit

bit_begin:
lea rdi, [rip + bit_forms]
bi_next:
load64 rbx, [rdi]
cmp rbx, 0
je control_begin
mov rcx, 0
bi_name:
cmp rcx, 31
jae ef_unknown
load8 rax, [rsi + rcx * 1]
load8 rdx, [rbx + rcx * 1]
cmp rax, rdx
jne bi_other
cmp rax, 0
je bi_found
add rcx, 1
jmp bi_name
bi_other:
add rdi, 24
jmp bi_next
bi_found:
load64 rax, [r12 + 8]
cmp rax, 2
jne ef_count
load64 rax, [r12 + 16]
cmp rax, 1
jne ef_form
load64 rbx, [r12 + 24]
cmp rbx, 16
je bi_reg
cmp rbx, 32
je bi_reg
cmp rbx, 64
jne ef_width
bi_reg:
load64 r8, [r12 + 32]
cmp r8, 16
jae ef_register
load64 rsi, [r12 + 40]
load64 r9, [r12 + 56]
load64 rax, [r12 + 48]
cmp rsi, 2
je bi_imm
cmp rsi, 1
jne ef_form
cmp rax, rbx
jne ef_width
cmp r9, 16
jae ef_register
jmp bi_features
bi_imm:
cmp rax, 8
jne ef_width
cmp r9, 256
jae ef_range
bi_features:
