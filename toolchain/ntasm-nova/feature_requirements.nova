module feature_requirements;import ntasm_ast;import features;
fn same(source:buf<u8>,start:u64,end:u64,text:buf<u8>)->bool{if start>end||end>len(source)||(end-start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[start+i]!=text[i]{return false;}i=i+1;}return true;}
fn predicate_name(tree:ntasm_ast.Tree,id:u64)->u64{let p:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if p.kind!=33||p.first_child==0||p.first_child>tree.node_count{return 0;}let q:ntasm_ast.Node=ntasm_ast.node_at(tree,p.first_child);if q.kind!=91||q.first_child==0||q.first_child!=q.last_child||q.first_child>tree.node_count{return 0;}return q.first_child;}
fn feature_arg(tree:ntasm_ast.Tree,id:u64)->u64{let p:ntasm_ast.Node=ntasm_ast.node_at(tree,id);let q:ntasm_ast.Node=ntasm_ast.node_at(tree,p.first_child);let expr_id:u64=q.next_sibling;if expr_id==0||expr_id>tree.node_count{return 0;}let expr:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if expr.kind!=35||expr.aux!=0||expr.first_child==0||expr.first_child!=expr.last_child||expr.first_child>tree.node_count{return 0;}let nameq:ntasm_ast.Node=ntasm_ast.node_at(tree,expr.first_child);if nameq.kind!=91||nameq.first_child==0||nameq.first_child!=nameq.last_child||nameq.first_child>tree.node_count{return 0;}return nameq.first_child;}
// Every feature(x) predicate must name a catalog feature present in the module
// mask. Success writes predicates,available predicates,required mask,0.
// 343 unknown/malformed feature;344 known but unavailable.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let summary:buf<u64>=alloc(runtime(),4);let mut code:u64=features.check(source,tree,summary);let mask:u64=summary[2];let mut predicates:u64=0;let mut available:u64=0;let mut required:u64=0;let mut line:u64=0;let mut column:u64=0;let mut id:u64=1;while id<=tree.node_count&&code==0{let p:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if p.kind==33{let name_id:u64=predicate_name(tree,id);if name_id==0{code=800;}else{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);let word:buf<u8>="feature";if same(source,name.start,name.end,word){predicates=predicates+1;let arg_id:u64=feature_arg(tree,id);if arg_id==0{code=343;line=name.line;column=name.column;}else{let arg:ntasm_ast.Node=ntasm_ast.node_at(tree,arg_id);let bit:u64=features.lookup(source,arg.start,arg.end);if bit==0{code=343;line=arg.line;column=arg.column;}else{required=required|bit;if (mask&bit)==0{code=344;line=arg.line;column=arg.column;}else{available=available+1;}}}}}}id=id+1;}if code==0{out[0]=predicates;out[1]=available;out[2]=required;out[3]=0;}else if code==343||code==344{out[0]=line;out[1]=column;out[2]=0;out[3]=0;}rt_free(runtime(),summary);return code;}
