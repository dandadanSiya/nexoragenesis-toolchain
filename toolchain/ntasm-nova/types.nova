module types;import ntasm_ast;
fn same(source:buf<u8>,start:u64,end:u64,text:buf<u8>)->bool{if start>end||end>len(source)||(end-start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[start+i]!=text[i]{return false;}i=i+1;}return true;}
fn scalar(source:buf<u8>,name:ntasm_ast.Node)->bool{let a:buf<u8>="u8";if same(source,name.start,name.end,a){return true;}let b:buf<u8>="u16";if same(source,name.start,name.end,b){return true;}let c:buf<u8>="u32";if same(source,name.start,name.end,c){return true;}let d:buf<u8>="u64";if same(source,name.start,name.end,d){return true;}let e:buf<u8>="i8";if same(source,name.start,name.end,e){return true;}let f:buf<u8>="i16";if same(source,name.start,name.end,f){return true;}let g:buf<u8>="i32";if same(source,name.start,name.end,g){return true;}let h:buf<u8>="i64";if same(source,name.start,name.end,h){return true;}let i:buf<u8>="bool";if same(source,name.start,name.end,i){return true;}let j:buf<u8>="never";return same(source,name.start,name.end,j);}
// Validate the closed scalar catalog and array length boundary. Composite ptr,
// array/list and macro type variables retain their parser shapes. Success writes
// scalar,pointer,array,other counts. Error350 unknown scalar;351 zero array.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let mut scalars:u64=0;let mut pointers:u64=0;let mut arrays:u64=0;let mut other:u64=0;let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut id:u64=1;while id<=tree.node_count&&code==0{let type_:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if type_.kind==36{if type_.aux==0{if type_.first_child==0||type_.first_child!=type_.last_child||type_.first_child>tree.node_count{code=800;}else{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,type_.first_child);if name.kind!=90||name.start>name.end||name.end>len(source){code=800;}else if scalar(source,name)==false{code=350;line=name.line;column=name.column;}else{scalars=scalars+1;}}}else if type_.aux==1{pointers=pointers+1;}else if type_.aux==2{arrays=arrays+1;if type_.last_child==0||type_.last_child>tree.node_count{code=800;}else{let length:ntasm_ast.Node=ntasm_ast.node_at(tree,type_.last_child);if length.kind!=94{code=800;}else if length.aux==0{code=351;line=length.line;column=length.column;}}}else if type_.aux==3||type_.aux==4{other=other+1;}else{code=800;}}id=id+1;}if code==0{out[0]=scalars;out[1]=pointers;out[2]=arrays;out[3]=other;}else if code==350||code==351{out[0]=line;out[1]=column;out[2]=0;out[3]=0;}return code;}
