export fn parse(source:buf<u8>,source_index:u64)->ntasm_ast.Tree {
    let lexed:ntasm_lexer.Result=ntasm_lexer.lex(source,source_index);
    let empty_nodes:buf<u64>=alloc(runtime(),0);
    if (lexed.ok==false) {
        return ntasm_ast.Tree{ok:false,token_words:lexed.token_words,
            token_count:0,node_words:empty_nodes,node_count:0,
            code:lexed.diagnostic.code,reason:lexed.diagnostic.reason,
            source:lexed.diagnostic.span.source,line:lexed.diagnostic.span.line,
            column:lexed.diagnostic.span.column,start:lexed.diagnostic.span.start,
            end:lexed.diagnostic.span.end};
    }
    rt_free(runtime(),empty_nodes);
    let capacity:u64=(lexed.count*2+16)*12;
    let nodes:buf<u64>=alloc(runtime(),capacity);
    let words:buf<u8>="module\0target\0versions\0ntir\0machine_ir\0sections\0symbols\0relocations\0nxo\0default_abi\0output\0features\0import\0as\0fn\0const\0data\0comptime\0stub_table\0kind\0interrupt\0syscall\0section\0effects\0clobbers\0requires\0ensures\0abi\0in\0out\0inout\0let\0call\0return\0if\0else\0macro\0expand\0intrinsic\0ptr\0array\0bool\0never\0u8\0u16\0u32\0u64\0list\0quote\0ast\0stmt\0decl\0type\0block\0for\0emit\0handler\0entry_abi\0exit_abi\0exit\0frame\0bindings\0hardware_error_code\0save\0stack_align\0swapgs\0interrupts\0visibility\0local\0export\0true\0false\0symbol\0expr\0fs\0gs\0";
    let p:Parser=Parser{source:source,tokens:lexed.token_words,
        token_count:lexed.count,cursor:0,split_gt:false,nodes:nodes,
        node_count:0,words:words,code:0,reason:0,error_source:source_index,
        error_line:1,error_column:1,error_start:0,error_end:0,
        optional_term:false};
    let root:u64=source_tree(p);
    rt_free(runtime(),words);
    let ok:bool=root!=0 && p.code==0 && tk(p)==256;
    if (ok==false && p.code==0) { error(p,11); }
    let mut final_count:u64=0;if (ok==true) { final_count=p.node_count; }
    return ntasm_ast.Tree{ok:ok,token_words:lexed.token_words,
        token_count:lexed.count,node_words:nodes,node_count:final_count,
        code:p.code,reason:p.reason,source:p.error_source,line:p.error_line,
        column:p.error_column,start:p.error_start,end:p.error_end};
}
