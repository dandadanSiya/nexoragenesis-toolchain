module targets;import ntasm_ast;
fn same(source:buf<u8>,start:u64,end:u64,text:buf<u8>)->bool{if start>end||end>len(source)||(end-start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[start+i]!=text[i]{return false;}i=i+1;}return true;}
// Validate the two executable x86_64 target triples. Success writes target
// count,none count,uefi count,0. Error345 unknown;346 malformed multiplicity.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let mut count:u64=0;let mut none:u64=0;let mut uefi:u64=0;let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut id:u64=1;while id<=tree.node_count&&code==0{let target:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if target.kind==3{count=count+1;if target.first_child==0||target.first_child!=target.last_child||target.first_child>tree.node_count{code=800;}else{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,target.first_child);if name.kind!=92||name.start>name.end||name.end>len(source){code=800;}else{let a:buf<u8>="x86_64-nexora-none";let b:buf<u8>="x86_64-nexora-uefi";if same(source,name.start,name.end,a){none=none+1;}else if same(source,name.start,name.end,b){uefi=uefi+1;}else{code=345;line=name.line;column=name.column;}}}}id=id+1;}if code==0&&count!=1{code=346;line=1;column=1;}if code==0{out[0]=count;out[1]=none;out[2]=uefi;out[3]=0;}else if code==345||code==346{out[0]=line;out[1]=column;out[2]=0;out[3]=0;}return code;}
