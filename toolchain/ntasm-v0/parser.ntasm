case_positive_end:
case_function:
ascii "module m\ntarget x86_64-nexora-none\nsection .text {\nfn f() -> u64\neffects {}\nclobbers {rax} {\nreturn 0\n}\n}\n"
case_function_end:
case_parameter:
ascii "module m\ntarget x86_64-nexora-none\nsection .text {\nfn f(in x: u64 @rdi) -> u64\neffects {}\nclobbers {rax} {\nreturn x\n}\n}\n"
case_parameter_end:
case_authority:
ascii "module kernel.syscalls\ntarget x86_64-nexora-none\n\nsection .syscall {\n"
ascii "export fn syscall_entry(\nin number: u64 @rax,\nin arg0: u64 @rdi,\nin arg1: u64 @rsi\n) -> never\n"
ascii "effects { privileged, reads_mem, writes_mem, changes_flags }\nclobbers { rax, rcx, r11 } {\n"
ascii "swapgs\nload rsp, [gs:kernel_rsp]:ptr<kernel, u64>\nalign_stack 16\ncall nx_syscall_dispatch\nsysretq\n}\n}\n"
case_authority_end:
