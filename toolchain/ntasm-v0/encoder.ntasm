add r10, 1
mov rdx, r10
mov rcx, 0
jmp rr_commit
jump_memory:
load64 rax, [r12 + 24]
cmp rax, 64
jne ef_width
store64 [rsp + 16], r15
mov r15, 0xFF
mov r8, 4
; Internal zero width means long-mode default64, without redundant REX.W.
mov rbx, 0
jmp mem_register
; Encoding IDs16..19 are AH/CH/DH/BH, not physical roots or SPL-family.
; Packed internal bit8 marks high-byte registers until REX checks complete.
; Private ABI: opcode RCX, request R12; returns status RAX and
; RBX width, R8 ModRM group, R15 opcode. Frame immediate slots32/40.
prepare_mem_immediate:
mov rsi, rcx
load64 rbx, [r12 + 24]
load64 rax, [r12 + 48]
cmp rax, rbx
jne pmi_width
load64 r9, [r12 + 56]
mov rdi, 1
cmp rbx, 8
je pmi_eight
mov rdi, 2
cmp rbx, 16
je pmi_sixteen
mov rdi, 4
cmp rbx, 32
je pmi_thirtytwo
cmp rbx, 64
jne pmi_width
mov rax, 0x7FFFFFFF
cmp r9, rax
jb pmi_select
je pmi_select
mov rax, 0xFFFFFFFF80000000
cmp r9, rax
jb pmi_range
jmp pmi_select
pmi_eight:
cmp r9, 256
jae pmi_range
jmp pmi_select
pmi_sixteen:
cmp r9, 65536
jae pmi_range
jmp pmi_select
pmi_thirtytwo:
mov rax, 0x100000000
cmp r9, rax
jae pmi_range
pmi_select:
mov r8, 0
cmp rsi, 0xC7
je pmi_store
cmp rsi, 0x85
je pmi_test
mov r8, rsi
shr r8, 3
and r8, 7
mov r15, 0x81
cmp rbx, 8
je pmi_publish
cmp r9, 128
jb pmi_compact
mov rax, 0xFFFFFFFFFFFFFF80
cmp rbx, 64
je pmi_compact_compare
mov rax, 0xFFFFFF80
cmp rbx, 32
je pmi_compact_compare
mov rax, 0xFF80
pmi_compact_compare:
cmp r9, rax
jb pmi_publish
pmi_compact:
mov r15, 0x83
mov rdi, 1
jmp pmi_publish
pmi_store:
mov r15, 0xC7
jmp pmi_publish
pmi_test:
mov r15, 0xF7
pmi_publish:
; mem_opcode applies the8-bit opcode decrement exactly once.
store64 [rsp + 40], rdi
store64 [rsp + 48], r9
mov rax, 0
ret
pmi_width:
mov rax, 403
ret
pmi_range:
mov rax, 407
ret
normalize_gpr:
cmp rcx, 16
jb ng_low
cmp rdx, 8
jne ng_bad
cmp rcx, 20
jae ng_bad
mov rax, rcx
sub rax, 12
or rax, 0x100
ret
ng_low:
mov rax, rcx
ret
ng_bad:
mov rax, -1
ret
