; Hote modulaire : source externe, diagnostic differe, pas encore de writer.
format pe64
abi efi_x64
entry start
section .text rx
start:
push rbx
push rbp
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 56
mov rbx, rdx
mov r15, rcx
lea rbp, [rip + module_state]
store64 [rbp + 144], r15
store64 [rbp + 200], rbx
mov r14, 0
mov rax, 1
store64 [rbp], rax
cmp rbx, 0
je host_return
load64 r14, [rbx + 0x60]
cmp r14, 0
je host_finish
mov rcx, r15
lea rdx, [rip + loaded_guid]
lea r8, [rbp + 16]
load64 rax, [r14 + 0x98]
call rax
cmp rax, 0
jne host_cleanup
load64 rax, [rbp + 16]
cmp rax, 0
je host_cleanup
load64 rcx, [rax + 24]
lea rdx, [rip + fs_guid]
lea r8, [rbp + 24]
load64 rax, [r14 + 0x98]
call rax
cmp rax, 0
jne host_cleanup
load64 rcx, [rbp + 24]
cmp rcx, 0
je host_cleanup
lea rdx, [rbp + 32]
load64 rax, [rcx + 8]
call rax
cmp rax, 0
jne host_cleanup
load64 rcx, [rbp + 32]
cmp rcx, 0
je host_cleanup
mov rax, 2
store64 [rbp + 128], rax
store64 [rbp], rax
lea rdx, [rbp + 40]
lea r8, [rip + filename]
mov r9, 1
mov rax, 0
store64 [rsp + 32], rax
load64 rax, [rcx + 8]
call rax
cmp rax, 0
jne host_cleanup
load64 rsi, [rbp + 40]
cmp rsi, 0
je host_cleanup
mov rax, 6
store64 [rbp + 128], rax
mov rax, 3
store64 [rbp], rax
mov rax, 512
store64 [rbp + 56], rax
mov rcx, rsi
lea rdx, [rip + info_guid]
lea r8, [rbp + 56]
lea r9, [rip + file_info]
load64 rax, [rsi + 0x40]
call rax
cmp rax, 0
jne host_cleanup
load64 rax, [rbp + 56]
cmp rax, 80
jb host_cleanup
cmp rax, 513
jae host_cleanup
lea rdx, [rip + file_info]
load64 rax, [rdx + 72]
and rax, 16
jne host_cleanup
load64 r12, [rdx + 8]
cmp r12, 64
jb host_cleanup
cmp r12, 65537
jae host_cleanup
store64 [rbp + 136], r12
mov rax, 4
store64 [rbp], rax
mov rcx, 2
lea rdx, [r12 + 1]
lea r8, [rbp + 48]
load64 rax, [r14 + 0x40]
call rax
cmp rax, 0
jne host_cleanup
load64 rax, [rbp + 48]
cmp rax, 0
je host_cleanup
mov rax, 7
store64 [rbp + 128], rax
mov rax, 3
store64 [rbp], rax
mov rdi, 0
; Lire jusqu'a EOF, en acceptant les lectures courtes sans depasser FileSize+1.
host_read:
lea r13, [r12 + 1]
sub r13, rdi
store64 [rbp + 56], r13
mov rcx, rsi
lea rdx, [rbp + 56]
load64 r8, [rbp + 48]
add r8, rdi
load64 rax, [rsi + 0x20]
call rax
cmp rax, 0
jne host_cleanup
load64 rax, [rbp + 56]
cmp r13, rax
jb host_cleanup
cmp rax, 0
je host_read_done
add rdi, rax
cmp r12, rdi
jb host_cleanup
jmp host_read
host_read_done:
cmp rdi, r12
jne host_cleanup
mov rax, 5
store64 [rbp], rax
mov rcx, 0
mov rdx, r15
mov r8, 0
load64 r9, [rbp + 48]
store64 [rsp + 32], r12
lea rax, [rbp + 64]
store64 [rsp + 40], rax
load64 rax, [r14 + 0xC8]
call rax
mov r13, rax
load64 rcx, [rbp + 64]
cmp rcx, 0
je host_cleanup
load64 rax, [rbp + 128]
or rax, 8
store64 [rbp + 128], rax
cmp r13, 0
jne host_cleanup
mov rax, 6
store64 [rbp], rax
lea rdx, [rip + loaded_guid]
lea r8, [rbp + 72]
load64 rax, [r14 + 0x98]
call rax
cmp rax, 0
jne host_cleanup
load64 rax, [rbp + 72]
cmp rax, 0
je host_cleanup
load64 rsi, [rax + 64]
load64 rdi, [rax + 72]
cmp rsi, 0
je host_cleanup
cmp rdi, 1024
jb host_cleanup
cmp rdi, 131073
jae host_cleanup
mov rdx, rsi
add rdx, rdi
cmp rdx, rsi
jb host_cleanup
store64 [rbp + 80], rsi
store64 [rbp + 88], rdi
; Cette preuve exige une relocation reelle hors ImageBase prefere.
mov rax, 0x140000000
cmp rsi, rax
je host_cleanup
load16 rax, [rsi]
cmp rax, 0x5A4D
jne host_cleanup
load32 rax, [rsi + 0x3C]
cmp rax, 0x80
jne host_cleanup
load32 rax, [rsi + 0x80]
cmp rax, 0x4550
jne host_cleanup
load16 rax, [rsi + 0x84]
cmp rax, 0x8664
jne host_cleanup
load16 rax, [rsi + 0x86]
cmp rax, 4
jne host_cleanup
load16 rax, [rsi + 0x94]
cmp rax, 240
jne host_cleanup
load16 rax, [rsi + 0x98]
cmp rax, 0x20B
jne host_cleanup
load64 rax, [rsi + 0x188]
mov rdx, 0x747865742E
cmp rax, rdx
jne host_cleanup
load32 rax, [rsi + 0x194]
cmp rax, 4096
jne host_cleanup
add rax, rsi
store64 [rbp + 96], rax
load32 rdx, [rsi + 0x190]
cmp rdx, 1
jb host_cleanup
cmp rdx, 32769
jae host_cleanup
add rax, rdx
store64 [rbp + 104], rax
sub rax, rsi
cmp rdi, rax
jb host_cleanup
load64 rax, [rsi + 0x1B0]
mov rdx, 0x61746164722E
cmp rax, rdx
jne host_cleanup
load32 rax, [rsi + 0x1BC]
load32 rdx, [rsi + 0x1B8]
cmp rdx, 48
jb host_cleanup
store64 [rbp + 152], rdx
add rdx, rax
cmp rdi, rdx
jb host_cleanup
add rax, rsi
load64 rdx, [rbp + 104]
cmp rax, rdx
jb host_cleanup
store64 [rbp + 160], rax
mov rax, 7
store64 [rbp], rax
load64 rcx, [rbp + 160]
call host_exports
cmp rax, 0
je host_cleanup
host_options:
; Contrat synchrone : aucun export ne survit a StartImage.
load64 rax, [rbp + 72]
mov rdx, 48
store32 [rax + 48], rdx
lea rdx, [rip + options]
store64 [rax + 56], rdx
mov rax, 8
store64 [rbp], rax
load64 rcx, [rbp + 64]
mov rdx, 0
mov r8, 0
load64 rax, [r14 + 0xD0]
call rax
mov r13, rax
cmp rax, 0
je host_started
mov rdx, 0x8000000000000015
cmp rax, rdx
jne host_cleanup
; Le module normalise son retour en SUCCESS/ABORTED; l'application a quitte.
host_started:
load64 rax, [rbp + 128]
and rax, -9
store64 [rbp + 128], rax
mov rax, 0
store64 [rbp + 64], rax
store64 [rbp + 72], rax
store64 [rbp + 160], rax
lea rcx, [rip + job_exports]
store64 [rcx], rax
cmp r13, 0
jne host_cleanup
load64 rax, [rbp + 112]
cmp rax, 1
jne host_cleanup
load64 rax, [rbp + 120]
cmp rax, 2
jne host_cleanup
mov rax, 0
store64 [rbp], rax
host_cleanup:
load64 rax, [rbp + 128]
and rax, 8
je host_close_file
load64 rcx, [rbp + 64]
load64 rax, [r14 + 0xE0]
call rax
call host_cleanup_status
host_close_file:
load64 rax, [rbp + 128]
and rax, 4
je host_close_root
load64 rcx, [rbp + 40]
load64 rax, [rcx + 0x10]
call rax
call host_cleanup_status
host_close_root:
load64 rax, [rbp + 128]
and rax, 2
je host_free
load64 rcx, [rbp + 32]
load64 rax, [rcx + 0x10]
call rax
call host_cleanup_status
host_free:
load64 rax, [rbp + 128]
and rax, 1
je host_finish
load64 rcx, [rbp + 48]
load64 rax, [r14 + 0x48]
call rax
call host_cleanup_status
host_finish:
load64 rax, [rbp]
cmp rax, 0
jne host_error_message
call compiler_report
jmp host_return
host_error_message:
add rax, 48
lea rdx, [rip + message_error]
store16 [rdx + 38], rax
host_print:
load64 rcx, [rbx + 0x40]
load64 rax, [rcx + 8]
call rax
host_return:
load64 rax, [rbp]
cmp rax, 0
jne host_abort
lea rax, [rip + compiler_state]
load64 rax, [rax + 104]
jmp host_restore
host_abort:
mov rax, 0x8000000000000015
host_restore:
add rsp, 56
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbp
pop rbx
ret
host_cleanup_status:
cmp rax, 0
je cleanup_done
load64 rax, [rbp]
cmp rax, 0
jne cleanup_done
mov rax, 9
store64 [rbp], rax
cleanup_done:
ret
; RCX=table exacte attendue, RBP=contexte. Retour export executable ou zero.
host_exports:
load64 rax, [rbp + 160]
cmp rcx, rax
jne exports_bad
load64 rax, [rcx]
mov rdx, 0x31303030424C544E
cmp rax, rdx
jne exports_bad
load64 rax, [rcx + 8]
cmp rax, 1
jne exports_bad
load64 r8, [rcx + 24]
cmp r8, 4
jne exports_bad
mov rax, 0x200000064
load64 rdx, [rcx + 32]
cmp rdx, rax
jne exports_bad
; Verifier la taille disponible avant toute lecture des records suivants.
load64 rdx, [rbp + 152]
cmp rdx, 96
jb exports_bad
mov rax, 0x300000065
load64 rdx, [rcx + 48]
cmp rdx, rax
jne exports_bad
mov rax, 0x300000066
load64 rdx, [rcx + 64]
cmp rdx, rax
jne exports_bad
mov rax, 0x300000067
load64 rdx, [rcx + 80]
cmp rdx, rax
jne exports_bad
jmp exports_size
exports_size:
imul rdx, r8, 16
add rdx, 32
load64 rax, [rcx + 16]
cmp rax, rdx
jne exports_bad
lea r9, [rcx + 40]
mov r10, r8
exports_pointer:
load64 rax, [r9]
load64 rdx, [rbp + 96]
cmp rax, rdx
jb exports_bad
load64 rdx, [rbp + 104]
cmp rax, rdx
jae exports_bad
add r9, 16
sub r10, 1
jne exports_pointer
load64 rax, [rcx + 40]
ret
exports_bad:
mov rax, 0
ret
; Le callback termine le job meme si le source produit un diagnostic.
host_callback:
push rbp
push rsi
push rdi
sub rsp, 32
lea rax, [rip + module_state]
cmp rdx, rax
jne callback_bad
mov rbp, rdx
mov rsi, rcx
mov rax, 0x6E747363616C6C31
cmp r8, rax
jne callback_bad
load64 rax, [rbp + 64]
cmp r9, rax
jne callback_bad
load64 rax, [rbp + 112]
cmp rax, 0
jne callback_bad
mov rax, 1
store64 [rbp + 112], rax
call host_exports
cmp rax, 0
je callback_bad
lea rax, [rip + job_exports]
store64 [rax], rsi
load64 rcx, [rbp + 144]
load64 rdx, [rbp + 200]
call compile_job
mov rax, 2
store64 [rbp + 120], rax
mov rax, 0
jmp callback_return
callback_bad:
mov rax, 0x8000000000000015
callback_return:
add rsp, 32
pop rdi
pop rsi
pop rbp
ret
compile_job:
push rbx
push rbp
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 40
mov rbx, rdx
mov r15, rcx
lea rbp, [rip + compiler_state]
mov rax, 0x8000000000000001
store64 [rbp + 104], rax
cmp rbx, 0
je io_return
load64 r14, [rbx + 0x60]
cmp r14, 0
je io_e001
load64 rax, [r14 + 0x40]
cmp rax, 0
je io_e001
load64 rax, [r14 + 0x48]
cmp rax, 0
je io_e001
load64 rax, [r14 + 0x98]
cmp rax, 0
je io_e001
mov rcx, 2
mov rdx, 0x1D020
lea r8, [rbp]
lea rax, [rip + io_test_fault]
load64 rax, [rax]
cmp rax, 1
je io_simulated_null
load64 rax, [r14 + 0x40]
call rax
jmp io_work_result
io_simulated_null:
mov rax, 0
io_work_result:
mov rdx, 0x8000000000000000
cmp rax, rdx
jae io_alloc_error
load64 rcx, [rbp]
cmp rcx, 0
je io_alloc_null
mov rax, 1
store64 [rbp + 184], rax
mov rdx, 0x1D000
lea r8, [rip + io_work_pre]
lea r9, [rip + io_work_post]
call io_init_guards
load64 r12, [rbp]
add r12, 16
mov r8, r12
mov rcx, 0x1D000
mov rax, 0
io_zero_work:
store64 [r8], rax
add r8, 8
sub rcx, 8
jne io_zero_work
mov rcx, 2
mov rdx, 0x10020
lea r8, [rbp + 8]
load64 rax, [r14 + 0x40]
call rax
mov rdx, 0x8000000000000000
cmp rax, rdx
jae io_alloc_error
load64 rcx, [rbp + 8]
cmp rcx, 0
je io_alloc_null
load64 rax, [rbp + 184]
or rax, 2
store64 [rbp + 184], rax
mov rdx, 0x10000
lea r8, [rip + io_src_pre]
lea r9, [rip + io_src_post]
call io_init_guards
load64 r13, [rbp + 8]
add r13, 16
; OUT sert d'abord de staging borne, puis contient le PE final.
mov rcx, 2
mov rdx, 0x10020
lea r8, [rbp + 192]
load64 rax, [r14 + 0x40]
call rax
mov rdx, 0x8000000000000000
cmp rax, rdx
jae io_alloc_error
load64 rcx, [rbp + 192]
cmp rcx, 0
je io_alloc_null
load64 rax, [rbp + 184]
or rax, 16
store64 [rbp + 184], rax
mov rdx, 0x10000
lea r8, [rip + io_out_pre]
lea r9, [rip + io_out_post]
call io_init_guards
load64 rdi, [rbp + 192]
add rdi, 16
store64 [rbp + 200], rdi
mov rcx, 0x10000
mov rax, 0
io_zero_out:
store64 [rdi], rax
add rdi, 8
sub rcx, 8
jne io_zero_out
mov rcx, r15
lea rdx, [rip + io_loaded_guid]
lea r8, [rbp + 16]
load64 rax, [r14 + 0x98]
call rax
mov rdx, 0x8000000000000000
cmp rax, rdx
jae io_protocol_error
load64 rax, [rbp + 16]
cmp rax, 0
je io_e001
load64 rcx, [rax + 0x18]
cmp rcx, 0
je io_e001
lea rdx, [rip + io_fs_guid]
lea r8, [rbp + 24]
load64 rax, [r14 + 0x98]
call rax
mov rdx, 0x8000000000000000
cmp rax, rdx
jae io_protocol_error
load64 rcx, [rbp + 24]
cmp rcx, 0
je io_e001
load64 rax, [rcx + 8]
cmp rax, 0
je io_e001
lea rdx, [rbp + 32]
call rax
mov rdx, 0x8000000000000000
cmp rax, rdx
jae io_protocol_error
load64 rdi, [rbp + 32]
cmp rdi, 0
je io_e001
load64 rax, [rbp + 184]
or rax, 4
store64 [rbp + 184], rax
load64 rax, [rdi + 8]
cmp rax, 0
je io_e001
mov rcx, rdi
lea rdx, [rbp + 40]
lea r8, [rip + io_source_name]
mov r9, 1
mov rax, 0
store64 [rsp + 32], rax
load64 rax, [rdi + 8]
call rax
mov rdx, 0x8000000000000000
cmp rax, rdx
jae io_protocol_error
load64 rsi, [rbp + 40]
cmp rsi, 0
je io_e001
load64 rax, [rbp + 184]
or rax, 8
store64 [rbp + 184], rax
load64 rax, [rsi + 0x40]
cmp rax, 0
je io_e002
mov rax, 512
store64 [rbp + 56], rax
mov rcx, rsi
lea rdx, [rip + io_info_guid]
lea r8, [rbp + 56]
lea r9, [r12 + 0x1CA00]
load64 rax, [rsi + 0x40]
call rax
mov rdx, 0x8000000000000000
cmp rax, rdx
jae io_read_error
load64 rax, [rbp + 56]
cmp rax, 80
jb io_e002
cmp rax, 513
jae io_e002
load64 rax, [r12 + 0x1CA48]
and rax, 16
jne io_e002
io_read:
load64 rdx, [rbp + 48]
cmp rdx, 65536
jae io_too_large
mov rax, 65536
sub rax, rdx
store64 [rbp + 56], rax
store64 [rbp + 64], rax
mov r8, r13
add r8, rdx
mov rcx, rsi
lea rdx, [rbp + 56]
load64 rax, [rsi + 0x20]
cmp rax, 0
je io_e002
call rax
store64 [rbp + 176], rax
call io_check_guards
cmp rax, 0
jne io_guard_error
load64 rax, [rbp + 176]
mov rdx, 0x8000000000000000
cmp rax, rdx
jae io_read_error
load64 rax, [rbp + 56]
load64 rdx, [rbp + 64]
cmp rdx, rax
jb io_e002
cmp rax, 0
je io_read_done
load64 rdx, [rbp + 48]
add rax, rdx
cmp rax, 65536
jae io_too_large
store64 [rbp + 48], rax
jmp io_read
io_read_done:
load64 rax, [rbp + 48]
cmp rax, 0
je io_empty
; Fermer puis analyser SRC immuable.
load64 rax, [rsi + 0x10]
cmp rax, 0
je io_e002
mov rcx, rsi
call rax
load64 rdx, [rbp + 184]
and rdx, -9
store64 [rbp + 184], rdx
mov rdx, 0x8000000000000000
cmp rax, rdx
jae io_read_error
; Journal borne : copie SRC, snapshot WORK, 4096 records de 0x540 octets.
mov rcx, 2
mov rdx, 0x56D020
lea r8, [rbp + 232]
load64 rax, [r14 + 0x40]
call rax
mov rdx, 0x8000000000000000
cmp rax, rdx
jae io_alloc_error
load64 rcx, [rbp + 232]
cmp rcx, 0
je io_alloc_null
load64 rax, [rbp + 184]
or rax, 32
store64 [rbp + 184], rax
mov rdx, 0x56D000
lea r8, [rip + io_work_pre]
lea r9, [rip + io_work_post]
call io_init_guards
load64 rdi, [rbp + 232]
add rdi, 16
store64 [rbp + 240], rdi
mov rsi, r13
load64 rcx, [rbp + 48]
call pass_copy_bytes
; GetInfo utilisait ce scratch avant l'analyse; les deux passes partent de zero.
lea rdi, [r12 + 0x1CA00]
mov rcx, 64
mov rax, 0
pass_clear_info:
store64 [rdi], rax
add rdi, 8
sub rcx, 1
jne pass_clear_info
mov rax, 1
store64 [rbp + 248], rax
mov rax, -1
store64 [rbp + 272], rax
mov rsi, 0
mov rdi, 0
mov rax, 1
store64 [rbp + 120], rax
io_scan:
load64 rax, [rbp + 48]
cmp rsi, rax
jae io_eof
load64 rax, [rbp + 120]
cmp rax, 4097
jae io_line_limit
load8 rax, [r13 + rsi * 1]
cmp rax, 10
je io_lf
cmp rax, 13
je io_cr
load64 rdx, [rbp + 272]
cmp rdx, -1
jne io_next_byte
cmp rax, 9
je recovery_valid_char
cmp rax, 32
jb io_bad_byte
cmp rax, 127
jae io_bad_byte
recovery_valid_char:
mov rdx, rsi
sub rdx, rdi
cmp rdx, 255
jae io_line_long
io_next_byte:
add rsi, 1
jmp io_scan
io_cr:
lea rax, [rsi + 1]
load64 rdx, [rbp + 48]
cmp rax, rdx
jae io_bad_byte
load8 rax, [r13 + rax * 1]
cmp rax, 10
jne io_bad_byte
mov rax, 2
jmp io_line
io_lf:
mov rax, 1
io_line:
store64 [rbp + 136], rax
store64 [rbp + 112], rdi
mov r8, rsi
sub r8, rdi
load64 rcx, [rbp + 272]
cmp rcx, -1
je recovery_line_length
mov r8, rcx
recovery_line_length:
store64 [rbp + 128], r8
lea rax, [rip + io_test_fault]
load64 rax, [rax]
cmp rax, 4
jne io_snapshot_ready
call io_snapshot_payload
io_snapshot_ready:
call recovery_begin
load64 r8, [rbp + 128]
mov rcx, r12
mov rdx, r13
add rdx, rdi
lea r9, [rbp + 112]
call native_front_line
cmp r10, 0
jne io_parse_error
store64 [rsp + 32], rax
call pass_line
cmp rax, 0
jne io_pass_error
load64 rax, [rbp + 248]
cmp rax, 1
je io_after_trace
load64 rax, [rsp + 32]
call writer_stage_line
cmp rax, 0
jne io_writer_error
load64 rax, [rsp + 32]
cmp rax, 7
jb io_after_trace
lea rcx, [rip + io_test_fault]
load64 rcx, [rcx]
cmp rcx, 4
jne io_after_trace
call io_trace_payload
cmp rax, 0
jne io_guard_error
io_after_trace:
load64 rax, [rbp + 136]
add rsi, rax
mov rdi, rsi
load64 rax, [rbp + 120]
add rax, 1
store64 [rbp + 120], rax
mov rax, -1
store64 [rbp + 272], rax
jmp io_scan
io_eof:
cmp rsi, rdi
jne recovery_missing_eol
load64 rax, [r12 + 0x80]
cmp rax, 6
je recovery_eof_ready
load64 rcx, [rbp + 248]
cmp rcx, 1
jne io_pass_error
mov rdx, rax
mov rax, 200
cmp rdx, 2
jne recovery_eof_position
mov rax, 302
recovery_eof_position:
load64 r8, [rbp + 120]
mov r9, 1
load64 r11, [rbp + 48]
cmp rdx, 0
jne recovery_eof_remember
mov r8, 1
mov r11, 0
recovery_eof_remember:
call recovery_remember
recovery_eof_ready:
mov rsi, r13
load64 rdi, [rbp + 240]
load64 rcx, [rbp + 48]
call pass_compare_bytes
cmp rax, 0
jne io_pass_error
mov rcx, r12
mov rdx, r13
load64 r8, [rbp + 48]
load64 rax, [r12 + 0x80]
cmp rax, 3
jb recovery_publish
mov rcx, r12
mov rdx, r13
load64 r8, [rbp + 48]
call native_finish_source
cmp rax, 0
je recovery_finish_ok
cmp rax, 600
jae io_fixup_error
call recovery_remember
recovery_finish_ok:
load64 rax, [r12 + 0x110]
cmp rax, 0
jne recovery_publish
call writer_layout_pe
cmp rax, 0
jne io_writer_error
load64 rax, [rbp + 248]
cmp rax, 1
je pass_first_complete
cmp rax, 2
jne io_pass_error
load64 rax, [rbp + 120]
load64 rdx, [rbp + 256]
cmp rax, rdx
jne io_pass_error
mov rsi, r12
load64 rdi, [rbp + 240]
add rdi, 0x10000
mov rcx, 0x1D000
call pass_compare_bytes
cmp rax, 0
jne io_pass_error
call writer_finish_pe
cmp rax, 0
jne io_writer_error
call io_check_guards
cmp rax, 0
jne io_guard_error
call writer_write_pe
cmp rax, 0
jne io_writer_status
mov rax, 0
store64 [rbp + 104], rax
jmp io_resolved
pass_first_complete:
load64 rax, [rbp + 120]
store64 [rbp + 256], rax
mov rsi, r12
load64 rdi, [rbp + 240]
add rdi, 0x10000
mov rcx, 0x1D000
call pass_copy_bytes
; La deuxieme analyse part d'un contexte vierge et du meme SRC immuable.
mov rdi, r12
mov rcx, 0x3A00
mov rax, 0
pass_zero_work:
store64 [rdi], rax
add rdi, 8
sub rcx, 1
jne pass_zero_work
store64 [rbp + 208], rax
store64 [rbp + 216], rax
store64 [rbp + 224], rax
mov rax, 2
store64 [rbp + 248], rax
mov rax, 1
store64 [rbp + 120], rax
mov rax, -1
store64 [rbp + 272], rax
mov rsi, 0
mov rdi, 0
jmp io_scan
io_pass_error:
mov rax, 600
store64 [rbp + 72], rax
store64 [rbp + 264], r11
mov rax, 0
store64 [rbp + 80], rax
store64 [rbp + 88], rax
store64 [rbp + 96], rax
mov rax, 0x8000000000000001
store64 [rbp + 104], rax
jmp io_cleanup
io_fixup_error:
store64 [rbp + 72], rax
store64 [rbp + 80], r8
store64 [rbp + 88], r9
store64 [rbp + 96], r11
jmp io_cleanup
io_writer_error:
store64 [rbp + 72], rax
load64 rax, [rbp + 120]
store64 [rbp + 80], rax
mov rax, 0x8000000000000001
store64 [rbp + 104], rax
jmp io_cleanup
io_writer_status:
store64 [rbp + 72], rax
store64 [rbp + 104], rdx
jmp io_cleanup
io_resolved:
load64 rax, [r12]
store64 [rbp + 144], rax
load64 rax, [r12 + 24]
store64 [rbp + 152], rax
load64 rax, [r12 + 8]
store64 [rbp + 160], rax
load64 rax, [r12 + 16]
store64 [rbp + 168], rax
jmp io_cleanup
io_parse_error:
load64 rax, [rbp + 248]
cmp rax, 1
jne io_pass_error
cmp r10, 600
jae recovery_internal
mov rax, r10
load64 r8, [rbp + 120]
lea r9, [r11 + 1]
add r11, rdi
call recovery_remember
call recovery_rollback
jmp io_after_trace
recovery_internal:
store64 [rbp + 72], r10
load64 rax, [rbp + 120]
store64 [rbp + 80], rax
lea rax, [r11 + 1]
store64 [rbp + 88], rax
add r11, rdi
store64 [rbp + 96], r11
lea rax, [rip + io_test_fault]
load64 rax, [rax]
cmp rax, 4
jne io_error_payload_done
call io_compare_payload
cmp rax, 0
jne io_guard_error
io_error_payload_done:
jmp io_cleanup
io_bad_byte:
mov rax, 100
jmp recovery_physical
io_line_long:
mov rax, 101
recovery_physical:
load64 rcx, [rbp + 248]
cmp rcx, 1
jne io_pass_error
load64 rcx, [rbp + 272]
cmp rcx, -1
jne io_next_byte
mov rcx, rsi
sub rcx, rdi
store64 [rbp + 272], rcx
lea r9, [rcx + 1]
load64 r8, [rbp + 120]
mov r11, rsi
call recovery_remember
jmp io_next_byte
recovery_missing_eol:
load64 rax, [rbp + 248]
cmp rax, 1
jne io_pass_error
mov rax, 100
load64 r8, [rbp + 120]
mov r9, rsi
sub r9, rdi
add r9, 1
mov r11, rsi
call recovery_remember
mov rax, 0
jmp io_line
io_line_limit:
load64 rax, [rbp + 248]
cmp rax, 1
jne io_pass_error
mov rax, 500
load64 r8, [rbp + 120]
mov r9, 1
mov r11, rsi
call recovery_remember
mov rdi, rsi
jmp io_eof
io_missing_section:
mov rax, 200
io_position:
store64 [rbp + 72], rax
load64 rax, [rbp + 120]
store64 [rbp + 80], rax
mov rax, rsi
sub rax, rdi
add rax, 1
store64 [rbp + 88], rax
store64 [rbp + 96], rsi
jmp io_cleanup
io_empty:
mov rcx, 100
jmp io_source_error
io_too_large:
mov rcx, 500
io_source_error:
store64 [rbp + 72], rcx
jmp io_cleanup
io_e001:
mov rax, 0x8000000000000007
io_protocol_error:
mov rcx, 1
call io_first_error
jmp io_cleanup
io_e002:
mov rax, 0x8000000000000007
io_read_error:
mov rcx, 2
call io_first_error
jmp io_cleanup
io_alloc_null:
mov rax, 0x8000000000000009
io_alloc_error:
mov rcx, 500
call io_first_error
jmp io_cleanup
io_guard_error:
mov rax, 603
store64 [rbp + 72], rax
mov rax, 0
store64 [rbp + 80], rax
store64 [rbp + 88], rax
store64 [rbp + 96], rax
mov rax, 0x8000000000000001
store64 [rbp + 104], rax
io_cleanup:
load64 rax, [rbp + 184]
and rax, 8
je io_close_root
load64 rcx, [rbp + 40]
load64 rax, [rcx + 0x10]
cmp rax, 0
je io_close_file_missing
call rax
jmp io_close_file_status
io_close_file_missing:
mov rax, 0x8000000000000007
io_close_file_status:
mov rcx, 2
call io_first_error
io_close_root:
