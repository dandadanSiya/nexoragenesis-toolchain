module condition_types;

import ntasm_ast;

fn child(tree:ntasm_ast.Tree,parent:u64,ordinal:u64)->u64{if parent==0||parent>tree.node_count{return 0;}let p:ntasm_ast.Node=ntasm_ast.node_at(tree,parent);let mut id:u64=p.first_child;let mut index:u64=0;while id!=0&&index<ordinal{if id>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);id=n.next_sibling;index=index+1;}if id>tree.node_count{return 0;}return id;}
fn same(source:buf<u8>,a:ntasm_ast.Node,b:ntasm_ast.Node)->bool{if a.start>a.end||b.start>b.end||a.end>len(source)||b.end>len(source)||(a.end-a.start)!=(b.end-b.start){return false;}let mut i:u64=0;while i<(a.end-a.start){if source[a.start+i]!=source[b.start+i]{return false;}i=i+1;}return true;}
fn word(source:buf<u8>,node:ntasm_ast.Node,text:buf<u8>)->bool{if node.start>node.end||node.end>len(source)||(node.end-node.start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[node.start+i]!=text[i]{return false;}i=i+1;}return true;}
fn simple_name_id(tree:ntasm_ast.Tree,expr_id:u64)->u64{if expr_id==0||expr_id>tree.node_count{return 0;}let e:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if e.kind!=35||e.aux!=0||e.first_child==0||e.first_child!=e.last_child||e.first_child>tree.node_count{return 0;}let q:ntasm_ast.Node=ntasm_ast.node_at(tree,e.first_child);if q.kind!=91||q.last_child==0||q.last_child>tree.node_count{return 0;}return q.last_child;}
fn named_type(source:buf<u8>,tree:ntasm_ast.Tree,fn_id:u64,name:ntasm_ast.Node,before:u64)->u64{let fn_:ntasm_ast.Node=ntasm_ast.node_at(tree,fn_id);let mut best:u64=0;let mut id:u64=1;while id<=tree.node_count{let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if n.start<before&&fn_.start<=n.start&&n.end<=fn_.end&&(n.kind==19||n.kind==27){let name_id:u64=child(tree,id,0);let type_id:u64=child(tree,id,1);if name_id!=0&&type_id!=0{let candidate:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);if same(source,candidate,name){best=type_id;}}}id=id+1;}return best;}
fn return_type_id(tree:ntasm_ast.Tree,decl_id:u64)->u64{let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,decl_id);let mut id:u64=declaration.first_child;while id!=0{if id>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if n.kind==36{return id;}id=n.next_sibling;}return 0;}
fn decl_name_id(tree:ntasm_ast.Tree,id:u64)->u64{let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if declaration.kind==18{return child(tree,id,0);}if declaration.kind==9{return child(tree,id,1);}return 0;}
fn call_type(source:buf<u8>,tree:ntasm_ast.Tree,expr_id:u64)->u64{let expression:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if expression.kind!=35||expression.aux!=1||expression.first_child==0||expression.first_child>tree.node_count{return 0;}let qualified:ntasm_ast.Node=ntasm_ast.node_at(tree,expression.first_child);if qualified.kind!=91||qualified.last_child==0||qualified.last_child>tree.node_count{return 0;}let called:ntasm_ast.Node=ntasm_ast.node_at(tree,qualified.last_child);let mut id:u64=1;while id<=tree.node_count{let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if declaration.kind==18||declaration.kind==9{let name_id:u64=decl_name_id(tree,id);if name_id!=0{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);if same(source,name,called){return return_type_id(tree,id);}}}id=id+1;}return 0;}
fn comparison(operation:u64)->bool{return operation==262||operation==263||operation==264||operation==265||operation==60||operation==62;}
fn feature_test(source:buf<u8>,tree:ntasm_ast.Tree,expr_id:u64)->bool{let expr:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if expr.kind!=35||expr.aux!=1||expr.first_child==0||expr.first_child>tree.node_count{return false;}let qualified:ntasm_ast.Node=ntasm_ast.node_at(tree,expr.first_child);if qualified.kind!=91||qualified.first_child==0||qualified.first_child!=qualified.last_child||qualified.last_child>tree.node_count{return false;}let name:ntasm_ast.Node=ntasm_ast.node_at(tree,qualified.last_child);let feature:buf<u8>="feature";if word(source,name,feature)==false{return false;}let argument_id:u64=qualified.next_sibling;if argument_id==0||argument_id>tree.node_count{return false;}let argument:ntasm_ast.Node=ntasm_ast.node_at(tree,argument_id);return argument.next_sibling==0;}

// Prove every if condition is boolean. Direct bool literals, names typed bool,
// comparisons, bool-returning local/import calls and the feature(x) target
// predicate are accepted. 357 reports a
// proved non-bool type;358 reports an expression whose type is not yet proved.
// Success writes conditions,literals,names,derived expressions.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let mut conditions:u64=0;let mut literals:u64=0;let mut names:u64=0;let mut derived:u64=0;let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut reason:u64=0;let mut id:u64=1;while id<=tree.node_count&&code==0{let branch:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if branch.kind==30{conditions=conditions+1;let condition_id:u64=child(tree,id,0);if condition_id==0{code=800;}else{let condition:ntasm_ast.Node=ntasm_ast.node_at(tree,condition_id);let true_:buf<u8>="true";let false_:buf<u8>="false";if word(source,condition,true_)||word(source,condition,false_){literals=literals+1;}else if condition.kind==94{code=357;reason=1;}else if condition.kind==35&&comparison(condition.aux){derived=derived+1;}else if feature_test(source,tree,condition_id){derived=derived+1;}else if condition.kind==35&&condition.aux==1{let type_id:u64=call_type(source,tree,condition_id);if type_id==0{code=358;reason=3;}else{let type_:ntasm_ast.Node=ntasm_ast.node_at(tree,type_id);let bool_:buf<u8>="bool";if word(source,type_,bool_){derived=derived+1;}else{code=357;reason=2;}}}else{let name_id:u64=simple_name_id(tree,condition_id);if name_id!=0{let mut owner:u64=0;let mut fn_id:u64=1;while fn_id<=tree.node_count{let fn_:ntasm_ast.Node=ntasm_ast.node_at(tree,fn_id);if fn_.kind==18&&fn_.start<=branch.start&&branch.end<=fn_.end{owner=fn_id;}fn_id=fn_id+1;}if owner==0{code=800;}else{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);let type_id:u64=named_type(source,tree,owner,name,branch.start);if type_id==0{code=358;reason=1;}else{let type_:ntasm_ast.Node=ntasm_ast.node_at(tree,type_id);let bool_:buf<u8>="bool";if word(source,type_,bool_){names=names+1;}else{code=357;reason=2;}}}}else{code=358;reason=2;}}if code!=0{line=condition.line;column=condition.column;}}}id=id+1;}if code==0{out[0]=conditions;out[1]=literals;out[2]=names;out[3]=derived;}else if code==357||code==358{out[0]=line;out[1]=column;out[2]=reason;out[3]=0;}return code;}
