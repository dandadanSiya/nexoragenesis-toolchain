// Deliberately bounded port of NTASM's four-section PE32+ writer.
// This Nova code produces every output byte. The runtime only transports it.
module pe_writer;
struct Section { at:u64,name:buf<u8>,size:u64,rva:u64,raw:u64,flags:u64 }
fn put16(out:buf<u8>,at:u64,value:u64)->u64 {
    out[at]=u8(value);out[at+1]=u8(value>>8);return 0;
}
fn put32(out:buf<u8>,at:u64,value:u64)->u64 {
    let mut i:u64=0;while i<4{out[at+i]=u8(value>>(i*8));i=i+1;}return 0;
}
fn put64(out:buf<u8>,at:u64,value:u64)->u64 {
    let mut i:u64=0;while i<8{out[at+i]=u8(value>>(i*8));i=i+1;}return 0;
}
fn section(out:buf<u8>,s:Section)->u64 {
    let name:buf<u8>=s.name;let mut i:u64=0;
    while i<len(name){out[s.at+i]=name[i];i=i+1;}
    put32(out,s.at+8,s.size);put32(out,s.at+12,s.rva);
    put32(out,s.at+16,512);put32(out,s.at+20,s.raw);put32(out,s.at+36,s.flags);
    rt_free(runtime(),name);rt_free(runtime(),s);return 0;
}
export fn make_return(value:u64)->buf<u8> {
    let out:buf<u8>=alloc(runtime(),3072);
    put16(out,0,0x5a4d);put32(out,60,128);put32(out,128,0x4550);
    put16(out,132,0x8664);put16(out,134,4);put16(out,148,240);put16(out,150,0x2022);
    put16(out,152,0x20b);put32(out,156,512);put32(out,160,1536);
    put32(out,168,4096);put32(out,172,4096);put64(out,176,0x140000000);
    put32(out,184,4096);put32(out,188,512);put16(out,192,6);put16(out,200,6);
    put32(out,208,20480);put32(out,212,1024);put16(out,220,10);put16(out,222,0x160);
    put64(out,224,0x100000);put64(out,232,0x1000);put64(out,240,0x100000);put64(out,248,0x1000);
    put32(out,260,16);put32(out,304,16384);put32(out,308,12);
    let text:Section=Section{at:392,name:".text",size:11,rva:4096,raw:1024,flags:0x60000020};section(out,text);
    let ro:Section=Section{at:432,name:".rdata",size:8,rva:8192,raw:1536,flags:0x40000040};section(out,ro);
    let rw:Section=Section{at:472,name:".data",size:8,rva:12288,raw:2048,flags:0xc0000040};section(out,rw);
    let rel:Section=Section{at:512,name:".reloc",size:12,rva:16384,raw:2560,flags:0x42000040};section(out,rel);
    out[1024]=0x48;out[1025]=0xb8;put64(out,1026,value);out[1034]=0xc3;
    put64(out,1536,0x140001000);put32(out,2560,8192);put32(out,2564,12);put16(out,2568,0xa000);
    return out;
}
