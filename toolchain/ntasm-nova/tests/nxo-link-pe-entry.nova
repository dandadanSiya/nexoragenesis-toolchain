module ntasm_nxo_link_pe_entry;
import ntasm_nxo_link_pe;
import ntasm_nxo_pe;
import ntasm_pe;

fn main(left:buf<u8>,right:buf<u8>,out:buf<u8>)->u64 {
    let result:ntasm_nxo_pe.ConvertResult=ntasm_nxo_link_pe.link_pe(left,right);
    let bytes:buf<u8>=result.bytes;
    if result.code!=0 { rt_free(runtime(),bytes);return result.code; }
    let size:u64=len(bytes);
    if len(out)<8 || size>len(out)-8 { rt_free(runtime(),bytes);return 827; }
    ntasm_pe.copy(out,8,bytes);
    rt_free(runtime(),bytes);
    ntasm_pe.put64(out,0,size);
    return 0;
}
