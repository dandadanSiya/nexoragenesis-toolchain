cmp rax, 0
jne vlb_return
store64 [rsp + 56], r9
mov rcx, rsi
call enclosing_block
store64 [rsp + 48], rax
load64 rcx, [rsp + 56]
call enclosing_block
load64 rdx, [rsp + 48]
cmp rax, rdx
je vlb_duplicate
vlb_unique:
mov rcx, rsi
lea rdx, [rip + name_type]
mov r8, 4
call count_named_children
cmp rax, 1
jne vlb_shape
mov rcx, rdx
call resolve_ast_type
cmp rax, 0
jne vlb_return
cmp rdx, 10
je vlb_shape
store64 [rsp + 40], rdx
mov rcx, rsi
lea rdx, [rip + name_expression]
mov r8, 10
call count_named_children
cmp rax, 1
jne vlb_shape
mov rcx, rdx
load64 rdx, [rsp + 32]
load64 r8, [rsp + 40]
call check_expression_type
cmp rax, 0
jne vlb_return
vlb_advance:
add rsi, 1
jmp vlb_next
vlb_ok:
mov rax, 0
jmp vlb_return
vlb_shape:
mov rax, 508
jmp vlb_return
vlb_duplicate:
mov rax, 518
vlb_return:
add rsp, 64
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret
; Noms locaux : declarations achevees avant usage et bloc ancetre accessible.
lookup_local_type:
push rbx
push rsi
push rdi
sub rsp, 80
mov rbx, rcx
store64 [rsp + 32], rdx
store64 [rsp + 40], r8
store64 [rsp + 48], r9
