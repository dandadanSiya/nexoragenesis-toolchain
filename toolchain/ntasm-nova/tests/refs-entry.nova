module ntasm_refs_test;
import ntasm_parser;
import ntasm_ast;
import semantics;
import ntasm_refs;

fn main(source:buf<u8>,out:buf<u64>)->u64 {
    let tree:ntasm_ast.Tree=ntasm_parser.parse(source,1);
    let index_out:buf<u64>=alloc(runtime(),3);
    let indexed:u64=semantics.index(source,tree,index_out);
    if indexed==300 && len(out)>=2 {
        out[0]=index_out[0];
        out[1]=index_out[1];
    }
    rt_free(runtime(),index_out);
    if indexed!=0 { ntasm_ast.release(tree);return indexed; }
    let code:u64=ntasm_refs.resolve(source,tree,out);
    ntasm_ast.release(tree);
    return code;
}
