// Nexora OS memory: builds the kernel's own page tables (identity map of the
// first 4 GiB with 2 MiB pages) with one 2 MiB window mapped as 4 KiB pages
// for task stacks, each stack preceded by an unmapped guard page. Also sums
// the conventional RAM reported by the firmware.

section .text {
    // Places the stack window at a 2 MiB-aligned address inside the block and
    // remembers it, then builds and installs the page tables.
    export fn paging_setup() -> u64
    FX
    CLOB {
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        // stack window base = block + OFF_STACK_MIN, rounded up to 2 MiB
        load rax,[g_base]:ptr<user,u64>
        add rax,OFF_STACK_MIN
        add rax,0x1fffff
        mov rbx,0xffffffffffe00000
        and rax,rbx
        store [r15+S_STACK_WIN]:ptr<kernel,u64>,rax

        // PML4[0] -> PDPT
        adopt r14,[r15+OFF_PML4]:ptr<kernel,u64>
        load rax,[g_base]:ptr<user,u64>
        add rax,OFF_PDPT
        or rax,3
        store [r14]:ptr<kernel,u64>,rax
        // PDPT[0..3] -> PD[i]
        adopt r14,[r15+OFF_PDPT]:ptr<kernel,u64>
        mov rcx,0
    pdpt:
        load rax,[g_base]:ptr<user,u64>
        add rax,OFF_PD
        mov rdx,rcx
        shl rdx,12
        add rax,rdx
        or rax,3
        store [r14+rcx*8]:ptr<kernel,u64>,rax
        inc rcx
        cmp rcx,4
        jb pdpt
        // PD entries: 2 MiB identity pages for all 2048 entries
        adopt r14,[r15+OFF_PD]:ptr<kernel,u64>
        mov rcx,0
    pd:
        mov rax,rcx
        shl rax,21                 // page * 2 MiB
        or rax,0x83                // P|W|PS
        store [r14+rcx*8]:ptr<kernel,u64>,rax
        inc rcx
        cmp rcx,2048
        jb pd
        // Replace the PD entry covering the stack window with a 4 KiB table.
        load rax,[r15+S_STACK_WIN]:ptr<kernel,u64>
        shr rax,21                 // 2 MiB index
        mov r13,rax                // stack window PD index
        load rax,[g_base]:ptr<user,u64>
        add rax,OFF_STACK_PT
        or rax,3
        store [r14+r13*8]:ptr<kernel,u64>,rax
        // Fill the stack PT: page 0 of each 32-page slot is a guard (absent),
        // the rest map the corresponding physical frames of the window.
        adopt r14,[r15+OFF_STACK_PT]:ptr<kernel,u64>
        load r12,[r15+S_STACK_WIN]:ptr<kernel,u64>
        mov rcx,0
    pt:
        mov rax,rcx
        and rax,31
        cmp rax,0
        je guard
        mov rax,rcx
        shl rax,12
        add rax,r12
        or rax,3
        store [r14+rcx*8]:ptr<kernel,u64>,rax
        jmp pt_next
    guard:
        mov rax,0
        store [r14+rcx*8]:ptr<kernel,u64>,rax
    pt_next:
        inc rcx
        cmp rcx,512
        jb pt
        // install
        load rax,[g_base]:ptr<user,u64>
        add rax,OFF_PML4
        write_cr cr3,rax
        return 0
    }

    // Builds a TSS whose IST1 is a dedicated fault stack, adds its GDT
    // descriptor at selector 0x40 and loads it, so #PF/#DF always land on a
    // known-good stack even when a task overflows its own.
    export fn tss_setup() -> u64
    FX
    CLOB {
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        adopt r14,[r15+OFF_TSS]:ptr<kernel,u64>
        mov rcx,0
    zero:
        mov rax,0
        store [r14+rcx*8]:ptr<kernel,u64>,rax
        inc rcx
        cmp rcx,13
        jb zero
        // fault stack top (grows down through the unused bitmap area)
        load rax,[g_base]:ptr<user,u64>
        add rax,OFF_FAULT_TOP
        // RSP0 at offset 4, IST1 at offset 36
        adopt r13,[r15+OFF_TSS]:ptr<kernel,u32>
        mov rbx,rax
        store [r13+4]:ptr<kernel,u32>,ebx     // RSP0 low  (byte 4)
        mov rcx,rax
        shr rcx,32
        store [r13+8]:ptr<kernel,u32>,ecx     // RSP0 high (byte 8)
        store [r13+36]:ptr<kernel,u32>,ebx    // IST1 low  (byte 36)
        store [r13+40]:ptr<kernel,u32>,ecx    // IST1 high (byte 40)
        // GDT TSS descriptor at index 8 (selector 0x40), 16 bytes
        load rax,[g_base]:ptr<user,u64>
        add rax,OFF_TSS
        mov rbx,103                            // limit
        mov rcx,rax
        and rcx,0xffff
        shl rcx,16
        or rbx,rcx                             // base[15:0]
        mov rcx,rax
        shr rcx,16
        and rcx,0xff
        shl rcx,32
        or rbx,rcx                             // base[23:16]
        mov rcx,0x89
        shl rcx,40
        or rbx,rcx                             // type: available 64-bit TSS
        mov rcx,rax
        shr rcx,24
        and rcx,0xff
        shl rcx,56
        or rbx,rcx                             // base[31:24]
        store [r15+OFF_GDT+64]:ptr<kernel,u64>,rbx
        mov rbx,rax
        shr rbx,32                             // base[63:32]
        store [r15+OFF_GDT+72]:ptr<kernel,u64>,rbx
        mov ax,SEL_TSS
        ltr ax
        return 0
    }

    // Returns the stack top (highest address + 1) for task index r12.
    export fn stack_top(in index:u64 @r12) -> u64
    FX
    CLOB {
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        load rax,[r15+S_STACK_WIN]:ptr<kernel,u64>
        mov rcx,r12
        inc rcx
        shl rcx,5                  // (index+1) * 32 pages
        shl rcx,12
        add rax,rcx
        return rax
    }

    // Sums EfiConventionalMemory (type 7) pages from the saved UEFI map and
    // stores the total (KiB) in S_RAM_KB.
    export fn mem_scan() -> u64
    FX
    CLOB {
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        load r13,[r15+S_MMAP_DESC]:ptr<kernel,u64>
        load r12,[r15+S_MMAP_SIZE]:ptr<kernel,u64>
        mov r11,0                  // offset into the map
        mov r10,0                  // total pages
    entry:
        cmp r11,r12
        jae done
        load r14,[g_base]:ptr<user,u64>
        add r14,OFF_MMAP
        adopt r14,[r14]:ptr<kernel,u64>
        load rax,[r14+r11]:ptr<kernel,u64>       // type in low 32 bits
        shl rax,32
        shr rax,32
        cmp rax,7
        jne skip
        load rcx,[r14+r11+24]:ptr<kernel,u64>    // number of pages
        add r10,rcx
    skip:
        add r11,r13
        jmp entry
    done:
        shl r10,2                  // pages * 4 KiB = KiB
        store [r15+S_RAM_KB]:ptr<kernel,u64>,r10
        return 0
    }
}
