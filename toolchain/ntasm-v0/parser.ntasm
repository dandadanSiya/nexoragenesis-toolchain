case_badbyte_end:
case_composite:
ascii "module examples.composite\ntarget x86_64-nexora-none\ndefault_abi nx64-abi-v0\noutput nxo-v0\n"
ascii "versions {\nntir 0.1\nmachine_ir 0.1\nsections 0.1\nsymbols 0.1\nrelocations 0.1\nnxo 0.1\n}\nfeatures { msr }\n"
ascii "const N: u64 = 1 + 2 * 3 << 1\nconst HEX: u64 = 0x1_0\n"
ascii "macro clear(dst: ast.expr) -> ast.stmt {\nreturn quote (stmt) { xor $dst, $dst }\n}\n"
ascii "comptime (fuel=32, call_depth=2, arena_bytes=1024, ast_nodes=8, expansion_depth=1, constant_bytes=64) {\n"
ascii "emit quote (decl) { const WORDS: u64 = 4 }\n}\nsection .rodata {\ndata value: u64 = N\n}\n"
ascii "import kernel.math.add1 as add1: fn(in x: u64 @rdi) -> u64\nabi nx64-abi-v0\neffects { changes_flags }\n"
ascii "clobbers {rax}\nrequires {}\nensures {}\nsection .text {\nfn f(in p: ptr<kernel,u64> @rdi) -> u64\n"
ascii "effects { reads_mem(kernel), changes_flags }\nclobbers {rax}\nrequires {non_null(p)}\nensures {} {\n"
ascii "// a comment\nlet n: u64 = 0xA_B\nexpand clear(rax)\nload rax, [rdi]:ptr<kernel,u64>\ncall add1(n)\nreturn rax\n}\n}\n"
case_composite_end:
