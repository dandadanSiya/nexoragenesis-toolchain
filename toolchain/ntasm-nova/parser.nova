fn statement(p:Parser)->u64 {
    let begin:u64=ti(p);
    if (keyword(p,32)) {
        let n:u64=node(p,27,begin);step(p);attach(p,n,name(p));
        if (!expect(p,58,4)) { return 0; }attach(p,n,parse_type(p));
        if (!expect(p,61,4)) { return 0; }attach(p,n,parse_expression(p,0));
        if (!term(p)) { return 0; }return finish(p,n);
    }
    if (keyword(p,33)) {
        let n:u64=node(p,28,begin);step(p);attach(p,n,qualified(p));
        if (accept(p,40)) { lines(p);while (tk(p)!=41 && p.code==0) {
            attach(p,n,parse_expression(p,0));lines(p);
            if (!accept(p,44)) { break; }lines(p);
        }if (!expect(p,41,4)) { return 0; }}
        if (!term(p)) { return 0; }return finish(p,n);
    }
    if (keyword(p,34)) {
        let n:u64=node(p,29,begin);step(p);
        if (tk(p)!=59 && tk(p)!=260) { attach(p,n,parse_expression(p,0)); }
        if (!term(p)) { return 0; }return finish(p,n);
    }
    if (keyword(p,35)) {
        let n:u64=node(p,30,begin);step(p);attach(p,n,parse_expression(p,0));
        lines(p);attach(p,n,block(p));lines(p);
        if (keyword(p,36)) { step(p);lines(p);attach(p,n,block(p)); }
        return finish(p,n);
    }
    if (keyword(p,38)) {
        let n:u64=node(p,31,begin);step(p);attach(p,n,name(p));
        if (!expect(p,40,4)) { return 0; }lines(p);
        while (tk(p)!=41 && p.code==0) { attach(p,n,meta_value(p));lines(p);
            if (!accept(p,44)) { break; }lines(p); }
        if (!expect(p,41,4) || !term(p)) { return 0; }return finish(p,n);
    }
    if (tk(p)==257) {
        let n:u64=node(p,32,begin);attach(p,n,name(p));
        if (accept(p,58)) { aux(p,n,1);if (!term(p)) { return 0; }return finish(p,n); }
        while (tk(p)!=59 && tk(p)!=260 && tk(p)!=125 && p.code==0) {
            attach(p,n,operand(p));if (!accept(p,44)) { break; }
        }
        if (!term(p)) { return 0; }return finish(p,n);
    }
    error(p,8);return 0;
}
fn function_decl(p:Parser,exported:bool)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,18,begin);
    if (exported==true) { aux(p,result,1); }
    if (!take_word(p,15,4)) { return 0; }attach(p,result,name(p));
    if (!parameters(p,result) || !expect(p,261,4)) { return 0; }
    attach(p,result,parse_type(p));if (!term(p)) { return 0; }
    if (!contracts(p,result)) { return 0; }lines(p);attach(p,result,block(p));
    return finish(p,result);
