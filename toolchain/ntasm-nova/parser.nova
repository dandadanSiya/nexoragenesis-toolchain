module ntasm_parser;
import ntasm_lexer;
import ntasm_ast;

struct Parser {
    source:buf<u8>,tokens:buf<u64>,token_count:u64,cursor:u64,split_gt:bool,
    nodes:buf<u64>,node_count:u64,words:buf<u8>,
    code:u64,reason:u64,error_source:u64,error_line:u64,error_column:u64,
    error_start:u64,error_end:u64,optional_term:bool
}

fn tk(p:Parser)->u64 {
    if (p.split_gt==true) { return 62; }
    let tokens:buf<u64>=p.tokens;
    return tokens[p.cursor*9];
}
fn ti(p:Parser)->u64 {
    if (p.split_gt==true) { return p.cursor-1; }
    return p.cursor;
}
fn tf(p:Parser,index:u64,field:u64)->u64 {
    let tokens:buf<u64>=p.tokens;return tokens[index*9+field];
}
fn step(p:Parser)->u64 {
    if (p.split_gt==true) { p.split_gt=false;return 0; }
    if (p.cursor+1<(p.token_count)) { p.cursor=p.cursor+1; }
    return 0;
}
fn error(p:Parser,reason:u64)->u64 {
    if (p.code!=0) { return 0; }
    let index:u64=ti(p);
    p.code=200;p.reason=reason;p.error_source=tf(p,index,2);
    p.error_line=tf(p,index,3);p.error_column=tf(p,index,4);
    p.error_start=tf(p,index,5);p.error_end=tf(p,index,6);return 0;
}
fn accept(p:Parser,kind:u64)->bool {
    if (tk(p)!=kind) { return false; }step(p);return true;
}
fn expect(p:Parser,kind:u64,reason:u64)->bool {
    if (accept(p,kind)) { return true; }error(p,reason);return false;
}
fn keyword(p:Parser,id:u64)->bool {
    if (tk(p)!=257) { return false; }
    let words:buf<u8>=p.words;
    let mut at:u64=0;let mut current:u64=1;
    while (current<(id)) {
        while (words[at]!=0) { at=at+1; }
        at=at+1;current=current+1;
    }
    let mut length:u64=0;
    while (words[at+length]!=0) { length=length+1; }
    let token:u64=ti(p);
    if (tf(p,token,8)!=length) { return false; }
    let start:u64=tf(p,token,7);let source:buf<u8>=p.source;
    let mut i:u64=0;
    while (i<(length)) {
        if (source[start+i]!=words[at+i]) { return false; }i=i+1;
    }
    return true;
}
fn take_word(p:Parser,id:u64,reason:u64)->bool {
    if (keyword(p,id)) { step(p);return true; }error(p,reason);return false;
}
fn lines(p:Parser)->u64 { while (tk(p)==260) { step(p); }return 0; }
fn term(p:Parser)->bool {
    if (accept(p,59)) { lines(p);return true; }
    if (p.optional_term==true && tk(p)==125) { return true; }
    if (!accept(p,260)) { error(p,5);return false; }
    lines(p);return true;
}
fn node(p:Parser,kind:u64,begin:u64)->u64 {
    if (p.node_count>=p.token_count*2+16) { error(p,12);return 0; }
    let id:u64=p.node_count+1;p.node_count=id;
    let nodes:buf<u64>=p.nodes;let at:u64=(id-1)*12;
    nodes[at]=kind;nodes[at+1]=begin;nodes[at+2]=begin;
    nodes[at+3]=tf(p,begin,2);nodes[at+4]=tf(p,begin,3);
    nodes[at+5]=tf(p,begin,4);nodes[at+6]=tf(p,begin,5);
    nodes[at+7]=tf(p,begin,6);nodes[at+8]=0;nodes[at+9]=0;
    nodes[at+10]=0;nodes[at+11]=0;return id;
}
fn aux(p:Parser,id:u64,value:u64)->u64 {
    let nodes:buf<u64>=p.nodes;nodes[(id-1)*12+11]=value;return 0;
}
fn attach(p:Parser,parent:u64,child:u64)->u64 {
    if (child==0) { return 0; }
    let nodes:buf<u64>=p.nodes;let at:u64=(parent-1)*12;
    let last:u64=nodes[at+9];
    if (last==0) { nodes[at+8]=child; } else { nodes[(last-1)*12+10]=child; }
    nodes[at+9]=child;return child;
}
fn finish(p:Parser,id:u64)->u64 {
    let mut end_token:u64=ti(p);
    if (p.split_gt==false && p.cursor>0) { end_token=p.cursor-1; }
    let nodes:buf<u64>=p.nodes;let at:u64=(id-1)*12;
    nodes[at+2]=end_token;nodes[at+7]=tf(p,end_token,6);return id;
}
fn name(p:Parser)->u64 {
    let begin:u64=ti(p);if (!expect(p,257,3)) { return 0; }
    return finish(p,node(p,90,begin));
}
fn qualified(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,91,begin);
    attach(p,result,name(p));
    while (accept(p,46)) { attach(p,result,name(p)); }
    return finish(p,result);
}
fn dashed(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,92,begin);
    attach(p,result,name(p));
    while (accept(p,45)) { attach(p,result,name(p)); }
    return finish(p,result);
}
fn section_name(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,93,begin);
    if (!expect(p,46,4)) { return 0; }attach(p,result,name(p));
    return finish(p,result);
}
fn type_close(p:Parser)->bool {
    if (tk(p)==267) {
        p.cursor=p.cursor+1;p.split_gt=true;return true;
    }
    return expect(p,62,10);
}
fn parse_type(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,36,begin);
    if (keyword(p,38)) {
        step(p);attach(p,result,name(p));
        if (!expect(p,40,4)) { return 0; }
        while (tk(p)!=41 && p.code==0) {
            attach(p,result,parse_expression(p,0));
            if (!accept(p,44)) { break; }lines(p);
        }
        if (!expect(p,41,4)) { return 0; }
        aux(p,result,3);return finish(p,result);
    }
    if (keyword(p,40)) {
        step(p);if (!expect(p,60,10)) { return 0; }
        attach(p,result,name(p));if (!expect(p,44,10)) { return 0; }
        lines(p);attach(p,result,parse_type(p));
        if (!type_close(p)) { return 0; }aux(p,result,1);return finish(p,result);
    }
    if (keyword(p,41)) {
        step(p);if (!expect(p,60,10)) { return 0; }
        attach(p,result,parse_type(p));if (!expect(p,44,10)) { return 0; }
        lines(p);if (tk(p)!=258) { error(p,10);return 0; }
        attach(p,result,literal(p));if (!type_close(p)) { return 0; }
        aux(p,result,2);return finish(p,result);
    }
    if (tk(p)==36) {
        step(p);attach(p,result,name(p));aux(p,result,4);return finish(p,result);
    }
    if (tk(p)!=257) { error(p,10);return 0; }
    // Scalar/bool/never names are validated by the later type checker.
    attach(p,result,name(p));return finish(p,result);
}
fn literal(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,94,begin);
    aux(p,result,tf(p,begin,1));step(p);return finish(p,result);
}
fn primary(p:Parser)->u64 {
    let begin:u64=ti(p);
    if (tk(p)==258 || tk(p)==259) { return literal(p); }
    if (accept(p,40)) {
        let result:u64=node(p,35,begin);aux(p,result,40);
        attach(p,result,parse_expression(p,0));
        if (!expect(p,41,9)) { return 0; }return finish(p,result);
    }
    if (accept(p,36)) {
        let result:u64=node(p,35,begin);aux(p,result,36);
        attach(p,result,name(p));return finish(p,result);
    }
    if (keyword(p,39)) {
        let result:u64=node(p,35,begin);aux(p,result,40);step(p);
        attach(p,result,qualified(p));
        if (!expect(p,40,9)) { return 0; }lines(p);
        while (tk(p)!=41 && p.code==0) {
            attach(p,result,parse_expression(p,0));lines(p);
            if (!accept(p,44)) { break; }lines(p);
        }
        if (!expect(p,41,9)) { return 0; }return finish(p,result);
    }
    if (keyword(p,38)) {
        let result:u64=node(p,31,begin);step(p);attach(p,result,name(p));
        if (!expect(p,40,9)) { return 0; }lines(p);
        while (tk(p)!=41 && p.code==0) {
            attach(p,result,meta_value(p));lines(p);
            if (!accept(p,44)) { break; }lines(p);
        }
        if (!expect(p,41,9)) { return 0; }return finish(p,result);
    }
    if (tk(p)==257) {
        let result:u64=node(p,35,begin);attach(p,result,qualified(p));
        if (accept(p,40)) {
            aux(p,result,1);lines(p);
            while (tk(p)!=41 && p.code==0) {
                attach(p,result,parse_expression(p,0));lines(p);
                if (!accept(p,44)) { break; }lines(p);
            }
            if (!expect(p,41,9)) { return 0; }
        }
        return finish(p,result);
    }
    error(p,9);return 0;
}
fn precedence(kind:u64)->u64 {
    if kind==269{return 1;}
    if kind==268{return 2;}
    if kind==262 || kind==263 || kind==264 || kind==265 ||
       kind==60 || kind==62 { return 3; }
    if (kind==124) { return 6; }if (kind==94) { return 9; }
    if (kind==38) { return 12; }if (kind==266 || kind==267) { return 15; }
    if (kind==43 || kind==45) { return 18; }
    if (kind==42 || kind==47 || kind==37) { return 21; }
    return 0;
}
fn parse_expression(p:Parser,min:u64)->u64 {
    let begin:u64=ti(p);let mut left:u64=0;
    let kind:u64=tk(p);
    if (kind==43 || kind==45 || kind==126 || kind==33) {
        step(p);left=node(p,35,begin);aux(p,left,kind);
        attach(p,left,parse_expression(p,22));finish(p,left);
    } else { left=primary(p); }
    let mut used_comparison:bool=false;
    while (p.code==0) {
        let operation:u64=tk(p);let rank:u64=precedence(operation);
        if (rank==0 || rank<(min)) { break; }
        if (rank==3 && used_comparison==true) { break; }
        if (rank==3) { used_comparison=true; }
        step(p);let parent:u64=node(p,35,begin);aux(p,parent,operation);
        attach(p,parent,left);attach(p,parent,parse_expression(p,rank+1));
        left=finish(p,parent);
    }
    return left;
}
fn memory(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,34,begin);
    if (!expect(p,91,4)) { return 0; }
    if (keyword(p,75) || keyword(p,76)) {
        attach(p,result,name(p));if (!expect(p,58,4)) { return 0; }
    }
    while (tk(p)!=93 && p.code==0) {
        if (tk(p)==257) { attach(p,result,qualified(p)); }
        else if (tk(p)==258) { attach(p,result,literal(p)); }
        else { error(p,9);return 0; }
        if (accept(p,42)) {
            if (tk(p)!=258) { error(p,9);return 0; }attach(p,result,literal(p));
        }
        if (tk(p)!=43 && tk(p)!=45) { break; }step(p);
    }
    if (!expect(p,93,4) || !expect(p,58,4)) { return 0; }
    attach(p,result,parse_type(p));return finish(p,result);
}
fn operand(p:Parser)->u64 {
    if (tk(p)==91) { return memory(p); }return parse_expression(p,0);
}
fn set_node(p:Parser,kind:u64)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,kind,begin);
    if (!expect(p,123,4)) { return 0; }lines(p);
    while (tk(p)!=125 && p.code==0) {
        attach(p,result,qualified(p));lines(p);
        if (accept(p,40)) {
            lines(p);attach(p,result,qualified(p));lines(p);
            if (!expect(p,41,4)) { return 0; }lines(p);
        }
        if (!accept(p,44)) { break; }lines(p);
    }
    if (!expect(p,125,4)) { return 0; }return finish(p,result);
}
fn predicate_set(p:Parser,kind:u64)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,kind,begin);
    if (!expect(p,123,4)) { return 0; }lines(p);
    while (tk(p)!=125 && p.code==0) {
        let pred:u64=node(p,33,ti(p));attach(p,pred,qualified(p));
        if (!expect(p,40,4)) { return 0; }lines(p);
        while (tk(p)!=41 && p.code==0) {
            attach(p,pred,parse_expression(p,0));lines(p);
            if (!accept(p,44)) { break; }lines(p);
        }
        if (!expect(p,41,4)) { return 0; }attach(p,result,finish(p,pred));
        lines(p);if (!accept(p,44)) { break; }lines(p);
    }
    if (!expect(p,125,4)) { return 0; }return finish(p,result);
}
fn contracts(p:Parser,parent:u64)->bool {
    if (keyword(p,28)) {
        let n:u64=node(p,28,ti(p));step(p);attach(p,n,dashed(p));
        if (!term(p)) { return false; }attach(p,parent,finish(p,n));
    }
    if (!take_word(p,24,4)) { return false; }
    attach(p,parent,set_node(p,20));if (!term(p)) { return false; }
    if (!take_word(p,25,4)) { return false; }
    attach(p,parent,set_node(p,21));
    if (tk(p)==59 || tk(p)==260) { if (!term(p)) { return false; } } else { lines(p); }
    if (keyword(p,26)) {
        let n:u64=node(p,22,ti(p));step(p);attach(p,n,predicate_set(p,22));
        attach(p,parent,finish(p,n));
        if tk(p)==59 || tk(p)==260 { if (!term(p)) { return false; } }
        else { lines(p); }
    }
    if (keyword(p,27)) {
        let n:u64=node(p,23,ti(p));step(p);attach(p,n,predicate_set(p,23));
        attach(p,parent,finish(p,n));if (tk(p)==59 || tk(p)==260) { term(p); }
    }
    return p.code==0;
}
fn parameters(p:Parser,parent:u64)->bool {
    if (!expect(p,40,4)) { return false; }lines(p);
    while (tk(p)!=41 && p.code==0) {
        let n:u64=node(p,19,ti(p));
        if (keyword(p,29) || keyword(p,30) || keyword(p,31)) { step(p); }
        else { error(p,4);return false; }
        attach(p,n,name(p));if (!expect(p,58,4)) { return false; }
        attach(p,n,parse_type(p));if (accept(p,64)) { attach(p,n,name(p)); }
        attach(p,parent,finish(p,n));lines(p);
        if (!accept(p,44)) { break; }lines(p);
    }
    return expect(p,41,4);
}
fn block(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,25,begin);
    if (!expect(p,123,4)) { return 0; }lines(p);
    while (tk(p)!=125 && tk(p)!=256 && p.code==0) {
        attach(p,result,statement(p));lines(p);
    }
    if (!expect(p,125,4)) { return 0; }return finish(p,result);
