module register_bindings_entry;

import ntasm_ast;
import ntasm_parser;
import semantics;
import callable_names;
import parameters;
import register_bindings;

// Parse the source, run the preceding checks against a three-word
// scratch buffer, then run the explicit register binding check into
// the caller output. Codes and positions from the earlier stages are
// propagated verbatim. The scratch buffer and the tree are always
// released; neither source nor out is owned.
export fn main(source:buf<u8>,out:buf<u64>)->u64 {
    let tree:ntasm_ast.Tree=ntasm_parser.parse(source,1);
    if tree.ok==false {
        ntasm_ast.release(tree);
        return 800;
    }

    let scratch:buf<u64>=alloc(runtime(),3);
    let mut code:u64=semantics.index(source,tree,scratch);
    if code==0 { code=callable_names.check(source,tree,scratch); }
    if code==0 { code=parameters.check(source,tree,scratch); }

    if code==0 {
        code=register_bindings.check(source,tree,out);
    } else if len(out)>=2 {
        // Propagate the failing stage code and position.
        out[0]=scratch[0];
        out[1]=scratch[1];
    }

    rt_free(runtime(),scratch);
    ntasm_ast.release(tree);
    return code;
}
