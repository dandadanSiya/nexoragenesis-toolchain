// Nexora OS text console: an 80x30 character grid rendered to the linear
// framebuffer with the generated 8x16 font. Row 0 is a status bar; the rest
// scrolls. Colours are palette indices resolved through the pixel LUT.
//
// The NTASM verifier requires a memory operand's element type to match its
// base pointer, so each routine keeps two adopted views of the state block:
// a u64 view for the S_* fields and a u8 view for the character grid.

section .text {
    export fn con_palette() -> u64
    FX
    CLOB {
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        adopt r14,[r15+OFF_LUT]:ptr<kernel,u32>
        lea rsi,[palette]:ptr<user,array<u8,PALETTE_LEN>>
        load r13,[r15+S_FB_FORMAT]:ptr<kernel,u64>
        mov rcx,0
        mov rdi,0
    next:
        movzx eax,[rsi+rdi]:ptr<user,u8>
        movzx ebx,[rsi+rdi+1]:ptr<user,u8>
        movzx edx,[rsi+rdi+2]:ptr<user,u8>
        cmp r13,1
        je bgr
        shl rdx,16
        shl rbx,8
        or rax,rbx
        or rax,rdx
        jmp put
    bgr:
        shl rax,16
        shl rbx,8
        or rax,rbx
        or rax,rdx
    put:
        store [r14+rcx*4]:ptr<kernel,u32>,eax
        add rdi,3
        inc rcx
        cmp rcx,256
        jb next
        return 0
    }

    export fn con_clear() -> u64
    FX
    CLOB {
        load r14,[g_base]:ptr<user,u64>
        adopt r14,[r14]:ptr<kernel,u8>
        adopt r15,[r14]:ptr<kernel,u64>
        mov rcx,0
    cell:
        mov al,32
        store [r14+rcx+CON_CHARS]:ptr<kernel,u8>,al
        mov al,C_FG
        store [r14+rcx+CON_COLORS]:ptr<kernel,u8>,al
        inc rcx
        cmp rcx,CON_CELLS
        jb cell
        mov rax,0
        store [r15+S_CON_X]:ptr<kernel,u64>,rax
        mov rax,1
        store [r15+S_CON_Y]:ptr<kernel,u64>,rax
        mov rax,C_FG
        store [r15+S_CON_COLOR]:ptr<kernel,u64>,rax
        return 0
    }

    fn con_scroll() -> u64
    FX
    CLOB {
        load r14,[g_base]:ptr<user,u64>
        adopt r14,[r14]:ptr<kernel,u8>
        mov rcx,160
    move:
        movzx eax,[r14+rcx+CON_CHARS]:ptr<kernel,u8>
        mov rdx,rcx
        sub rdx,CON_COLS
        store [r14+rdx+CON_CHARS]:ptr<kernel,u8>,al
        movzx eax,[r14+rcx+CON_COLORS]:ptr<kernel,u8>
        store [r14+rdx+CON_COLORS]:ptr<kernel,u8>,al
        inc rcx
        cmp rcx,CON_CELLS
        jb move
        mov rcx,2320
    blank:
        mov al,32
        store [r14+rcx+CON_CHARS]:ptr<kernel,u8>,al
        mov al,C_FG
        store [r14+rcx+CON_COLORS]:ptr<kernel,u8>,al
        inc rcx
        cmp rcx,CON_CELLS
        jb blank
        return 0
    }

    export fn con_char(in ch:u64 @r12) -> u64
    FX
    CLOB {
        load r14,[g_base]:ptr<user,u64>
        adopt r14,[r14]:ptr<kernel,u8>
        adopt r15,[r14]:ptr<kernel,u64>
        cmp r12,10
        je newline
        cmp r12,8
        je backspace
        cmp r12,13
        je done
        cmp r12,9
        je tab
        cmp r12,32
        jb done
        load rax,[r15+S_CON_Y]:ptr<kernel,u64>
        imul rax,rax,CON_COLS
        load rcx,[r15+S_CON_X]:ptr<kernel,u64>
        add rax,rcx
        store [r14+rax+CON_CHARS]:ptr<kernel,u8>,r12b
        load rdx,[r15+S_CON_COLOR]:ptr<kernel,u64>
        store [r14+rax+CON_COLORS]:ptr<kernel,u8>,dl
        inc rcx
        store [r15+S_CON_X]:ptr<kernel,u64>,rcx
        cmp rcx,CON_COLS
        jb done
    newline:
        mov rax,0
        store [r15+S_CON_X]:ptr<kernel,u64>,rax
        load rax,[r15+S_CON_Y]:ptr<kernel,u64>
        inc rax
        cmp rax,CON_ROWS
        jb set_y
        call con_scroll()
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        mov rax,29
    set_y:
        store [r15+S_CON_Y]:ptr<kernel,u64>,rax
        jmp done
    backspace:
        load rcx,[r15+S_CON_X]:ptr<kernel,u64>
        cmp rcx,0
        je done
        dec rcx
        store [r15+S_CON_X]:ptr<kernel,u64>,rcx
        load rax,[r15+S_CON_Y]:ptr<kernel,u64>
        imul rax,rax,CON_COLS
        add rax,rcx
        mov dl,32
        store [r14+rax+CON_CHARS]:ptr<kernel,u8>,dl
        jmp done
    tab:
        mov r12,32
        call con_char(r12)
        mov r12,32
        call con_char(r12)
    done:
        return 0
    }

    export fn con_color(in color:u64 @r12) -> u64
    FX
    CLOB {
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        store [r15+S_CON_COLOR]:ptr<kernel,u64>,r12
        return 0
    }

    export fn con_write(in text:u64 @r12) -> u64
    FX
    CLOB {
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        store [r15+SV_A]:ptr<kernel,u64>,r12
    loop:
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        load rsi,[r15+SV_A]:ptr<kernel,u64>
        adopt rsi,[rsi]:ptr<user,u8>
        movzx r12d,[rsi]:ptr<user,u8>
        cmp r12,0
        je done
        load rax,[r15+SV_A]:ptr<kernel,u64>
        inc rax
        store [r15+SV_A]:ptr<kernel,u64>,rax
        call con_char(r12)
        jmp loop
    done:
        return 0
    }

    export fn con_str(in offset:u64 @r12) -> u64
    FX
    CLOB {
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        store [r15+SV_B]:ptr<kernel,u64>,r12
    loop:
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        load rcx,[r15+SV_B]:ptr<kernel,u64>
        lea rsi,[strings]:ptr<user,array<u8,STRINGS_LEN>>
        movzx r12d,[rsi+rcx]:ptr<user,u8>
        cmp r12,0
        je done
        inc rcx
        store [r15+SV_B]:ptr<kernel,u64>,rcx
        call con_char(r12)
        jmp loop
    done:
        return 0
    }

    export fn con_dec(in value:u64 @r12) -> u64
    FX
    CLOB {
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        adopt r14,[r15]:ptr<kernel,u8>
        store [r15+SV_C]:ptr<kernel,u64>,r12
        mov r13,0
        store [r15+SV_C+8]:ptr<kernel,u64>,r13
    split:
        load r12,[r15+SV_C]:ptr<kernel,u64>
        mov rax,r12
        mov rcx,0xcccccccccccccccd
        mul rcx
        shr rdx,3
        store [r15+SV_C]:ptr<kernel,u64>,rdx
        imul rcx,rdx,10
        mov rbx,r12
        sub rbx,rcx
        add rbx,48
        load r13,[r15+SV_C+8]:ptr<kernel,u64>
        store [r14+r13+SV_C+16]:ptr<kernel,u8>,bl
        inc r13
        store [r15+SV_C+8]:ptr<kernel,u64>,r13
        cmp rdx,0
        jne split
    emit:
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        adopt r14,[r15]:ptr<kernel,u8>
        load r13,[r15+SV_C+8]:ptr<kernel,u64>
        cmp r13,0
        je done
        dec r13
        store [r15+SV_C+8]:ptr<kernel,u64>,r13
        movzx r12d,[r14+r13+SV_C+16]:ptr<kernel,u8>
        call con_char(r12)
        jmp emit
    done:
        return 0
    }

    export fn con_hex(in value:u64 @r12) -> u64
    FX
    CLOB {
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        store [r15+SV_D]:ptr<kernel,u64>,r12
        mov r13,60
        store [r15+SV_D+8]:ptr<kernel,u64>,r13
    digit:
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        load r12,[r15+SV_D]:ptr<kernel,u64>
        load r13,[r15+SV_D+8]:ptr<kernel,u64>
        mov rcx,r13
        mov rax,r12
        shr rax,cl
        and rax,15
        cmp rax,10
        jb decimal
        add rax,39
    decimal:
        add rax,48
        mov r12,rax
        call con_char(r12)
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        load r13,[r15+SV_D+8]:ptr<kernel,u64>
        sub r13,4
        store [r15+SV_D+8]:ptr<kernel,u64>,r13
        jns digit
        return 0
    }

    export fn con_at(in col:u64 @r12, in row:u64 @r13) -> u64
    FX
    CLOB {
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        store [r15+S_CON_X]:ptr<kernel,u64>,r12
        store [r15+S_CON_Y]:ptr<kernel,u64>,r13
        return 0
    }

    // Writes one character+colour at (col r12, row r13) without moving the
    // cursor. Used by background tasks so they never disturb typing.
    export fn con_poke(in col:u64 @r12, in row:u64 @r13, in ch:u64 @r14, in color:u64 @r8) -> u64
    FX
    CLOB {
        load rbx,[g_base]:ptr<user,u64>
        adopt rbx,[rbx]:ptr<kernel,u8>
        mov rax,r13
        imul rax,rax,CON_COLS
        add rax,r12
        store [rbx+rax+CON_CHARS]:ptr<kernel,u8>,r14b
        store [rbx+rax+CON_COLORS]:ptr<kernel,u8>,r8b
        return 0
    }

    // Renders the whole 80x30 grid to the framebuffer. Persistent values
    // live in spill slots so the pixel math has every register free.
    export fn con_blit() -> u64
    FX
    CLOB {
        load r15,[g_base]:ptr<user,u64>
        adopt r15,[r15]:ptr<kernel,u64>
        load rbx,[g_base]:ptr<user,u64>
        store [r15+SV_E]:ptr<kernel,u64>,rbx
        load rax,[r15+S_FB]:ptr<kernel,u64>
        store [r15+SV_E+8]:ptr<kernel,u64>,rax
        load rax,[r15+S_FB_STRIDE]:ptr<kernel,u64>
        store [r15+SV_E+16]:ptr<kernel,u64>,rax
        load rax,[g_base]:ptr<user,u64>
        add rax,OFF_LUT
        store [r15+SV_E+24]:ptr<kernel,u64>,rax
        load rax,[r15+S_ORIGIN_Y]:ptr<kernel,u64>
        load rbx,[r15+S_FB_STRIDE]:ptr<kernel,u64>
        imul rax,rbx
        load rcx,[r15+S_ORIGIN_X]:ptr<kernel,u64>
        shl rcx,2
        add rax,rcx
        store [r15+SV_E+56]:ptr<kernel,u64>,rax
        mov r9,0
        mov r12,0
    cell_loop:
        load r14,[r15+SV_E]:ptr<kernel,u64>
        adopt r14,[r14]:ptr<kernel,u8>
        movzx eax,[r14+r9+CON_CHARS]:ptr<kernel,u8>
        sub rax,32
        cmp rax,95
        jb glyph_ok
        mov rax,0
    glyph_ok:
        shl rax,4
        store [r15+SV_E+40]:ptr<kernel,u64>,rax
        movzx eax,[r14+r9+CON_COLORS]:ptr<kernel,u8>
        load rdx,[r15+SV_E+24]:ptr<kernel,u64>
        adopt rdx,[rdx]:ptr<kernel,u32>
        load eax,[rdx+rax*4]:ptr<kernel,u32>
        store [r15+SV_E+48]:ptr<kernel,u64>,rax
        load rax,[r15+SV_E+56]:ptr<kernel,u64>
        mov rbx,r12
        shl rbx,5
        add rax,rbx
        store [r15+SV_E+32]:ptr<kernel,u64>,rax
        mov r13,0
    row:
        load rax,[r15+SV_E+40]:ptr<kernel,u64>
        add rax,r13
        lea rbx,[font]:ptr<user,array<u8,FONT_LEN>>
        movzx r11d,[rbx+rax]:ptr<user,u8>
        mov r10,0
    col:
        mov rax,r11
        mov rcx,r10
        shl rax,cl
        test rax,128
        je background
        load r8,[r15+SV_E+48]:ptr<kernel,u64>
        jmp plot
    background:
        load rdx,[r15+SV_E+24]:ptr<kernel,u64>
        adopt rdx,[rdx]:ptr<kernel,u32>
        load r8d,[rdx]:ptr<kernel,u32>
    plot:
        load rax,[r15+SV_E+32]:ptr<kernel,u64>
        mov rcx,r13
        load rdx,[r15+SV_E+16]:ptr<kernel,u64>
        imul rcx,rdx
        add rax,rcx
        mov rcx,r10
        shl rcx,2
        add rax,rcx
        load rdi,[r15+SV_E+8]:ptr<kernel,u64>
        adopt rdi,[rdi]:ptr<device,u32>
        store [rdi+rax]:ptr<device,u32>,r8d
        inc r10
        cmp r10,8
        jb col
        inc r13
        cmp r13,16
        jb row
        inc r9
        inc r12
        cmp r12,CON_COLS
        jb same_row
        mov r12,0
        load rax,[r15+SV_E+56]:ptr<kernel,u64>
        load rbx,[r15+SV_E+16]:ptr<kernel,u64>
        shl rbx,4
        add rax,rbx
        store [r15+SV_E+56]:ptr<kernel,u64>,rax
    same_row:
        cmp r9,CON_CELLS
        jb cell_loop
        return 0
    }
}
