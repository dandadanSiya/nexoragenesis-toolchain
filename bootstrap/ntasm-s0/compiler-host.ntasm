and rax, 4
je io_verify_final
load64 rcx, [rbp + 32]
load64 rax, [rcx + 0x10]
cmp rax, 0
je io_close_root_missing
call rax
jmp io_close_root_status
io_close_root_missing:
mov rax, 0x8000000000000007
io_close_root_status:
mov rcx, 2
call io_first_error
io_verify_final:
call io_check_guards
cmp rax, 0
je io_free_out
mov rax, 603
store64 [rbp + 72], rax
mov rax, 0
store64 [rbp + 80], rax
store64 [rbp + 88], rax
store64 [rbp + 96], rax
mov rax, 0x8000000000000001
store64 [rbp + 104], rax
io_free_out:
