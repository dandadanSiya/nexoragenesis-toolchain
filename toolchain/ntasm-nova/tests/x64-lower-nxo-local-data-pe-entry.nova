module x64_lower_nxo_local_data_pe_entry;
import ntasm_ast;
import ntasm_parser;
import ntasm_nxo;
import ntasm_nxo_pe;
import ntasm_pe;
import x64_lower_nxo;
import x64_lower_nxo_pe;

export fn main(source:buf<u8>,out:buf<u8>)->u64 {
    if len(out)<16{return 827;}
    let tree:ntasm_ast.Tree=ntasm_parser.parse(source,1);
    if tree.ok==false{ntasm_ast.release(tree);return 800;}
    let result:ntasm_nxo_pe.ConvertResult=
        x64_lower_nxo_pe.build_local_helper_call_with_scalar_data(source,tree,1,3);
    let bytes:buf<u8>=result.bytes;
    if result.code!=0{rt_free(runtime(),bytes);ntasm_ast.release(tree);return result.code;}
    let object:ntasm_nxo.WriteResult=
        x64_lower_nxo.build_local_helper_call_with_scalar_data(source,tree,1,3);
    ntasm_ast.release(tree);
    let nxo:buf<u8>=object.bytes;
    if object.code!=0{rt_free(runtime(),nxo);rt_free(runtime(),bytes);return object.code;}
    let nxo_size:u64=len(nxo);let pe_size:u64=len(bytes);
    if nxo_size>len(out)-16||pe_size>len(out)-16-nxo_size{
        rt_free(runtime(),nxo);rt_free(runtime(),bytes);return 827;
    }
    ntasm_pe.put64(out,0,nxo_size);ntasm_pe.put64(out,8,pe_size);
    ntasm_pe.copy(out,16,nxo);ntasm_pe.copy(out,16+nxo_size,bytes);
    rt_free(runtime(),nxo);rt_free(runtime(),bytes);return 0;
}
