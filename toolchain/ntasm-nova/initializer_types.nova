module initializer_types;
import ntasm_ast;
fn child(tree:ntasm_ast.Tree,parent:u64,ordinal:u64)->u64{if parent==0||parent>tree.node_count{return 0;}let p:ntasm_ast.Node=ntasm_ast.node_at(tree,parent);let mut id:u64=p.first_child;let mut index:u64=0;while id!=0&&index<ordinal{if id>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);id=n.next_sibling;index=index+1;}if id>tree.node_count{return 0;}return id;}
fn same(source:buf<u8>,a:ntasm_ast.Node,b:ntasm_ast.Node)->bool{if a.start>a.end||b.start>b.end||a.end>len(source)||b.end>len(source)||(a.end-a.start)!=(b.end-b.start){return false;}let mut i:u64=0;while i<(a.end-a.start){if source[a.start+i]!=source[b.start+i]{return false;}i=i+1;}return true;}
fn word(source:buf<u8>,node:ntasm_ast.Node,text:buf<u8>)->bool{if node.start>node.end||node.end>len(source)||(node.end-node.start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[node.start+i]!=text[i]{return false;}i=i+1;}return true;}
fn simple_name_id(tree:ntasm_ast.Tree,expr_id:u64)->u64{if expr_id==0||expr_id>tree.node_count{return 0;}let expression:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if expression.kind!=35||expression.aux!=0||expression.first_child==0||expression.first_child!=expression.last_child||expression.first_child>tree.node_count{return 0;}let qualified:ntasm_ast.Node=ntasm_ast.node_at(tree,expression.first_child);if qualified.kind!=91||qualified.last_child==0||qualified.last_child>tree.node_count{return 0;}return qualified.last_child;}
fn named_type(source:buf<u8>,tree:ntasm_ast.Tree,fn_id:u64,name:ntasm_ast.Node,before:u64)->u64{let fn_:ntasm_ast.Node=ntasm_ast.node_at(tree,fn_id);let mut best:u64=0;let mut id:u64=1;while id<=tree.node_count{let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if n.start<before&&fn_.start<=n.start&&n.end<=fn_.end&&(n.kind==19||n.kind==27){let name_id:u64=child(tree,id,0);let type_id:u64=child(tree,id,1);if name_id!=0&&type_id!=0{let candidate:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);if same(source,candidate,name){best=type_id;}}}id=id+1;}return best;}
fn return_type_id(tree:ntasm_ast.Tree,decl_id:u64)->u64{let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,decl_id);let mut id:u64=declaration.first_child;while id!=0{if id>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if n.kind==36{return id;}id=n.next_sibling;}return 0;}
fn decl_name_id(tree:ntasm_ast.Tree,id:u64)->u64{let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if declaration.kind==18{return child(tree,id,0);}if declaration.kind==9{return child(tree,id,1);}return 0;}
fn call_type(source:buf<u8>,tree:ntasm_ast.Tree,expr_id:u64)->u64{let expression:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if expression.kind!=35||expression.aux!=1||expression.first_child==0||expression.first_child>tree.node_count{return 0;}let qualified:ntasm_ast.Node=ntasm_ast.node_at(tree,expression.first_child);if qualified.kind!=91||qualified.last_child==0||qualified.last_child>tree.node_count{return 0;}let called:ntasm_ast.Node=ntasm_ast.node_at(tree,qualified.last_child);let mut id:u64=1;while id<=tree.node_count{let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if declaration.kind==18||declaration.kind==9{let name_id:u64=decl_name_id(tree,id);if name_id!=0{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);if same(source,name,called){return return_type_id(tree,id);}}}id=id+1;}return 0;}
// Type nonliteral let initializers after names and calls have been resolved.
// 359 is an exact type mismatch;360 is a form whose type is not yet proved.
// Scalar literals/bool are owned by literal_initializers and are skipped.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let mut locals:u64=0;let mut names:u64=0;let mut calls:u64=0;let mut skipped_literals:u64=0;let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut reason:u64=0;let mut id:u64=1;while id<=tree.node_count&&code==0{let local:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if local.kind==27{locals=locals+1;let expected_id:u64=child(tree,id,1);let initializer_id:u64=child(tree,id,2);if expected_id==0||initializer_id==0{code=800;}else{let expected:ntasm_ast.Node=ntasm_ast.node_at(tree,expected_id);let initializer:ntasm_ast.Node=ntasm_ast.node_at(tree,initializer_id);let true_:buf<u8>="true";let false_:buf<u8>="false";if initializer.kind==94||word(source,initializer,true_)||word(source,initializer,false_){skipped_literals=skipped_literals+1;}else{let mut actual_id:u64=0;let name_id:u64=simple_name_id(tree,initializer_id);if name_id!=0{let mut owner:u64=0;let mut fn_id:u64=1;while fn_id<=tree.node_count{let fn_:ntasm_ast.Node=ntasm_ast.node_at(tree,fn_id);if fn_.kind==18&&fn_.start<=local.start&&local.end<=fn_.end{owner=fn_id;}fn_id=fn_id+1;}if owner==0{code=800;}else{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);actual_id=named_type(source,tree,owner,name,local.start);if actual_id==0{code=360;reason=1;}else{names=names+1;}}}else if initializer.kind==35&&initializer.aux==1{actual_id=call_type(source,tree,initializer_id);if actual_id==0{code=360;reason=2;}else{calls=calls+1;}}else{code=360;reason=3;}if code==0{let actual:ntasm_ast.Node=ntasm_ast.node_at(tree,actual_id);if same(source,expected,actual)==false{code=359;reason=1;}}if code!=0{line=initializer.line;column=initializer.column;}}}}id=id+1;}if code==0{out[0]=locals;out[1]=names;out[2]=calls;out[3]=skipped_literals;}else if code==359||code==360{out[0]=line;out[1]=column;out[2]=reason;out[3]=0;}return code;}
