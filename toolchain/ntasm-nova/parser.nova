fn versions_decl(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,4,begin);step(p);
    if (!expect(p,123,4)) { return 0; }lines(p);
    while (tk(p)!=125 && p.code==0) {
        let n:u64=node(p,5,ti(p));attach(p,n,name(p));
        if (tk(p)!=258) { error(p,4);return 0; }attach(p,n,literal(p));
        if (!expect(p,46,4) || tk(p)!=258) { error(p,4);return 0; }
        attach(p,n,literal(p));if (!term(p)) { return 0; }
        attach(p,result,finish(p,n));
    }
    if (!expect(p,125,4)) { return 0; }return finish(p,result);
}
fn simple_top(p:Parser,kind:u64,dashed_value:bool)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,kind,begin);step(p);
    if (dashed_value==true) { attach(p,result,dashed(p)); }
    else { attach(p,result,set_node(p,kind)); }
    if (!term(p)) { return 0; }return finish(p,result);
