fn data_decl(p:Parser,exported:bool)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,24,begin);
    if (exported==true) { aux(p,result,1); }
    if (!take_word(p,17,4)) { return 0; }attach(p,result,name(p));
    if (!expect(p,58,4)) { return 0; }attach(p,result,parse_type(p));
    if (!expect(p,61,4)) { return 0; }attach(p,result,parse_expression(p,0));
    if (!term(p)) { return 0; }return finish(p,result);
}
fn section_decl(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,17,begin);step(p);
    attach(p,result,section_name(p));if (!expect(p,123,4)) { return 0; }lines(p);
    while (tk(p)!=125 && p.code==0) {
        let mut exported:bool=false;if (keyword(p,70)) { exported=true;step(p); }
        if (keyword(p,15)) { attach(p,result,function_decl(p,exported)); }
        else if (keyword(p,17)) { attach(p,result,data_decl(p,exported)); }
        else if (keyword(p,38)) { attach(p,result,statement(p)); }
        else { error(p,7);return 0; }
        lines(p);
    }
    if (!expect(p,125,4)) { return 0; }return finish(p,result);
}
fn import_decl(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,9,begin);step(p);
    attach(p,result,qualified(p));if (!take_word(p,14,4)) { return 0; }
    attach(p,result,name(p));if (!expect(p,58,4) || !take_word(p,15,4)) { return 0; }
    if (!parameters(p,result) || !expect(p,261,4)) { return 0; }
    attach(p,result,parse_type(p));if (!term(p)) { return 0; }
    if (!contracts(p,result)) { return 0; }return finish(p,result);
}
fn constant_decl(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,10,begin);step(p);
    attach(p,result,name(p));if (!expect(p,58,4)) { return 0; }
    attach(p,result,parse_type(p));if (!expect(p,61,4)) { return 0; }
    attach(p,result,parse_expression(p,0));if (!term(p)) { return 0; }
    return finish(p,result);
