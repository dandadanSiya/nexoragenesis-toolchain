module callable_names_entry;

import ntasm_ast;
import ntasm_parser;
import semantics;
import callable_names;

// Entry point: parse the source, run the semantic index in a three-word
// scratch, then the global callable namespace check. A 300 from the
// semantic index carries the duplicate position in the scratch; it is
// copied to out when the buffer is large enough. The scratch buffer and
// the tree are released on every path.
export fn main(source:buf<u8>,out:buf<u64>)->u64 {
    let tree:ntasm_ast.Tree=ntasm_parser.parse(source,1);
    if tree.ok==false {
        ntasm_ast.release(tree);
        return 800;
    }
    let scratch:buf<u64>=alloc(runtime(),3);
    let mut code:u64=semantics.index(source,tree,scratch);
    if code==300 {
        if len(out)>=2 {
            out[0]=scratch[0];
            out[1]=scratch[1];
        }
    } else if code==0 {
        code=callable_names.check(source,tree,out);
    }
    rt_free(runtime(),scratch);
    ntasm_ast.release(tree);
    return code;
}
