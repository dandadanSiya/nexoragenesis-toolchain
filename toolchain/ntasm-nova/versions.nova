module versions;import ntasm_ast;
fn same(source:buf<u8>,start:u64,end:u64,text:buf<u8>)->bool{if start>end||end>len(source)||(end-start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[start+i]!=text[i]{return false;}i=i+1;}return true;}
fn child(tree:ntasm_ast.Tree,parent:u64,ordinal:u64)->u64{if parent==0||parent>tree.node_count{return 0;}let p:ntasm_ast.Node=ntasm_ast.node_at(tree,parent);let mut id:u64=p.first_child;let mut index:u64=0;while id!=0&&index<ordinal{if id>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);id=n.next_sibling;index=index+1;}if id>tree.node_count{return 0;}return id;}
fn domain(source:buf<u8>,name:ntasm_ast.Node)->u64{let a:buf<u8>="ntir";if same(source,name.start,name.end,a){return 1;}let b:buf<u8>="machine_ir";if same(source,name.start,name.end,b){return 2;}let c:buf<u8>="sections";if same(source,name.start,name.end,c){return 4;}let d:buf<u8>="symbols";if same(source,name.start,name.end,d){return 8;}let e:buf<u8>="relocations";if same(source,name.start,name.end,e){return 16;}let f:buf<u8>="nxo";if same(source,name.start,name.end,f){return 32;}return 0;}
// Optional versions block: if present, all six domains exactly once at0.1.
// Success writes blocks,entries,mask,0. 347 unknown/duplicate reason1/2;
// 348 wrong major/minor;349 incomplete with mask in out[2].
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let mut blocks:u64=0;let mut entries:u64=0;let mut mask:u64=0;let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut reason:u64=0;let mut major:u64=0;let mut minor:u64=0;let mut id:u64=1;while id<=tree.node_count&&code==0{let block:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if block.kind==4{blocks=blocks+1;if blocks>1{code=347;reason=2;line=block.line;column=block.column;}else{let mut entry_id:u64=block.first_child;while entry_id!=0&&code==0{if entry_id>tree.node_count{code=800;}else{let entry:ntasm_ast.Node=ntasm_ast.node_at(tree,entry_id);if entry.kind!=5{code=800;}else{let name_id:u64=child(tree,entry_id,0);let major_id:u64=child(tree,entry_id,1);let minor_id:u64=child(tree,entry_id,2);if name_id==0||major_id==0||minor_id==0{code=800;}else{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);let major_node:ntasm_ast.Node=ntasm_ast.node_at(tree,major_id);let minor_node:ntasm_ast.Node=ntasm_ast.node_at(tree,minor_id);let bit:u64=domain(source,name);major=major_node.aux;minor=minor_node.aux;if bit==0{code=347;reason=1;line=name.line;column=name.column;}else if (mask&bit)!=0{code=347;reason=2;line=name.line;column=name.column;}else if major!=0||minor!=1{code=348;line=name.line;column=name.column;}else{mask=mask|bit;entries=entries+1;}}}entry_id=entry.next_sibling;}}if code==0&&mask!=63{code=349;line=block.line;column=block.column;}}}id=id+1;}if code==0{out[0]=blocks;out[1]=entries;out[2]=mask;out[3]=0;}else if code==347{out[0]=line;out[1]=column;out[2]=reason;out[3]=0;}else if code==348{out[0]=line;out[1]=column;out[2]=major;out[3]=minor;}else if code==349{out[0]=line;out[1]=column;out[2]=mask;out[3]=0;}return code;}
