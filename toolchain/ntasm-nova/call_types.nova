module call_types;import ntasm_ast;
fn same(source:buf<u8>,a:ntasm_ast.Node,b:ntasm_ast.Node)->bool{if a.start>a.end||b.start>b.end||a.end>len(source)||b.end>len(source)||(a.end-a.start)!=(b.end-b.start){return false;}let mut i:u64=0;while i<(a.end-a.start){if source[a.start+i]!=source[b.start+i]{return false;}i=i+1;}return true;}
fn word(source:buf<u8>,node:ntasm_ast.Node,text:buf<u8>)->bool{if node.start>node.end||node.end>len(source)||(node.end-node.start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[node.start+i]!=text[i]{return false;}i=i+1;}return true;}
fn child(tree:ntasm_ast.Tree,parent:u64,ordinal:u64)->u64{if parent==0||parent>tree.node_count{return 0;}let p:ntasm_ast.Node=ntasm_ast.node_at(tree,parent);let mut id:u64=p.first_child;let mut index:u64=0;while id!=0&&index<ordinal{if id>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);id=n.next_sibling;index=index+1;}if id>tree.node_count{return 0;}return id;}
fn is_out(source:buf<u8>,parameter:ntasm_ast.Node)->bool{if parameter.start+3>len(source){return false;}return source[parameter.start]==111&&source[parameter.start+1]==117&&source[parameter.start+2]==116;}
fn decl_name_id(tree:ntasm_ast.Tree,id:u64)->u64{let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if n.kind==18{return child(tree,id,0);}if n.kind==9{return child(tree,id,1);}return 0;}
fn return_type_id(tree:ntasm_ast.Tree,id:u64)->u64{let d:ntasm_ast.Node=ntasm_ast.node_at(tree,id);let mut c:u64=d.first_child;while c!=0{if c>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,c);if n.kind==36{return c;}c=n.next_sibling;}return 0;}
fn simple_name_id(tree:ntasm_ast.Tree,expr_id:u64)->u64{if expr_id==0||expr_id>tree.node_count{return 0;}let e:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if e.kind!=35||e.aux!=0||e.first_child==0||e.first_child!=e.last_child||e.first_child>tree.node_count{return 0;}let q:ntasm_ast.Node=ntasm_ast.node_at(tree,e.first_child);if q.kind!=91||q.last_child==0||q.last_child>tree.node_count{return 0;}return q.last_child;}
fn named_type(source:buf<u8>,tree:ntasm_ast.Tree,fn_id:u64,name:ntasm_ast.Node,before:u64)->u64{let fn_:ntasm_ast.Node=ntasm_ast.node_at(tree,fn_id);let mut best:u64=0;let mut id:u64=1;while id<=tree.node_count{let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if n.start<before&&fn_.start<=n.start&&n.end<=fn_.end&&(n.kind==19||n.kind==27){let name_id:u64=child(tree,id,0);let type_id:u64=child(tree,id,1);if name_id!=0&&type_id!=0{let candidate:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);if same(source,candidate,name){best=type_id;}}}id=id+1;}return best;}
fn call_name_id(tree:ntasm_ast.Tree,id:u64)->u64{let qid:u64=child(tree,id,0);if qid==0{return 0;}let q:ntasm_ast.Node=ntasm_ast.node_at(tree,qid);if q.kind!=91||q.last_child==0||q.last_child>tree.node_count{return 0;}return q.last_child;}
fn call_type(source:buf<u8>,tree:ntasm_ast.Tree,id:u64)->u64{let name_id:u64=call_name_id(tree,id);if name_id==0{return 0;}let called:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);let mut d:u64=1;while d<=tree.node_count{let n:ntasm_ast.Node=ntasm_ast.node_at(tree,d);if n.kind==18||n.kind==9{let dn_id:u64=decl_name_id(tree,d);if dn_id!=0{let dn:ntasm_ast.Node=ntasm_ast.node_at(tree,dn_id);if same(source,dn,called){return return_type_id(tree,d);}}}d=d+1;}return 0;}
fn literal_status(source:buf<u8>,expected:ntasm_ast.Node,literal:ntasm_ast.Node)->u64{let t:buf<u8>="true";let f:buf<u8>="false";let is_bool:bool=word(source,literal,t)||word(source,literal,f);let b:buf<u8>="bool";if word(source,expected,b){if is_bool{return 1;}return 0;}if is_bool{return 0;}let value:u64=literal.aux;let u8_:buf<u8>="u8";if word(source,expected,u8_){if value<=255{return 1;}return 2;}let i8_:buf<u8>="i8";if word(source,expected,i8_){if value<=127{return 1;}return 2;}let u16_:buf<u8>="u16";if word(source,expected,u16_){if value<=65535{return 1;}return 2;}let i16_:buf<u8>="i16";if word(source,expected,i16_){if value<=32767{return 1;}return 2;}let u32_:buf<u8>="u32";if word(source,expected,u32_){if value<=4294967295{return 1;}return 2;}let i32_:buf<u8>="i32";if word(source,expected,i32_){if value<=2147483647{return 1;}return 2;}let u64_:buf<u8>="u64";if word(source,expected,u64_){return 1;}let i64_:buf<u8>="i64";if word(source,expected,i64_){if value<=9223372036854775807{return 1;}return 2;}return 0;}
fn is_call(n:ntasm_ast.Node)->bool{if n.kind==28{return true;}return n.kind==35&&n.aux==1;}
// Validate in/inout call argument types; out parameters consume no argument.
// Proofs: bounded literals, caller param/local names and nested call results.
// Error354 reason1 mismatch,2 range,3 unsupported; out[3]=argument index.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let mut calls:u64=0;let mut arguments:u64=0;let mut checked:u64=0;let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut reason:u64=0;let mut bad_index:u64=0;let mut id:u64=1;while id<=tree.node_count&&code==0{let call:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if is_call(call){calls=calls+1;let name_id:u64=call_name_id(tree,id);if name_id==0{code=800;}else{let called:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);let mut caller:u64=0;let mut callee:u64=0;let mut d:u64=1;while d<=tree.node_count{let decl:ntasm_ast.Node=ntasm_ast.node_at(tree,d);if decl.kind==18||decl.kind==9{let dn_id:u64=decl_name_id(tree,d);if dn_id!=0{let dn:ntasm_ast.Node=ntasm_ast.node_at(tree,dn_id);if same(source,dn,called){callee=d;}}if decl.kind==18&&decl.start<=call.start&&call.end<=decl.end{caller=d;}}d=d+1;}if caller==0||callee==0{code=800;}else{let qid:u64=child(tree,id,0);let q:ntasm_ast.Node=ntasm_ast.node_at(tree,qid);let mut arg_id:u64=q.next_sibling;let callee_node:ntasm_ast.Node=ntasm_ast.node_at(tree,callee);let mut param_id:u64=callee_node.first_child;let mut index:u64=0;while param_id!=0&&code==0{let parameter:ntasm_ast.Node=ntasm_ast.node_at(tree,param_id);if parameter.kind==19&&is_out(source,parameter)==false{if arg_id==0||arg_id>tree.node_count{code=800;}else{arguments=arguments+1;let expected_id:u64=child(tree,param_id,1);if expected_id==0{code=800;}else{let expected:ntasm_ast.Node=ntasm_ast.node_at(tree,expected_id);let arg:ntasm_ast.Node=ntasm_ast.node_at(tree,arg_id);if arg.kind==94{let status:u64=literal_status(source,expected,arg);if status==0{code=354;reason=1;}else if status==2{code=354;reason=2;}else{checked=checked+1;}}else{let bool_:buf<u8>="bool";let true_:buf<u8>="true";let false_:buf<u8>="false";if word(source,expected,bool_)&&(word(source,arg,true_)||word(source,arg,false_)){checked=checked+1;}else{let mut actual_id:u64=0;let simple_id:u64=simple_name_id(tree,arg_id);if simple_id!=0{let simple:ntasm_ast.Node=ntasm_ast.node_at(tree,simple_id);actual_id=named_type(source,tree,caller,simple,call.start);}else if arg.kind==35&&arg.aux==1{actual_id=call_type(source,tree,arg_id);}if actual_id==0{code=354;reason=3;}else{let actual:ntasm_ast.Node=ntasm_ast.node_at(tree,actual_id);if same(source,expected,actual){checked=checked+1;}else{code=354;reason=1;}}}}if code!=0{line=arg.line;column=arg.column;bad_index=index;}}let arg:ntasm_ast.Node=ntasm_ast.node_at(tree,arg_id);arg_id=arg.next_sibling;index=index+1;}}param_id=parameter.next_sibling;}}}}id=id+1;}if code==0{out[0]=calls;out[1]=arguments;out[2]=checked;out[3]=0;}else if code==354{out[0]=line;out[1]=column;out[2]=reason;out[3]=bad_index;}return code;}
