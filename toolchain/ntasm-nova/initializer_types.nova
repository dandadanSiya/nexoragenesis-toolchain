module initializer_types;
import ntasm_ast;
fn child(tree:ntasm_ast.Tree,parent:u64,ordinal:u64)->u64{if parent==0||parent>tree.node_count{return 0;}let p:ntasm_ast.Node=ntasm_ast.node_at(tree,parent);let mut id:u64=p.first_child;let mut index:u64=0;while id!=0&&index<ordinal{if id>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);id=n.next_sibling;index=index+1;}if id>tree.node_count{return 0;}return id;}
fn same(source:buf<u8>,a:ntasm_ast.Node,b:ntasm_ast.Node)->bool{if a.start>a.end||b.start>b.end||a.end>len(source)||b.end>len(source)||(a.end-a.start)!=(b.end-b.start){return false;}let mut i:u64=0;while i<(a.end-a.start){if source[a.start+i]!=source[b.start+i]{return false;}i=i+1;}return true;}
fn word(source:buf<u8>,node:ntasm_ast.Node,text:buf<u8>)->bool{if node.start>node.end||node.end>len(source)||(node.end-node.start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[node.start+i]!=text[i]{return false;}i=i+1;}return true;}
fn simple_name_id(tree:ntasm_ast.Tree,expr_id:u64)->u64{if expr_id==0||expr_id>tree.node_count{return 0;}let expression:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if expression.kind!=35||expression.aux!=0||expression.first_child==0||expression.first_child!=expression.last_child||expression.first_child>tree.node_count{return 0;}let qualified:ntasm_ast.Node=ntasm_ast.node_at(tree,expression.first_child);if qualified.kind!=91||qualified.last_child==0||qualified.last_child>tree.node_count{return 0;}return qualified.last_child;}
fn named_type(source:buf<u8>,tree:ntasm_ast.Tree,fn_id:u64,name:ntasm_ast.Node,before:u64)->u64{let fn_:ntasm_ast.Node=ntasm_ast.node_at(tree,fn_id);let mut best:u64=0;let mut id:u64=1;while id<=tree.node_count{let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if n.start<before&&fn_.start<=n.start&&n.end<=fn_.end&&(n.kind==19||n.kind==27){let name_id:u64=child(tree,id,0);let type_id:u64=child(tree,id,1);if name_id!=0&&type_id!=0{let candidate:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);if same(source,candidate,name){best=type_id;}}}id=id+1;}return best;}
fn return_type_id(tree:ntasm_ast.Tree,decl_id:u64)->u64{let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,decl_id);let mut id:u64=declaration.first_child;while id!=0{if id>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if n.kind==36{return id;}id=n.next_sibling;}return 0;}
fn decl_name_id(tree:ntasm_ast.Tree,id:u64)->u64{let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if declaration.kind==18{return child(tree,id,0);}if declaration.kind==9{return child(tree,id,1);}return 0;}
fn call_type(source:buf<u8>,tree:ntasm_ast.Tree,expr_id:u64)->u64{let expression:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if expression.kind!=35||expression.aux!=1||expression.first_child==0||expression.first_child>tree.node_count{return 0;}let qualified:ntasm_ast.Node=ntasm_ast.node_at(tree,expression.first_child);if qualified.kind!=91||qualified.last_child==0||qualified.last_child>tree.node_count{return 0;}let called:ntasm_ast.Node=ntasm_ast.node_at(tree,qualified.last_child);let mut id:u64=1;while id<=tree.node_count{let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if declaration.kind==18||declaration.kind==9{let name_id:u64=decl_name_id(tree,id);if name_id!=0{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);if same(source,name,called){return return_type_id(tree,id);}}}id=id+1;}return 0;}
fn integer_type(source:buf<u8>,type_:ntasm_ast.Node)->bool{let a:buf<u8>="u8";if word(source,type_,a){return true;}let b:buf<u8>="i8";if word(source,type_,b){return true;}let c:buf<u8>="u16";if word(source,type_,c){return true;}let d:buf<u8>="i16";if word(source,type_,d){return true;}let e:buf<u8>="u32";if word(source,type_,e){return true;}let f:buf<u8>="i32";if word(source,type_,f){return true;}let g:buf<u8>="u64";if word(source,type_,g){return true;}let h:buf<u8>="i64";return word(source,type_,h);}
fn literal_status(source:buf<u8>,expected:ntasm_ast.Node,literal:ntasm_ast.Node)->u64{if integer_type(source,expected)==false{return 0;}let value:u64=literal.aux;let a:buf<u8>="u8";if word(source,expected,a){if value<=255{return 1;}return 0;}let b:buf<u8>="i8";if word(source,expected,b){if value<=127{return 1;}return 0;}let c:buf<u8>="u16";if word(source,expected,c){if value<=65535{return 1;}return 0;}let d:buf<u8>="i16";if word(source,expected,d){if value<=32767{return 1;}return 0;}let e:buf<u8>="u32";if word(source,expected,e){if value<=4294967295{return 1;}return 0;}let f:buf<u8>="i32";if word(source,expected,f){if value<=2147483647{return 1;}return 0;}let g:buf<u8>="u64";if word(source,expected,g){return 1;}if value<=9223372036854775807{return 1;}return 0;}
fn arithmetic(operation:u64)->bool{return operation==43||operation==45||operation==42||operation==47||operation==37||operation==38||operation==94||operation==124;}
// Operand status:0 is a proved mismatch/range error,1 exact,2 unsupported.
fn operand_status(source:buf<u8>,tree:ntasm_ast.Tree,expr_id:u64,owner:u64,before:u64,expected:ntasm_ast.Node)->u64{if expr_id==0||expr_id>tree.node_count{return 2;}let expression:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if expression.kind==94{return literal_status(source,expected,expression);}let name_id:u64=simple_name_id(tree,expr_id);let mut actual_id:u64=0;if name_id!=0{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);actual_id=named_type(source,tree,owner,name,before);}else if expression.kind==35&&expression.aux==1{actual_id=call_type(source,tree,expr_id);}if actual_id==0{return 2;}let actual:ntasm_ast.Node=ntasm_ast.node_at(tree,actual_id);if same(source,expected,actual){return 1;}return 0;}
fn expression_status(source:buf<u8>,tree:ntasm_ast.Tree,expr_id:u64,owner:u64,before:u64,expected:ntasm_ast.Node)->u64{if integer_type(source,expected)==false{return 0;}let expression:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if expression.kind!=35||arithmetic(expression.aux)==false{return 2;}let left_id:u64=child(tree,expr_id,0);let right_id:u64=child(tree,expr_id,1);if left_id==0||right_id==0{return 2;}let right:ntasm_ast.Node=ntasm_ast.node_at(tree,right_id);if right.next_sibling!=0{return 2;}let left_status:u64=operand_status(source,tree,left_id,owner,before,expected);let right_status:u64=operand_status(source,tree,right_id,owner,before,expected);if left_status==2||right_status==2{return 2;}if left_status==0||right_status==0{return 0;}return 1;}
// Type nonliteral let initializers after names and calls have been resolved.
// 359 is an exact type mismatch;360 is a form whose type is not yet proved.
// Scalar literals/bool are owned by literal_initializers. One binary integer
// expression is accepted when both operands are exact names, calls or bounded
// literals of the declared type. Nested expressions remain fail-closed.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let mut locals:u64=0;let mut names:u64=0;let mut calls:u64=0;let mut delegated_or_expression:u64=0;let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut reason:u64=0;let mut id:u64=1;while id<=tree.node_count&&code==0{let local:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if local.kind==27{locals=locals+1;let expected_id:u64=child(tree,id,1);let initializer_id:u64=child(tree,id,2);if expected_id==0||initializer_id==0{code=800;}else{let expected:ntasm_ast.Node=ntasm_ast.node_at(tree,expected_id);let initializer:ntasm_ast.Node=ntasm_ast.node_at(tree,initializer_id);let true_:buf<u8>="true";let false_:buf<u8>="false";if initializer.kind==94||word(source,initializer,true_)||word(source,initializer,false_){delegated_or_expression=delegated_or_expression+1;}else{let mut owner:u64=0;let mut fn_id:u64=1;while fn_id<=tree.node_count{let fn_:ntasm_ast.Node=ntasm_ast.node_at(tree,fn_id);if fn_.kind==18&&fn_.start<=local.start&&local.end<=fn_.end{owner=fn_id;}fn_id=fn_id+1;}if owner==0{code=800;}else{let mut actual_id:u64=0;let name_id:u64=simple_name_id(tree,initializer_id);if name_id!=0{let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);actual_id=named_type(source,tree,owner,name,local.start);if actual_id==0{code=360;reason=1;}else{names=names+1;}}else if initializer.kind==35&&initializer.aux==1{actual_id=call_type(source,tree,initializer_id);if actual_id==0{code=360;reason=2;}else{calls=calls+1;}}else{let status:u64=expression_status(source,tree,initializer_id,owner,local.start,expected);if status==1{delegated_or_expression=delegated_or_expression+1;}else if status==0{code=359;reason=2;}else{code=360;reason=3;}}if code==0&&actual_id!=0{let actual:ntasm_ast.Node=ntasm_ast.node_at(tree,actual_id);if same(source,expected,actual)==false{code=359;reason=1;}}}if code!=0{line=initializer.line;column=initializer.column;}}}}id=id+1;}if code==0{out[0]=locals;out[1]=names;out[2]=calls;out[3]=delegated_or_expression;}else if code==359||code==360{out[0]=line;out[1]=column;out[2]=reason;out[3]=0;}return code;}
