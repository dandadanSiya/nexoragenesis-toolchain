fn quote_value(p:Parser)->u64 {
    let begin:u64=ti(p);let result:u64=node(p,43,begin);
    if (!take_word(p,49,4) || !expect(p,40,4)) { return 0; }
    let mut quote_kind:u64=0;
    if (keyword(p,74)) { quote_kind=1; }
    else if (keyword(p,51)) { quote_kind=2; }
    else if (keyword(p,52)) { quote_kind=3; }
    else if (keyword(p,53)) { quote_kind=4; }
