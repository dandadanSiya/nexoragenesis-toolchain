module ntasm_lexer;

// Token kinds 0..255 are their ASCII byte. Named kinds match frontend.c.
export struct Span {
    source:u64,line:u64,column:u64,start:u64,end:u64
}
export struct Token {
    kind:u64,value:u64,source:u64,line:u64,column:u64,
    start:u64,end:u64,text_start:u64,text_length:u64
}
export struct Diagnostic { code:u64,reason:u64,span:Span }
export struct Result {
    ok:bool,token_words:buf<u64>,count:u64,diagnostic:Diagnostic
}
struct Scan {
    ok:bool,count:u64,diagnostic:Diagnostic
}

fn empty_span(source_index:u64)->Span {
    return Span{source:source_index,line:1,column:1,start:0,end:0};
}
fn no_diagnostic(source_index:u64)->Diagnostic {
    return Diagnostic{code:0,reason:0,span:empty_span(source_index)};
}
fn failed(source_index:u64,line:u64,column:u64,start:u64,end:u64,
          reason:u64,count:u64)->Scan {
    let span:Span=Span{source:source_index,line:line,column:column,
                       start:start,end:end};
    return Scan{ok:false,count:count,
                diagnostic:Diagnostic{code:100,reason:reason,span:span}};
}
fn limited(source_index:u64,reason:u64)->Scan {
    let span:Span=empty_span(source_index);
    return Scan{ok:false,count:0,
                diagnostic:Diagnostic{code:201,reason:reason,span:span}};
}
fn is_letter(ch:u8)->bool {
    return (ch>=97 && ch<=122) || (ch>=65 && ch<=90) || ch==95;
}
fn is_digit(ch:u8)->bool { return ch>=48 && ch<=57; }
fn is_xdigit(ch:u8)->bool {
    return is_digit(ch) || (ch>=97 && ch<=102) || (ch>=65 && ch<=70);
}
fn xvalue(ch:u8)->u64 {
    if is_digit(ch) { return ch-48; }
    if ch>=97 { return ch-97+10; }
    return ch-65+10;
}
fn put(tokens:buf<u64>,emit_tokens:bool,index:u64,kind:u64,value:u64,
       source_index:u64,line:u64,column:u64,start:u64,end:u64,
       text_start:u64,text_length:u64)->u64 {
    if emit_tokens==true {
        let at:u64=index*9;
        tokens[at]=kind;tokens[at+1]=value;tokens[at+2]=source_index;
        tokens[at+3]=line;tokens[at+4]=column;tokens[at+5]=start;
        tokens[at+6]=end;tokens[at+7]=text_start;tokens[at+8]=text_length;
    }
    return 0;
}

// reason: 1 isolated CR, 2 missing hex digits, 3 bad integer underscore,
// 4 u64 overflow, 5 suffix, 6 invalid string byte, 7 bad hex escape,
// 8 unknown escape, 9 unterminated string, 10 invalid source byte,
// 11 source limit, 12 token limit, 13 allocation/runtime failure.
fn scan(source:buf<u8>,source_index:u64,tokens:buf<u64>,emit_tokens:bool)->Scan {
    let size:u64=len(source);
    if size>4194304 { return limited(source_index,11); }
    let mut cursor:u64=0;
    let mut line:u64=1;
    let mut column:u64=1;
    let mut count:u64=0;
    while true {
        while cursor<(size) {
            let ch:u8=source[cursor];
            if ch==32 || ch==9 {
                cursor=cursor+1;column=column+1;continue;
            }
            if ch==13 {
                if cursor+1>=(size) || source[cursor+1]!=10 {
                    return failed(source_index,line,column,cursor,cursor+1,1,count);
                }
                cursor=cursor+1;column=column+1;continue;
            }
            if ch==47 && cursor+1<(size) && source[cursor+1]==47 {
                while cursor<(size) && source[cursor]!=10 {
                    cursor=cursor+1;column=column+1;
                }
                continue;
            }
            break;
        }
        if cursor>=(size) {
            put(tokens,emit_tokens,count,256,0,source_index,line,column,cursor,cursor,
                cursor,0);
            count=count+1;
            return Scan{ok:true,count:count,
                        diagnostic:no_diagnostic(source_index)};
        }
        if count>=262142 { return limited(source_index,12); }
        let start:u64=cursor;
        let token_line:u64=line;
        let token_column:u64=column;
        let mut kind:u64=0;
        let mut value:u64=0;
        let mut text_start:u64=start;
        let mut text_length:u64=0;
        let ch:u8=source[cursor];
        if ch==10 {
            kind=260;cursor=cursor+1;line=line+1;column=1;
        } else if is_letter(ch) {
            kind=257;
            while cursor<(size) &&
                  (is_letter(source[cursor]) || is_digit(source[cursor])) {
                cursor=cursor+1;column=column+1;
            }
        } else if is_digit(ch) {
            kind=258;
            let mut base:u64=10;
            let mut previous:bool=false;
            if ch==48 && cursor+1<(size) &&
               (source[cursor+1]==120 || source[cursor+1]==88) {
                base=16;cursor=cursor+2;column=column+2;
                if cursor>=(size) || !is_xdigit(source[cursor]) {
                    return failed(source_index,token_line,token_column,start,
                                  cursor,2,count);
                }
            }
            while cursor<(size) {
                let digit:u8=source[cursor];
                if digit==95 {
                    if !previous || cursor+1>=(size) ||
                       (base==16 && !is_xdigit(source[cursor+1])) ||
                       (base==10 && !is_digit(source[cursor+1])) {
                        return failed(source_index,token_line,token_column,
                                      start,cursor+1,3,count);
                    }
                    previous=false;cursor=cursor+1;column=column+1;continue;
                }
                if (base==16 && !is_xdigit(digit)) ||
                   (base==10 && !is_digit(digit)) { break; }
                let mut part:u64=digit-48;
                if base==16 { part=xvalue(digit); }
                if (value>(18446744073709551615-part)/base) {
                    return failed(source_index,token_line,token_column,start,
                                  cursor+1,4,count);
                }
                value=value*base+part;previous=true;
                cursor=cursor+1;column=column+1;
            }
            if cursor<(size) && is_letter(source[cursor]) {
                while cursor<(size) &&
                      (is_letter(source[cursor]) || is_digit(source[cursor])) {
                    cursor=cursor+1;column=column+1;
                }
                return failed(source_index,token_line,token_column,start,cursor,
                              5,count);
            }
        } else if ch==34 {
            kind=259;cursor=cursor+1;column=column+1;text_start=cursor;
            while cursor<(size) && source[cursor]!=34 {
                let byte:u8=source[cursor];
                if byte==10 || byte==13 || byte==0 {
                    return failed(source_index,token_line,token_column,start,
                                  cursor+1,6,count);
                }
                if byte==92 {
                    cursor=cursor+1;column=column+1;
                    if cursor>=(size) { break; }
                    let escape:u8=source[cursor];
                    if escape==120 {
                        cursor=cursor+1;column=column+1;
                        if cursor+1>=(size) || !is_xdigit(source[cursor]) ||
                           !is_xdigit(source[cursor+1]) {
                            return failed(source_index,token_line,token_column,
                                          start,cursor,7,count);
                        }
                        cursor=cursor+2;column=column+2;continue;
                    }
                    if escape!=92 && escape!=34 && escape!=110 &&
                       escape!=114 && escape!=116 && escape!=48 && escape!=0 {
                        return failed(source_index,token_line,token_column,
                                      start,cursor+1,8,count);
                    }
                }
                cursor=cursor+1;column=column+1;
            }
            if cursor>=(size) || source[cursor]!=34 {
                return failed(source_index,token_line,token_column,start,cursor,
                              9,count);
            }
            text_length=cursor-text_start;
            cursor=cursor+1;column=column+1;
        } else {
            cursor=cursor+1;column=column+1;kind=ch;
            if cursor<(size) {
                let next:u8=source[cursor];
                if ch==45 && next==62 { kind=261;cursor=cursor+1;column=column+1; }
                else if ch==61 && next==61 { kind=262;cursor=cursor+1;column=column+1; }
                else if ch==33 && next==61 { kind=263;cursor=cursor+1;column=column+1; }
                else if ch==60 && next==61 { kind=264;cursor=cursor+1;column=column+1; }
                else if ch==62 && next==61 { kind=265;cursor=cursor+1;column=column+1; }
                else if ch==60 && next==60 { kind=266;cursor=cursor+1;column=column+1; }
                else if ch==62 && next==62 { kind=267;cursor=cursor+1;column=column+1; }
            }
            if ch<32 || ch>126 {
                return failed(source_index,token_line,token_column,start,cursor,
                              10,count);
            }
        }
        if text_length==0 { text_length=cursor-start; }
        put(tokens,emit_tokens,count,kind,value,source_index,token_line,token_column,
            start,cursor,text_start,text_length);
        count=count+1;
    }
    return limited(source_index,13);
}

fn bad_result(source_index:u64,diagnostic:Diagnostic)->Result {
    let empty:buf<u64>=alloc(runtime(),0);
    return Result{ok:false,token_words:empty,count:0,diagnostic:diagnostic};
}
export fn lex(source:buf<u8>,source_index:u64)->Result {
    let none:buf<u64>=alloc(runtime(),0);
    let counted:Scan=scan(source,source_index,none,false);
    rt_free(runtime(),none);
    if counted.ok==false { return bad_result(source_index,counted.diagnostic); }
    let tokens:buf<u64>=alloc(runtime(),counted.count*9);
    if len(tokens)!=counted.count*9 {
        let span:Span=empty_span(source_index);
        return bad_result(source_index,Diagnostic{code:900,reason:13,span:span});
    }
    let filled:Scan=scan(source,source_index,tokens,true);
    if filled.ok==false {
        rt_free(runtime(),tokens);
        return bad_result(source_index,filled.diagnostic);
    }
    return Result{ok:true,token_words:tokens,count:filled.count,
                  diagnostic:no_diagnostic(source_index)};
}
export fn token_at(result:Result,index:u64)->Token {
    let at:u64=index*9;
    return Token{kind:result.token_words[at],value:result.token_words[at+1],
        source:result.token_words[at+2],line:result.token_words[at+3],
        column:result.token_words[at+4],start:result.token_words[at+5],
        end:result.token_words[at+6],text_start:result.token_words[at+7],
        text_length:result.token_words[at+8]};
}
export fn release(result:Result)->u64 {
    let words:buf<u64>=result.token_words;
    return rt_free(runtime(),words);
}
