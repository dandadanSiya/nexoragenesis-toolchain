; NTBH-T01 : adaptateur prive TEST, pas un compilateur v0.
format pe64
abi efi_x64
entry start
section .text rx
start:
push rbx
push rbp
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 56
mov rbx, rdx
mov r15, rcx
lea rbp, [rip + state]
mov rax, 920
store64 [rbp], rax
load64 r14, [rbx + 96]
mov rcx, r15
lea rdx, [rip + loaded_guid]
lea r8, [rbp + 8]
load64 rax, [r14 + 152]
call rax
cmp rax, 0
jne finish
load64 rax, [rbp + 8]
load64 rcx, [rax + 24]
store64 [rbp + 16], rcx
lea rdx, [rip + fs_guid]
lea r8, [rbp + 24]
load64 rax, [r14 + 152]
call rax
cmp rax, 0
jne finish
load64 rcx, [rbp + 24]
lea rdx, [rbp + 32]
load64 rax, [rcx + 8]
call rax
cmp rax, 0
jne finish
mov rcx, 2
mov rdx, 65664
lea r8, [rbp + 48]
load64 rax, [r14 + 64]
call rax
cmp rax, 0
jne cleanup
load64 rax, [rbp + 48]
cmp rax, 0
je cleanup
; Requete TEST privee : version ASCII1+LF, sans suffixe.
lea rcx, [rip + job_name]
mov rdx, 3
call read_file
cmp rax, 1
jne cleanup
load64 rax, [rbp + 56]
cmp rax, 2
jne cleanup
load64 rcx, [rbp + 48]
load16 rax, [rcx]
cmp rax, 0x0A31
jne cleanup
lea rcx, [rip + source_name]
mov rdx, 64
call read_file
cmp rax, 1
jne cleanup
load64 rcx, [rbp + 56]
cmp rcx, 0
je cleanup
store64 [rbp + 176], rcx
load64 rsi, [rbp + 48]
lea rdi, [rip + input_source]
call copy_bytes
lea rcx, [rip + core_name]
mov rdx, 64
call read_file
cmp rax, 1
jne cleanup
load64 rax, [rbp + 56]
cmp rax, 9
jne cleanup
load64 rsi, [rbp + 48]
load64 rax, [rsi]
mov rdx, 0x45524F4354534554
cmp rax, rdx
jne cleanup
load8 rax, [rsi + 8]
cmp rax, 10
jne cleanup
lea rdi, [rip + input_core]
mov rcx, 9
call copy_bytes
; Fixture approuvee par hash embarque. Aucun autre producteur n'est admis.
mov rax, 928
store64 [rbp], rax
lea rcx, [rip + host_name]
mov rdx, 4096
call read_file
cmp rax, 1
jne cleanup
load64 rdx, [rbp + 56]
cmp rdx, 4096
jne cleanup
load64 rcx, [rbp + 48]
call sha256
lea rdx, [rip + host_hash]
call digest_equal
cmp rax, 1
jne cleanup
; Construire LoadOptions NTBH-T01, profile TEST, capacites source/core.
lea rdi, [rip + descriptor]
mov rax, 0x3130542D4842544E
store64 [rdi], rax
mov rax, 128
store64 [rdi + 8], rax
mov rax, 1
store64 [rdi + 16], rax
mov rax, 0x54534554
store64 [rdi + 24], rax
store64 [rdi + 40], rax
mov rax, 12
store64 [rdi + 32], rax
lea rax, [rip + input_source]
store64 [rdi + 48], rax
load64 rax, [rbp + 176]
store64 [rdi + 56], rax
lea rax, [rip + input_core]
store64 [rdi + 64], rax
mov rax, 9
store64 [rdi + 72], rax
lea rax, [rip + report]
store64 [rdi + 80], rax
store64 [rdi + 88], rbp
lea rax, [rip + output]
store64 [rdi + 96], rax
mov rax, 64
store64 [rdi + 104], rax
; Copies appartenant au lanceur : descripteur et entrees jamais modifiables.
lea rsi, [rip + descriptor]
lea rdi, [rip + descriptor_snapshot]
mov rcx, 128
call copy_bytes
lea rsi, [rip + source_pre]
lea rdi, [rip + inputs_snapshot]
mov rcx, 192
call copy_bytes
mov rax, 926
store64 [rbp], rax
mov rcx, 0
mov rdx, r15
mov r8, 0
load64 r9, [rbp + 48]
mov rax, 4096
store64 [rsp + 32], rax
lea rax, [rbp + 88]
store64 [rsp + 40], rax
load64 rax, [r14 + 200]
call rax
cmp rax, 0
je image_loaded
mov rdx, 0x800000000000001A
cmp rax, rdx
jne cleanup
load64 rcx, [rbp + 88]
cmp rcx, 0
je cleanup
jmp unload_child
image_loaded:
load64 rcx, [rbp + 88]
cmp rcx, 0
je cleanup
lea rdx, [rip + loaded_guid]
lea r8, [rbp + 96]
load64 rax, [r14 + 152]
call rax
cmp rax, 0
jne unload_child
load64 rcx, [rbp + 96]
mov rax, 128
store32 [rcx + 48], rax
lea rax, [rip + descriptor]
store64 [rcx + 56], rax
load64 rcx, [rbp + 88]
mov rdx, 0
mov r8, 0
load64 rax, [r14 + 208]
call rax
store64 [rbp + 104], rax
mov rax, 1
store64 [rbp + 168], rax
; L'ownership ne repose pas sur le seul statut StartImage.
mov rax, 2048
store64 [rbp + 128], rax
mov rcx, 2
lea rdx, [rip + loaded_guid]
mov r8, 0
lea r9, [rbp + 128]
lea rax, [rip + loaded_handles]
store64 [rsp + 32], rax
load64 rax, [r14 + 176]
call rax
cmp rax, 0
jne cleanup
load64 rcx, [rbp + 128]
cmp rcx, 8
jb cleanup
cmp rcx, 2049
jae cleanup
mov rax, rcx
and rax, 7
jne cleanup
lea rsi, [rip + loaded_handles]
load64 rdi, [rbp + 88]
resident_loop:
load64 rax, [rsi]
cmp rax, rdi
je unload_child
add rsi, 8
sub rcx, 8
jne resident_loop
mov rax, 0
store64 [rbp + 88], rax
; Aucun succes possible sans sequence complete, coherente et sans erreur.
mov rax, 922
store64 [rbp], rax
load64 rax, [rbp + 144]
cmp rax, 0
jne cleanup
mov rax, 921
store64 [rbp], rax
load64 rax, [rbp + 136]
cmp rax, 2
jne cleanup
mov rax, 923
store64 [rbp], rax
load64 rax, [rbp + 104]
load64 rdx, [rbp + 152]
cmp rax, rdx
jne cleanup
mov rax, 924
store64 [rbp], rax
cmp rdx, 0
jne cleanup
mov rax, 925
store64 [rbp], rax
call check_integrity
cmp rax, 1
jne cleanup
load64 rax, [rbp + 160]
cmp rax, 8
jne cleanup
lea rcx, [rip + output]
load64 rax, [rcx]
mov rdx, 0x545345544842544E
cmp rax, rdx
jne cleanup
; Publier uniquement le format TEST 8 octets, jamais un PE ou NXO.
call write_test
cmp rax, 0
jne cleanup
mov rax, 0
store64 [rbp], rax
jmp cleanup
unload_child:
load64 rcx, [rbp + 88]
mov rax, 0
store64 [rbp + 88], rax
load64 rax, [r14 + 224]
call rax
call cleanup_status
cleanup:
load64 rcx, [rbp + 48]
cmp rcx, 0
je close_root
mov rax, 0
store64 [rbp + 48], rax
load64 rax, [r14 + 72]
call rax
call cleanup_status
close_root:
load64 rcx, [rbp + 32]
cmp rcx, 0
je finish
mov rax, 0
store64 [rbp + 32], rax
load64 rax, [rcx + 16]
call rax
call cleanup_status
finish:
load64 rax, [rbp]
cmp rax, 0
je print_success
lea rdx, [rip + error_recipe]
sub rax, 920
add rax, 48
store16 [rdx + 38], rax
jmp print_result
print_success:
lea rdx, [rip + message_ok]
print_result:
load64 rcx, [rbx + 64]
load64 rax, [rcx + 8]
call rax
load64 rax, [rbp]
cmp rax, 0
je restore
mov rax, 0x8000000000000015
restore:
add rsp, 56
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbp
pop rbx
ret
cleanup_status:
cmp rax, 0
je cleanup_done
load64 rdx, [rbp]
cmp rdx, 0
jne cleanup_done
mov rax, 926
store64 [rbp], rax
cleanup_done:
ret
copy_bytes:
load8 rax, [rsi]
store8 [rdi], rax
add rsi, 1
add rdi, 1
sub rcx, 1
jne copy_bytes
ret
check_integrity:
sub rsp, 40
lea rsi, [rip + descriptor]
lea rdi, [rip + descriptor_snapshot]
mov rcx, 128
call bytes_equal
cmp rax, 1
jne integrity_return
lea rsi, [rip + source_pre]
lea rdi, [rip + inputs_snapshot]
mov rcx, 192
call bytes_equal
cmp rax, 1
jne integrity_return
lea rcx, [rip + output_pre]
load64 rax, [rcx]
mov rdx, 0xA55AA55AA55AA55A
cmp rax, rdx
jne integrity_bad
load64 rax, [rcx + 8]
cmp rax, rdx
jne integrity_bad
lea rcx, [rip + output_post]
load64 rax, [rcx]
mov rdx, 0x5AA55AA55AA55AA5
cmp rax, rdx
jne integrity_bad
load64 rax, [rcx + 8]
cmp rax, rdx
jne integrity_bad
mov rax, 1
jmp integrity_return
integrity_bad:
mov rax, 0
integrity_return:
add rsp, 40
ret
bytes_equal:
load8 rax, [rsi]
load8 rdx, [rdi]
cmp rax, rdx
jne bytes_bad
add rsi, 1
add rdi, 1
sub rcx, 1
jne bytes_equal
mov rax, 1
ret
bytes_bad:
mov rax, 0
ret
; Callback ne dereference jamais le contexte fourni avant verification.
report:
lea rax, [rip + state]
cmp rcx, rax
jne report_bad
load64 r10, [rax + 168]
cmp r10, 0
jne report_bad
load64 r10, [rax + 144]
cmp r10, 0
jne report_bad
cmp rdx, 1
je report_entry
cmp rdx, 2
jne report_bad
load64 r10, [rax + 136]
cmp r10, 1
jne report_bad
cmp r8, 0
jne report_failed
cmp r9, 1
jb report_bad
cmp r9, 65
jae report_bad
jmp report_complete
report_failed:
cmp r9, 0
jne report_bad
report_complete:
store64 [rax + 152], r8
store64 [rax + 160], r9
mov r10, 2
store64 [rax + 136], r10
mov rax, 0
ret
report_entry:
load64 r10, [rax + 136]
cmp r10, 0
jne report_bad
cmp r8, 0
jne report_bad
cmp r9, 0
jne report_bad
mov r10, 1
store64 [rax + 136], r10
mov rax, 0
ret
report_bad:
lea rax, [rip + state]
mov r10, 1
store64 [rax + 144], r10
mov rax, 0x800000000000001A
ret
write_test:
push rsi
sub rsp, 48
mov rax, 927
store64 [rbp], rax
mov rax, 0
store64 [rbp + 40], rax
load64 rcx, [rbp + 32]
lea rdx, [rbp + 40]
lea r8, [rip + output_name]
mov r9, 1
store64 [rsp + 32], rax
load64 rax, [rcx + 8]
call rax
cmp rax, 0
jne output_missing
load64 rcx, [rbp + 40]
load64 rax, [rcx + 16]
call rax
mov rax, 1
jmp write_return
output_missing:
mov rdx, 0x800000000000000E
cmp rax, rdx
jne write_error
mov rax, 926
store64 [rbp], rax
load64 rcx, [rbp + 32]
lea rdx, [rbp + 40]
lea r8, [rip + output_name]
mov r9, 0x8000000000000003
mov rax, 0
store64 [rsp + 32], rax
load64 rax, [rcx + 8]
call rax
cmp rax, 0
jne write_error
load64 rsi, [rbp + 40]
mov rax, 8
store64 [rbp + 64], rax
mov rcx, rsi
lea rdx, [rbp + 64]
lea r8, [rip + output]
load64 rax, [rsi + 40]
call rax
cmp rax, 0
jne write_close_error
load64 rax, [rbp + 64]
cmp rax, 8
jne write_close_error
mov rcx, rsi
load64 rax, [rsi + 80]
call rax
cmp rax, 0
jne write_close_error
mov rcx, rsi
load64 rax, [rsi + 16]
call rax
cmp rax, 0
jne write_error
mov rax, 0
jmp write_return
write_close_error:
mov rcx, rsi
load64 rax, [rsi + 16]
call rax
write_error:
mov rax, 926
store64 [rbp], rax
mov rax, 1
write_return:
add rsp, 48
pop rsi
ret
; RCX=nom racine UTF16, RDX=maximum. Lit exactement FileSize et EOF.
; RAX=1 succes; state+56 longueur. Tampon state+48, capacite 65664.
read_file:
push rsi
push rdi
push r12
push r13
sub rsp, 40
mov r12, rdx
mov r8, rcx
mov rsi, 0
mov r13, 0
mov rax, 0
store64 [rbp + 40], rax
load64 rcx, [rbp + 32]
lea rdx, [rbp + 40]
mov r9, 1
store64 [rsp + 32], rax
load64 rax, [rcx + 8]
call rax
cmp rax, 0
jne read_done
load64 rsi, [rbp + 40]
mov rax, 512
store64 [rbp + 72], rax
mov rcx, rsi
lea rdx, [rip + info_guid]
lea r8, [rbp + 72]
lea r9, [rip + info]
load64 rax, [rsi + 64]
call rax
cmp rax, 0
jne read_close
load64 rax, [rbp + 72]
cmp rax, 80
jb read_close
cmp rax, 513
jae read_close
lea rcx, [rip + info]
load64 rax, [rcx + 72]
and rax, 16
jne read_close
load64 rax, [rcx + 8]
cmp r12, rax
jb read_close
store64 [rbp + 64], rax
mov rdi, 0
read_loop:
lea rax, [r12 + 1]
sub rax, rdi
store64 [rbp + 72], rax
store64 [rbp + 80], rax
mov rcx, rsi
lea rdx, [rbp + 72]
load64 r8, [rbp + 48]
add r8, rdi
load64 rax, [rsi + 32]
call rax
cmp rax, 0
jne read_close
load64 rax, [rbp + 72]
load64 rdx, [rbp + 80]
cmp rdx, rax
jb read_close
cmp rax, 0
je read_eof
add rdi, rax
cmp r12, rdi
jb read_close
jmp read_loop
read_eof:
load64 rax, [rbp + 64]
cmp rax, rdi
jne read_close
store64 [rbp + 56], rdi
mov r13, 1
read_close:
mov rcx, rsi
load64 rax, [rcx + 16]
call rax
cmp rax, 0
je read_done
mov r13, 0
read_done:
mov rax, r13
add rsp, 40
pop r13
pop r12
pop rdi
pop rsi
ret
; RDX=64 octets ASCII attendus; le SHA maison rend ses 64 octets ASCII.
digest_equal:
lea rcx, [rip + sha_digest]
mov r8, 64
digest_loop:
load8 rax, [rcx]
load8 r9, [rdx]
cmp rax, r9
jne digest_bad
add rcx, 1
add rdx, 1
sub r8, 1
jne digest_loop
mov rax, 1
ret
digest_bad:
mov rax, 0
ret
; SHA-256, RCX=tampon inscriptible, RDX=longueur <=65536, marge 128.
; Le padding ne modifie aucun octet des donnees; calcul modulo 2^32 explicite.
sha256:
push rbx
push rbp
push rsi
push rdi
push r12
push r13
push r14
push r15
mov rsi, rcx
mov r12, rdx
mov r15, 0xFFFFFFFF
lea rbp, [rip + sha_state]
lea rdi, [rip + sha_initial]
mov rcx, 8
mov r8, rbp
sha_init:
load64 rax, [rdi]
store64 [r8], rax
add rdi, 8
add r8, 8
sub rcx, 1
jne sha_init
lea r13, [r12 + 72]
and r13, -64
mov rax, 128
mov rdi, rsi
add rdi, r12
store8 [rdi], rax
lea rdi, [r12 + 1]
lea rcx, [r13 - 8]
mov rax, 0
sha_pad:
cmp rdi, rcx
jae sha_length
store8 [rsi + rdi * 1], rax
add rdi, 1
jmp sha_pad
sha_length:
mov rax, r12
shl rax, 3
mov rcx, 8
sha_length_loop:
mov rdx, rax
shr rdx, 56
store8 [rsi + rdi * 1], rdx
shl rax, 8
add rdi, 1
sub rcx, 1
jne sha_length_loop
add r13, rsi
sha_block:
lea rdi, [rip + sha_words]
mov rcx, 0
mov r8, rsi
sha_read_words:
load8 rax, [r8]
shl rax, 8
load8 rdx, [r8 + 1]
or rax, rdx
shl rax, 8
load8 rdx, [r8 + 2]
or rax, rdx
shl rax, 8
load8 rdx, [r8 + 3]
or rax, rdx
store64 [rdi + rcx * 8], rax
add r8, 4
add rcx, 1
cmp rcx, 16
jb sha_read_words
sha_schedule:
load64 rax, [rdi + rcx * 8 - 120]
mov r8, rax
shr r8, 7
mov r9, rax
shl r9, 25
or r8, r9
mov r9, rax
shr r9, 18
mov r10, rax
shl r10, 14
or r9, r10
xor r8, r9
shr rax, 3
xor r8, rax
load64 rax, [rdi + rcx * 8 - 16]
mov r9, rax
shr r9, 17
mov r10, rax
shl r10, 15
or r9, r10
mov r10, rax
shr r10, 19
mov r11, rax
shl r11, 13
or r10, r11
xor r9, r10
shr rax, 10
xor r9, rax
load64 rax, [rdi + rcx * 8 - 128]
add rax, r8
load64 rdx, [rdi + rcx * 8 - 56]
add rax, rdx
add rax, r9
and rax, r15
store64 [rdi + rcx * 8], rax
add rcx, 1
cmp rcx, 64
jb sha_schedule
lea r12, [rip + sha_work]
mov rcx, 0
sha_copy_state:
load64 rax, [rbp + rcx * 8]
store64 [r12 + rcx * 8], rax
add rcx, 1
cmp rcx, 8
jb sha_copy_state
mov r14, 0
sha_round:
; S1(e) = ror6 xor ror11 xor ror25.
load64 rax, [r12 + 32]
mov r8, rax
shr r8, 6
mov r9, rax
shl r9, 26
or r8, r9
mov r9, rax
shr r9, 11
mov r10, rax
shl r10, 21
or r9, r10
xor r8, r9
mov r9, rax
shr r9, 25
mov r10, rax
shl r10, 7
or r9, r10
xor r8, r9
; Ch(e,f,g) = (e and f) xor ((not e) and g).
load64 r9, [r12 + 40]
and r9, rax
xor rax, r15
load64 r10, [r12 + 48]
and rax, r10
xor r9, rax
add r8, r9
load64 rax, [r12 + 56]
add r8, rax
lea r9, [rip + sha_k]
load64 rax, [r9 + r14 * 8]
add r8, rax
load64 rax, [rdi + r14 * 8]
add r8, rax
and r8, r15
; T1 dans RBX; S0(a) = ror2 xor ror13 xor ror22.
mov rbx, r8
load64 rax, [r12]
mov r8, rax
shr r8, 2
mov r9, rax
shl r9, 30
or r8, r9
mov r9, rax
shr r9, 13
mov r10, rax
shl r10, 19
or r9, r10
xor r8, r9
mov r9, rax
shr r9, 22
mov r10, rax
shl r10, 10
or r9, r10
xor r8, r9
; Maj(a,b,c).
load64 r9, [r12 + 8]
load64 r10, [r12 + 16]
mov r11, rax
and r11, r9
and rax, r10
xor r11, rax
and r9, r10
xor r11, r9
add r8, r11
and r8, r15
add r8, rbx
and r8, r15
load64 rax, [r12 + 24]
add rbx, rax
and rbx, r15
; Deplacer h..b, puis remplacer a et e.
mov rcx, 7
sha_shift:
load64 rax, [r12 + rcx * 8 - 8]
store64 [r12 + rcx * 8], rax
sub rcx, 1
jne sha_shift
store64 [r12], r8
store64 [r12 + 32], rbx
add r14, 1
cmp r14, 64
jb sha_round
mov rcx, 0
sha_add_state:
load64 rax, [rbp + rcx * 8]
load64 rdx, [r12 + rcx * 8]
add rax, rdx
and rax, r15
store64 [rbp + rcx * 8], rax
add rcx, 1
cmp rcx, 8
jb sha_add_state
add rsi, 64
cmp rsi, r13
jb sha_block
; Rendre 64 chiffres hexadecimaux minuscules, independants de l'endian hote.
lea rdi, [rip + sha_digest]
lea rsi, [rip + hex_chars]
mov rcx, 0
sha_hex_word:
load64 rax, [rbp + rcx * 8]
mov r8, 8
sha_hex_digit:
mov rdx, rax
shr rdx, 28
and rdx, 15
load8 r9, [rsi + rdx * 1]
store8 [rdi], r9
add rdi, 1
shl rax, 4
sub r8, 1
jne sha_hex_digit
add rcx, 1
cmp rcx, 8
jb sha_hex_word
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbp
pop rbx
ret
section .rdata r
anchor:
qword addr(start)
loaded_guid:
qword 0x11D295625B1B31A1, 0x3B7269C9A0003F8E
fs_guid:
qword 0x11D26459964E5B22, 0x3B7269C9A000398E
info_guid:
qword 0x11D26D3F09576E92, 0x3B7269C9A000398E
job_name:
utf16z "NTBH.REQ"
source_name:
utf16z "NTASM1.NTASM"
core_name:
utf16z "NTBH.CORE"
host_name:
utf16z "NTBH.PROD"
host_hash:
ascii "b9fb3521d66a3d38f89832aeb8f6c664f0cbcf3ee549c2f9004df60d4693843f"
hex_chars:
ascii "0123456789abcdef"
align 8
sha_initial:
qword 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a
qword 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
