jne fc_extra
; Provenance bornee avant publication; le candidat est dans un scratch distinct.
load64 rax, [rbx]
cmp rax, 65536
jae fc_internal
add rax, rdi
cmp rax, 65536
jae fc_internal
load64 rax, [rbx + 8]
cmp rax, 1
jb fc_internal
cmp rax, 4097
jae fc_internal
mov rax, 0
store64 [r15], rax
store64 [r15 + 8], rax
store64 [r15 + 16], rax
store64 [r15 + 24], rax
store64 [r15 + 32], rax
store64 [r15 + 40], rax
load64 rdx, [rsp + 0x28]
add rdx, rsi
load64 r8, [rsp + 0x30]
mov rcx, 0
fc_copy_name:
cmp rcx, r8
jae fc_metadata
load8 rax, [rdx + rcx * 1]
store8 [r15 + rcx * 1], rax
add rcx, 1
jmp fc_copy_name
fc_metadata:
load64 rax, [rsp + 0x50]
store64 [r15 + 32], rax
load64 rax, [rbx]
load64 rdx, [rsp + 0x28]
add rax, rdx
store32 [r15 + 40], rax
load64 rax, [rbx + 8]
store16 [r15 + 44], rax
load64 rax, [rsp + 0x48]
add rax, 1
store16 [r15 + 46], rax
mov rcx, r12
mov rdx, r15
call native_symbol_insert
cmp r10, 0
je fc_return
cmp r10, 600
je fc_return
load64 rdx, [rsp + 0x28]
add r11, rdx
jmp fc_return
fc_lex_error:
mov rax, 0
jmp fc_return
fc_name_error:
mov r10, rax
load64 rdx, [rsp + 0x28]
add r11, rdx
mov rax, 0
jmp fc_return
fc_number_error:
load64 rax, [rsp + 0x38]
imul rax, rax, 16
add rax, r14
load64 rdx, [rax]
add r11, rdx
mov rax, 0
jmp fc_return
fc_sign_gap:
load64 r11, [rsp + 0x40]
add r11, 1
mov r10, 102
mov rax, 0
jmp fc_return
fc_syntax_zero:
load64 r11, [r14]
jmp fc_syntax
fc_syntax_name:
load64 r11, [rsp + 0x28]
jmp fc_syntax
fc_syntax_two:
load64 r11, [r14 + 32]
jmp fc_syntax
fc_missing:
load64 r11, [rsp + 0x20]
jmp fc_syntax
fc_extra:
load64 rax, [rsp + 0x38]
add rax, 1
imul rax, rax, 16
add rax, r14
load64 r11, [rax]
fc_syntax:
mov rax, 0
mov r10, 201
jmp fc_return
fc_internal:
mov rax, 0
mov r10, 600
mov r11, 0
fc_return:
add rsp, 96
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret

; Comparaison bornee de deux spans; les mots-cles gardent leur casse exacte.
fc_equals:
cmp rdx, r9
jne fc_not_equal
mov r10, 0
fc_equal_byte:
cmp r10, rdx
jae fc_equal
load8 rax, [rcx + r10 * 1]
load8 r11, [r8 + r10 * 1]
cmp rax, r11
jne fc_not_equal
add r10, 1
jmp fc_equal_byte
fc_equal:
mov rax, 1
ret
fc_not_equal:
mov rax, 0
ret

; Composant repris sans son driver depuis native-u64.ntasm.
native_parse_u64:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 32
mov rsi, rcx
mov rdi, rdx
mov r12, 0
mov r15, 0
cmp rdi, 0
je np_bad
load8 rax, [rsi]
cmp rax, 48
jne np_decimal
cmp rdi, 1
je np_ok
mov r15, 1
load8 rax, [rsi + 1]
cmp rax, 120
jne np_bad
mov r15, 2
cmp r15, rdi
jae np_bad
mov rbx, 16
mov r13, r8
shr r13, 4
mov r14, r8
and r14, 15
jmp np_digit
np_decimal:
mov rbx, 10
mov r13, 0
mov r14, 0
mov r9, 64
; Division binaire par 10 : evite de dependre d'une instruction absente de S0.
; Le reste intermediaire ne depasse pas 19; aucun decalage ne vaut 64.
np_divide:
mov rax, r8
shr rax, 63
shl r8, 1
shl r13, 1
shl r14, 1
or r14, rax
cmp r14, 10
jb np_divide_next
sub r14, 10
or r13, 1
np_divide_next:
sub r9, 1
cmp r9, 0
jne np_divide
np_digit:
cmp r15, rdi
jae np_ok
load8 rax, [rsi + r15 * 1]
cmp rbx, 16
je np_hex
sub rax, 48
cmp rax, 10
jae np_bad
jmp np_bound
np_hex:
mov rcx, rax
sub rax, 48
cmp rax, 10
jb np_bound
mov rax, rcx
or rax, 32
sub rax, 97
cmp rax, 6
jae np_bad
add rax, 10
np_bound:
; Tester acc <= borne/base AVANT multiplier, puis verifier le dernier chiffre.
cmp r12, r13
jb np_accumulate
cmp r12, r13
jne np_bad
cmp r14, rax
jb np_bad
np_accumulate:
cmp rbx, 16
je np_accumulate_hex
imul r12, r12, 10
jmp np_accumulate_digit
np_accumulate_hex:
shl r12, 4
np_accumulate_digit:
add r12, rax
add r15, 1
jmp np_digit
np_ok:
mov rax, r12
mov r10, 0
mov r11, 0
jmp np_return
np_bad:
mov rax, 0
mov r10, 102
mov r11, r15
np_return:
add rsp, 32
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret

; Composant repris sans son driver depuis native-lexer.ntasm.
native_lex_line:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 32
mov rsi, rcx
mov rdi, rdx
mov r12, r8
mov r13, 0
mov r14, 0
mov r15, 0
; Gate physique : lire seulement les octets declares, y compris ceux des commentaires.
nl_physical:
cmp r13, rdi
jae nl_physical_done
cmp r13, 255
jae nl_physical_limit
load8 rax, [rsi + r13 * 1]
cmp rax, 9
je nl_physical_next
cmp rax, 32
jb nl_physical_bad
cmp rax, 127
jae nl_physical_bad
nl_physical_next:
add r13, 1
jmp nl_physical
nl_physical_done:
mov r13, 0
nl_next:
cmp r13, rdi
jae nl_ok
load8 rax, [rsi + r13 * 1]
cmp rax, 32
je nl_space
cmp rax, 9
je nl_space
cmp rax, 59
je nl_ok
mov r15, r13
cmp r14, 16
jae nl_limit
cmp rax, 34
je nl_string_start
mov rbx, 0
cmp rax, 46
je nl_section
cmp rax, 48
jb nl_first_letter
cmp rax, 58
jb nl_word
nl_first_letter:
cmp rax, 95
je nl_identifier
or rax, 32
cmp rax, 97
jb nl_punctuation
cmp rax, 123
jae nl_punctuation
nl_identifier:
mov rbx, 1
jmp nl_word
nl_section:
add r13, 1
jmp nl_word
nl_punctuation:
add r13, 1
jmp nl_record
nl_space:
add r13, 1
jmp nl_next
; Un entier reste un candidat lexical; native_parse_u64 verifiera ses chiffres.
nl_word:
cmp r13, rdi
jae nl_record
load8 rax, [rsi + r13 * 1]
cmp rax, 95
je nl_word_char
cmp rax, 48
jb nl_word_letter
cmp rax, 58
jb nl_word_char
nl_word_letter:
or rax, 32
cmp rax, 97
jb nl_record
cmp rax, 123
jae nl_record
nl_word_char:
cmp rbx, 1
jne nl_word_advance
mov rax, r13
sub rax, r15
cmp rax, 31
jae nl_limit
nl_word_advance:
add r13, 1
jmp nl_word
nl_string_start:
add r13, 1
nl_string:
cmp r13, rdi
jae nl_escape_bad
load8 rax, [rsi + r13 * 1]
cmp rax, 34
je nl_string_closed
cmp rax, 32
jb nl_escape_bad
cmp rax, 92
jne nl_string_advance
add r13, 1
cmp r13, rdi
jae nl_escape_bad
load8 rax, [rsi + r13 * 1]
cmp rax, 92
je nl_string_advance
cmp rax, 34
je nl_string_advance
cmp rax, 114
je nl_string_advance
cmp rax, 110
je nl_string_advance
cmp rax, 116
je nl_string_advance
cmp rax, 48
je nl_string_advance
cmp rax, 120
jne nl_escape_bad
add r13, 1
cmp r13, rdi
jae nl_escape_bad
load8 rax, [rsi + r13 * 1]
call nl_hex_digit
cmp rax, -1
je nl_escape_bad
add r13, 1
cmp r13, rdi
jae nl_escape_bad
load8 rax, [rsi + r13 * 1]
call nl_hex_digit
cmp rax, -1
je nl_escape_bad
nl_string_advance:
add r13, 1
jmp nl_string
nl_string_closed:
add r13, 1
nl_record:
; Publier apres validation : aucun record partiel ni octet au-dela des 256.
store64 [r12], r15
mov rax, r13
sub rax, r15
store64 [r12 + 8], rax
add r12, 16
add r14, 1
jmp nl_next
nl_ok:
mov r10, 0
mov r11, 0
mov r9, 0
jmp nl_return
nl_physical_bad:
mov r15, r13
mov r10, 100
jmp nl_error
nl_physical_limit:
mov r15, r13
nl_limit:
mov r10, 101
jmp nl_error
nl_escape_bad:
mov r10, 102
nl_error:
mov r11, r13
mov r9, r15
nl_return:
mov rax, r14
add rsp, 32
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret

; RAX=octet ASCII; RAX=chiffre 0..15 ou -1, RCX volatile.
nl_hex_digit:
mov rcx, rax
sub rax, 48
cmp rax, 10
jb nl_hex_return
mov rax, rcx
or rax, 32
sub rax, 97
cmp rax, 6
jae nl_hex_bad
add rax, 10
nl_hex_return:
ret
nl_hex_bad:
mov rax, -1
ret

; Composant repris sans son driver depuis native-symbols.ntasm.
native_symbol_find:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 32
mov r12, rcx
mov rsi, rdx
mov rdi, r8
load64 r13, [r12]
cmp r13, 513
jae sf_internal
mov rcx, rsi
mov rdx, rdi
call native_name_check
cmp rax, 0
jne sf_name_error
mov r14, r12
add r14, 0x400
mov rbx, 0
sf_record:
cmp rbx, r13
jae sf_absent
mov r15, 0
sf_byte:
cmp r15, rdi
jae sf_length
load8 rax, [rsi + r15 * 1]
load8 r9, [r14 + r15 * 1]
cmp rax, r9
jne sf_next
add r15, 1
jmp sf_byte
sf_length:
load8 rax, [r14 + r15 * 1]
cmp rax, 0
jne sf_next
mov rax, r14
mov r10, 0
mov r11, 0
jmp sf_return
sf_next:
add r14, 48
add rbx, 1
jmp sf_record
sf_absent:
mov r10, 301
mov r11, 0
jmp sf_zero
sf_internal:
mov r10, 600
mov r11, 0
jmp sf_zero
sf_name_error:
mov r10, rax
sf_zero:
mov rax, 0
sf_return:
add rsp, 32
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret

; RDX=candidat de 48 octets, distinct du tableau. Nom NUL, metadata a +32.
; La metadata est preparee/validee par l'appelant; cette couche gere les noms et places.
native_symbol_insert:
push rbx
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 32
mov r12, rcx
mov rsi, rdx
mov rdi, 0
si_name_length:
cmp rdi, 32
jae si_name_long
load8 rax, [rsi + rdi * 1]
cmp rax, 0
je si_lookup
add rdi, 1
jmp si_name_length
si_lookup:
mov rcx, r12
mov rdx, rsi
mov r8, rdi
call native_symbol_find
cmp r10, 0
je si_duplicate
cmp r10, 301
jne si_return
load64 r13, [r12]
cmp r13, 512
jae si_full
imul r14, r13, 48
add r14, r12
add r14, 0x400
; Aucun write precede ces validations. Le nom est canonicalise a zero jusqu'a 32.
mov rax, 0
store64 [r14], rax
store64 [r14 + 8], rax
store64 [r14 + 16], rax
store64 [r14 + 24], rax
mov r15, 0
si_copy_name:
cmp r15, rdi
jae si_metadata
load8 rax, [rsi + r15 * 1]
store8 [r14 + r15 * 1], rax
add r15, 1
jmp si_copy_name
si_metadata:
load64 rax, [rsi + 32]
store64 [r14 + 32], rax
load64 rax, [rsi + 40]
store64 [r14 + 40], rax
add r13, 1
store64 [r12], r13
mov rax, r14
mov r10, 0
mov r11, 0
jmp si_return
si_duplicate:
mov rax, 0
mov r10, 300
mov r11, 0
jmp si_return
si_full:
mov rax, 0
mov r10, 500
mov r11, 0
jmp si_return
si_name_long:
mov rax, 0
mov r10, 101
mov r11, 31
si_return:
add rsp, 32
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbx
ret

; RCX=nom, RDX=longueur. RAX=0/101/201, R11=index invalide.
native_name_check:
mov r11, 0
cmp rdx, 0
je nc_bad
cmp rdx, 32
jae nc_long
mov r8, 0
nc_byte:
load8 rax, [rcx + r8 * 1]
cmp rax, 95
je nc_next
; Tester les chiffres AVANT le pliage de casse : 0x10 OR 0x20 ne doit pas devenir '0'.
cmp rax, 48
jb nc_letter
cmp rax, 58
jb nc_digit
nc_letter:
or rax, 32
cmp rax, 97
jb nc_bad_at
cmp rax, 123
jb nc_next
jmp nc_bad_at
nc_digit:
cmp r8, 0
je nc_bad_at
nc_next:
add r8, 1
cmp r8, rdx
jb nc_byte
mov rax, 0
ret
nc_bad_at:
mov r11, r8
nc_bad:
mov rax, 201
ret
nc_long:
mov rax, 101
mov r11, 31
ret

