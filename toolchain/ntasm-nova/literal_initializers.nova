module literal_initializers;

import ntasm_ast;

fn child(tree:ntasm_ast.Tree,parent:u64,ordinal:u64)->u64 {
    if parent==0||parent>tree.node_count { return 0; }
    let node:ntasm_ast.Node=ntasm_ast.node_at(tree,parent);
    let mut id:u64=node.first_child;
    let mut index:u64=0;
    while id!=0&&index<ordinal {
        if id>tree.node_count { return 0; }
        let current:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        id=current.next_sibling;index=index+1;
    }
    if id>tree.node_count { return 0; }
    return id;
}

fn word(source:buf<u8>,node:ntasm_ast.Node,text:buf<u8>)->bool {
    if node.start>node.end||node.end>len(source)||(node.end-node.start)!=len(text) { return false; }
    let mut i:u64=0;
    while i<len(text) {
        if source[node.start+i]!=text[i] { return false; }
        i=i+1;
    }
    return true;
}

// 0 mismatch, 1 valid, 2 out of range. Only scalar literal initializers are
// decided here; callers deliberately defer every nonliteral expression.
fn literal_status(source:buf<u8>,expected:ntasm_ast.Node,literal:ntasm_ast.Node)->u64 {
    let true_:buf<u8>="true";let false_:buf<u8>="false";
    let is_bool:bool=word(source,literal,true_)||word(source,literal,false_);
    let bool_:buf<u8>="bool";
    if word(source,expected,bool_) {
        if is_bool { return 1; }
        return 0;
    }
    if is_bool { return 0; }
    let value:u64=literal.aux;
    let u8_:buf<u8>="u8";if word(source,expected,u8_) { if value<=255 { return 1; } return 2; }
    let i8_:buf<u8>="i8";if word(source,expected,i8_) { if value<=127 { return 1; } return 2; }
    let u16_:buf<u8>="u16";if word(source,expected,u16_) { if value<=65535 { return 1; } return 2; }
    let i16_:buf<u8>="i16";if word(source,expected,i16_) { if value<=32767 { return 1; } return 2; }
    let u32_:buf<u8>="u32";if word(source,expected,u32_) { if value<=4294967295 { return 1; } return 2; }
    let i32_:buf<u8>="i32";if word(source,expected,i32_) { if value<=2147483647 { return 1; } return 2; }
    let u64_:buf<u8>="u64";if word(source,expected,u64_) { return 1; }
    let i64_:buf<u8>="i64";if word(source,expected,i64_) { if value<=9223372036854775807 { return 1; } return 2; }
    return 0;
}

// Validate scalar literal initializers of data and let declarations. Boolean
// words are expression nodes; integer literals are kind 94. Nonliteral
// expressions are counted as deferred. 355 means type/category mismatch and
// 356 means integer range overflow. Success writes data, locals, checked,
// deferred. Errors write line, column, declaration kind, 0.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64 {
    if tree.ok==false||tree.node_count==0||len(out)<4 { return 800; }
    let mut data_count:u64=0;let mut local_count:u64=0;
    let mut checked:u64=0;let mut deferred:u64=0;
    let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut bad_kind:u64=0;
    let mut id:u64=1;
    while id<=tree.node_count&&code==0 {
        let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if declaration.kind==24||declaration.kind==27 {
            if declaration.kind==24 { data_count=data_count+1; } else { local_count=local_count+1; }
            let type_id:u64=child(tree,id,1);let initializer_id:u64=child(tree,id,2);
            if type_id==0||initializer_id==0 { code=800; }
            else {
                let expected:ntasm_ast.Node=ntasm_ast.node_at(tree,type_id);
                let initializer:ntasm_ast.Node=ntasm_ast.node_at(tree,initializer_id);
                let true_:buf<u8>="true";let false_:buf<u8>="false";
                let is_bool:bool=word(source,initializer,true_)||word(source,initializer,false_);
                if initializer.kind==94||is_bool {
                    let status:u64=literal_status(source,expected,initializer);
                    if status==0 { code=355; }
                    else if status==2 { code=356; }
                    else { checked=checked+1; }
                    if code!=0 { line=initializer.line;column=initializer.column;bad_kind=declaration.kind; }
                } else { deferred=deferred+1; }
            }
        }
        id=id+1;
    }
    if code==0 { out[0]=data_count;out[1]=local_count;out[2]=checked;out[3]=deferred; }
    else if code==355||code==356 { out[0]=line;out[1]=column;out[2]=bad_kind;out[3]=0; }
    return code;
}
