// Parse varied fixed-width decimal records; reject invalid digits/overflow.
fn main(n:u64, seed:u64, data:buf<u8>) -> u64 {
    if len(data)<5120 { return 18446744073709551615; }
    let mut sum:u64=seed;
    let mut row:u64=0;
    while (row<n) {
        let offset:u64=(row&255)*20;
        let mut value:u64=0;
        let mut j:u64=0;
        while j<20 {
            let ch:u8=data[offset+j];
            if ch<48 || ch>57 { return 18446744073709551615; }
            let digit:u64=u64(ch)-48;
            if value>1844674407370955161 ||
                (value==1844674407370955161 && digit>5) {
                return 18446744073709551614;
            }
            value=value*10+digit;
            j=j+1;
        }
        sum=sum^(value+row);
        row=row+1;
    }
    return sum;
}
